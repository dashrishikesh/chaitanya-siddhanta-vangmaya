---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "चैतन्य सिद्धान्त वाङ्मय — चैतन्य सिद्धान्त ग्रन्थभण्डारः" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="sa">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@400;500;600;700&family=Open+Sans:wght@300;400;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title} | चैतन्य सिद्धान्त वाङ्मय</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
