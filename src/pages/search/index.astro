---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="अन्वेषणम्">
	<div class="page-content">
		<h2>अन्वेषणम्</h2>
		<form class="search-form" role="search">
			<input type="text" name="q" placeholder="ग्रन्थनाम, लेखकनाम वा शब्दं टङ्कयतु..." />
			<button type="submit">अन्विष्यताम्</button>
		</form>
		<p style="text-align:center;">
			<span class="placeholder-note">
				[ placeholder — this search form is not wired to an index yet. Connect it to your
				content search of choice (client-side index, Algolia, Pagefind, etc.) ]
			</span>
		</p>
	</div>
</Layout>
