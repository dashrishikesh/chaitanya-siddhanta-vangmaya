---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

interface Book {
	name: string;
	author?: string;
	href: string;
}

interface Group {
	heading: string;
	cat: number;
	books: Book[];
}

// category id -> [display heading, grid color class]; order here is display order
const CATEGORIES: Record<string, [string, number]> = {
	sandarbha: ["षट्सन्दर्भाः", 1],
	stotra: ["स्तोत्र-ग्रन्थाः", 2],
	brahmasutra: ["ब्रह्मसूत्राणि", 3],
};
const CATEGORY_ORDER = Object.keys(CATEGORIES);

const base = import.meta.env.BASE_URL;
const granthaEntries = await getCollection("granthas");

const workByCategory = new Map<string, typeof granthaEntries>();
const seenWorkSlugs = new Set<string>();
for (const entry of granthaEntries) {
	if (seenWorkSlugs.has(entry.data.workSlug)) continue;
	seenWorkSlugs.add(entry.data.workSlug);
	const list = workByCategory.get(entry.data.category) ?? [];
	list.push(entry);
	workByCategory.set(entry.data.category, list);
}

const groups: Group[] = [...workByCategory.entries()]
	.sort(([a], [b]) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b))
	.map(([category, works]) => {
		const [heading, cat] = CATEGORIES[category] ?? [category, 1];
		const sortedWorks = [...works].sort(
			(a, b) => (a.data.sequence ?? 0) - (b.data.sequence ?? 0),
		);
		return {
			heading,
			cat,
			books: sortedWorks.map((entry) => ({
				name: entry.data.work.devanagari,
				author: entry.data.author,
				href: `${base}granthas/${entry.data.workSlug}/`,
			})),
		};
	});

const catClass = (cat: number) => `cat-${cat}`;
---

<Layout
	title="ग्रन्थाः"
	description="Browse the Ṣaṭ-Sandarbha (six Sandarbhas) of Śrī Jīva Gosvāmī — the foundational philosophical treatises of Gauḍīya Vaiṣṇava theology, presented with their historical commentaries."
>
	<div class="container works">
		<h2 class="works-heading">चैतन्यसिद्धान्तवाङ्मयम्</h2>

		<div id="grid-view" class="grid-view">
			{
				groups.map((group) => (
					<div class="group">
						<h3 class={`group-heading ${catClass(group.cat)}`}>{group.heading}</h3>
						<div class={`book-strips ${catClass(group.cat)}`}>
							{group.books.map((book) => {
								const external = book.href.startsWith("http");
								return (
									<a
										href={book.href}
										target={external ? "_blank" : undefined}
										rel={external ? "noopener noreferrer" : undefined}
									>
										{book.author && <span class="author">{book.author}</span>}
										<span class="name">{book.name}</span>
									</a>
								);
							})}
						</div>
						<hr />
					</div>
				))
			}
		</div>
	</div>
</Layout>
