---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
	const entries = await getCollection("granthas");
	const byWork = new Map<string, typeof entries>();

	for (const entry of entries) {
		const slug = entry.data.workSlug;
		byWork.set(slug, [...(byWork.get(slug) ?? []), entry]);
	}

	return [...byWork.entries()].map(([workSlug, workEntries]) => ({
		params: { workSlug },
		props: {
			sections: workEntries.sort((a, b) => a.data.sequence - b.data.sequence),
		},
	}));
}

const { sections } = Astro.props;
const { workSlug } = Astro.params;
const { work, corpusName, author } = sections[0].data;
const base = import.meta.env.BASE_URL;
const description = `${work.iast} (${work.devanagari})${work.english ? `, "${work.english}"` : ""} by ${author} — ${sections.length} section${sections.length === 1 ? "" : "s"} with historical commentaries.`;
---

<Layout title={work.devanagari} description={description}>
	<div class="container grantha-page">
		<p class="grantha-breadcrumb"><a href={`${base}granthas/`}>ग्रन्थाः</a> / {work.devanagari}</p>

		<header class="grantha-header">
			<h1 class="grantha-title">{work.devanagari}</h1>
			<p class="grantha-title-iast">{work.iast}</p>
			{
				corpusName && (
					<p class="grantha-corpus">
						{corpusName.devanagari} <span class="grantha-work-iast">({corpusName.iast})</span>
					</p>
				)
			}
			<p class="grantha-author">कर्ता: {author}</p>
		</header>

		<ol class="work-sections">
			{
				sections.map((section) => (
					<li>
						<a href={`${base}granthas/${workSlug}/${section.id}/`}>
							<span class="name">{section.data.title.devanagari}</span>
							<span class="author">{section.data.title.iast}</span>
						</a>
					</li>
				))
			}
		</ol>
	</div>
</Layout>
