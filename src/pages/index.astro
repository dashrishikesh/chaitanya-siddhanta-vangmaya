---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="मुख्यपृष्ठम्">
	<section class="hero">
		<h1 class="title">चैतन्य सिद्धान्त वाङ्मय</h1>
		<span class="tagline">एकः ग्रन्थभण्डारः, अनेकानि रत्नानि</span>
	</section>

	<section class="intro">
		<p>
			अत्र स्थाने चैतन्यसिद्धान्तपरम्परायाः ग्रन्थाः, भाष्याणि, व्याख्यानानि च संगृह्य
			संरक्ष्यन्ते। अध्येतॄणां शोधकानां च कृते एषः वाङ्मयभण्डारः सुलभतया उपलभ्यते।
		</p>
	</section>

	<section id="sandesha" class="message-section">
		<h2>सन्देशः</h2>
		<p>
			इदं स्थानं निर्माणाधीनम् अस्ति। अत्र भविष्यति गुरुपरम्परायाः अनुग्रहसन्देशः, स्वागतवचनं वा।
		</p>
		<span class="placeholder-note">[ placeholder — replace with your actual message content ]</span>
	</section>

	<section class="intro">
		<p>
			<a href={`${base}ग्रन्थाः/`}>ग्रन्थाः</a> इति विभागं दृष्ट्वा सम्पूर्णं ग्रन्थसूचीं
			पश्यन्तु।
		</p>
	</section>
</Layout>
