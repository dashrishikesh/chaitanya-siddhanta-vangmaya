---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="मुख्यपृष्ठम्">
	<section class="hero">
		<div class="hero-inner">
			<img class="hero-banner-image" src={`${base}images/images.jpeg`} alt="चैतन्य सिद्धान्त परम्परा" />
			<div class="hero-content">
				<img class="hero-logo" src={`${base}images/logo.png`} alt="चैतन्य सिद्धान्त परिषद्" />
				<h1 class="title">चैतन्य सिद्धान्त वाङ्मय</h1>
				<span class="tagline">एकः ग्रन्थभण्डारः, अनेकानि रत्नानि</span>
			</div>
		</div>
	</section>

	<section class="intro">
		<p>
			अत्र स्थाने चैतन्यसिद्धान्तपरम्परायाः ग्रन्थाः, भाष्याणि, व्याख्यानानि च संगृह्य
			संरक्ष्यन्ते। अध्येतॄणां शोधकानां च कृते एषः वाङ्मयभण्डारः सुलभतया उपलभ्यते।
		</p>
	</section>

	<section class="message-section">
		<h2>अचिन्त्यभेदाभेदः</h2>
		<blockquote class="sanskrit-quote">
			<p>स्वमते तु अचिन्त्य भेदाभेदावेव अचिन्त्य शक्तिमयत्वादिति ।</p>
			<p class="quote-translation">
				“To us, acintya-bheda-abheda alone is acceptable, because the substantive is endowed with
				acintya śaktis.”
			</p>
			<cite>— सर्वसंवादिनी, पृ. १४९ (Sarvasamvadini, pg. 149)</cite>
		</blockquote>
		<p><a href={`${base}acintya-bhedabheda/`}>अधिकं पठतु &rarr;</a></p>
	</section>

	<section class="intro">
		<p>
			<a href={`${base}granthas/`}>ग्रन्थाः</a> इति विभागं दृष्ट्वा सम्पूर्णं ग्रन्थसूचीं
			पश्यन्तु।
		</p>
	</section>
</Layout>
