\begin{document}
\engtitle{.. Garland Of Devotional Prayers Stavamala By Shri Rupadeva Gosvami ..}##
\itxtitle{.. shrIrUpagosvAmivirachitA stavamAlA ..}##\endtitles ##
shrIshrIkR^iShNachaitanyachandrAya namaH |
shrImadIshvararUpeNa rasAmR^itakR^itA kR^itA |
stavamAlAnujIvena jIvena samagR^ihyata || 1||
pUrvaM chaitanyadevasya kR^iShNadevasya tatparam |
shrIrAdhAyAstataH kR^iShNarAdhayorlikhyate stavaH || 2||
virudAvalI tato nAnAchChandobhiH kelisaMhatiH |
tatashchitrakavitvAni tato gItAvalI tataH || 3||
lalitAyamunAvR^iShNipurIshrIharibhUbhR^itAm |
vR^indATavIkR^iShNanAmnoH krameNa stavapaddhatiH || 4||
\chapter{##Chaitanyashtakam 1 ## .. chaitanyAShTakam 1 ..}
atha shrIchaitanyadevasya prathamAShTakaM
sadopAsyaH shrImAn dhR^itamanujakAyaiH praNayitAM
     vahadbhirgIrvANairgirishaparameShThiprabhR^itibhiH |
svabhaktebhyaH shuddhAM nijabhajanamudrAmupadishan
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 1||
sureshAnAM durgaM gatiratishayenopaniShadAM
     munInAM sarvasvaM praNatapaTalInAM madhurimA |
viniryAsaH premNo nikhilapashupAlAmbujadR^ishAM
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 2||
svarUpaM bibhrANo jagadatulamadvaitadayitaH
     prapannashrIvAso janitaparamAnandagarimA |
harirdInoddhArI gajapatikR^ipotsekataralaH
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 3||
rasoddAmA kAmArbudamadhuradhAmojjvalatanu\-
     ryatInAmuttaMsastaraNikaravidyotivasanaH
     hiraNyAnAM lakShmIbharamabhibhavann A~NgikaruchA
sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 4||
hare kR^iShNetyuchchaiH sphuritarasano nAmagaNanA
     kR^itagranthishreNIsubhagakaTisUtrojjvalakaraH |
vishAlAkSho dIrghArgalayugalakhelA~nchitabhujaH
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 5||
payorAshestIre sphuradupavanAlIkalanayA
     muhurvR^indAraNyasmaraNajanitapremavivashaH |
kvachit kR^iShNAvR^ittiprachalarasanobhaktirasikaH
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 6||
rathArUDhasyArAdadhipadavi nIlAchalapate\-
     radabhrapremormisphuritanaTanollAsavivashaH |
saharShaM gAyadbhiH parivR^itatanurvaiShNavajanaiH
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 7||
bhuvaM si~nchannashrushrutibhirabhitaH sAndrapulakaiH
     parItA~Ngo nIpastabakanavaki~njalkajayibhiH |
ghanasvedastomastimitatanurutkIrtanasukhI
     sa chaitanyaH kiM me punarapi dR^ishoryAsyati padam || 8||
adhIte gaurA~NgasmaraNapadavIma~NgalataraM
     kR^itI yo vishrambhasphuradamaladhIraShTakamidam |
parAnande sadyastadamalapadAmbhojayugale
     parisphArA tasya sphuratu nitarAM premalaharI || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM chaitanyAShTakaM prathamaM sampUrNam |
\chapter{##Chaitanyashtakam 2 ## .. chaitanyAShTakam 2 ..}
atha shrIchaitanyadevasya dvitIyAShTakaM
kalau yaM vidvAMsaH sphuTamabhiyajante dyutibharAd
     akR^iShNA~NgaM kR^iShNaM makhavidhibhirutkIrtanamayaiH |
upAsyaM cha prAhuryamakhilachaturthAshramajuShAM
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 1||
charitraM tanvAnaH priyamaghavadAhlAdanapadaM
     jayodghoShaiH samyagvirachitashachIshokaharaNaH |
uda~nchanmArtaNDadyutiharadukUlA~nchitakaTiH
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 2||
apAraM kasyApi praNayijanavR^indasya kutukI
     rasastomaM hR^itvA madhuramupabhoktuM kamapi yaH |
ruchiM svAmAvavre dyutimiha tadIyAM prakaTayan
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 3||
anArAdhyaH prItyA chiramasurabhAvapraNayinAM
     prapannAnAM daivIM prakR^itimadhidaivaM trijagati |
ajasraM yaH shrImAn jayati sahajAnandamadhuraH
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 4||
gatiryaH pauNDrANAM prakaTitanavadvIpamahimA
     bhavenAla~Nkurvan bhuvanamahitaM shrotriyakulam |
punAtya~NgIkArAd bhuvi paramahaMsAshramapadaM
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 5||
mukhenAgre pItvA madhuramiha nAmAmR^itarasaM
     dR^ishordvArA yastaM vamati ghanabAShpAmbumiShataH |
bhuvi premNastattvaM prakaTayitumullAsitatanuH
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 6||
tanUmAviShkurvannavapuraTabhAsaM kaTilasat
     kara~NkAla~NkArastaruNagajarAjA~nchitagatiH |
priyebhyo yaH shikShAM dishati nijanirmAlyaruchibhiH
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 7||
smitAlokaH shokaM harati jagatAM yasya parito
     girAM tu prArambhaH kushalIpaTalIM pallavayati |
padAlambaH kaM vA praNayati nahi premanivahaM
     sa devashchaitanyAkR^itiratitarAM naH kR^ipayatu || 8||
shachIsUnoH kIritstavakanavasaurabhyaniviDaM
     pumAn yaH prItAtmA paThati kila padyAShTakamidam |
sa lakShmIvAn etaM nijapadasaroje praNayitAM
     dadAnaH kalyANImanupadamabAdhaM sukhayatu || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM chaitanyAShTakaM dvitIyaM sampUrNam |
\chapter{##Chaitanyashtakam 3 ## .. chaitanyAShTakam 3 ..}
atha shrIchaitanyadevasya tR^itIyAShTakaM
upAsitapadAmbujastvamanuraktarudrAdibhiH
     prapadya puruShottamaM padamadabhramudbhrAjitaH |
samastanatamaNDalIsphuradabhIShTakalpadrumaH
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 1||
na varNayitumIshate gurutarAvatArAyitA
     bhavantamurubuddhayo na khalu sArvabhaumAdayaH |
paro bhavatu tatra kaH paTurato namaste paraM
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 2||
na yat kathamapi shrutAvupaniShadbhirapyAhitaM
     svayaM cha vivR^itaM na yad gurutarAvatArAntare |
kShipannasi rasAmbudhe tadiha bhAktaratnaM kShitau
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 3||
nijapraNayavisphurannaTanara~NgavismApita
     trinetranatamaNDalaprakaTitAnurAgAmR^ita |
aha~NkR^itikala~NkitoddhatajanAdidurbodha he
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 4||
bhavanti bhuvi ye narAH kalitaduShkulotpattaya\-
     stvamuddharasi tAn api prachurachArukAruNyataH |
iti pramuditAntaraH sharaNamAshritastvAmahaM
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 5||
mukhAmbujapariskhalanmR^idulavA~NmadhUlIrasa
     prasa~NgajanitAkhilapraNatabhR^i~Ngara~Ngotkara |
samastajanama~NgalaprabhavanAmaratnAmbudhe
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 6||
mR^igA~NkamadhurAnana sphuradanidrapadmekShaNa
     smitastavakasundarAdhara visha~NkaTorastaTe |
bhujoddhatabhuja~Ngamaprabha manojakoTidyute
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 7||
ahaM kanakaketakIkusumagaura duShTaH kShitau
     na doShalavadarshitA vividhadoShapUrNe.api te |
ataH pravaNayA dhiyA kR^ipaNavatsala tvAM bhaje
     shachIsuta mayi prabho kuru mukunda mande kR^ipAm || 8||
idaM dharaNimaNDalotsava bhavatpadA~NkeShu ye
     niviShTamanaso narAH paripaThanti padyAShTakam |
shachIhR^idayanandana prakaTakIrtichandra prabho
     nijapraNayanirbharaM vitara deva tebhyaH shubham || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM chaitanyAShTakaM tR^itIyaM sampUrNam |
\chapter{##Anandastotram ## .. Anandastotram ..}
shrIkR^iShNaH paramAnando govindo nandanandanaH |
tamAlashyAmalaruchiH shikhaNDakR^itashekharaH || 1||
pItakausheyavasano madhurasmitashobhitaH |
kandarpakoTilAvaNyo vR^indAraNyamahotsavaH || 2||
vaijayantIsphuradvakShAH kakShAttalaguDottamaH |
ku~njApitaratirgu~njApu~njama~njulakaNThakaH || 3||
karNikArADhyakarNashrIdhR^itisvarNAbhavarNakaH |
muralIvAdanapaTurvallavIkulavallabhaH || 4||
gAndharvAptimahAparvA rAdhArAdhanapeshalaH |
iti shrIkR^iShNachandrasya nAma viMshatisa.nj~nitam || 5||
AnandAkhyaM mahAstotraM yaH paThechChR^iNuyAchcha yaH |
sa paraM saukhyamAsAdya kR^iShNapremasamanvitaH || 6||
sarvalokapriyo bhUtvA sadguNAvalibhUShitaH |
vrajarAjakumArasya sannikarShamavApnuyAt || 7||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrImahAnandAkhyastotraM samAptam |
\chapter{##Lilamritastotram ## .. lIlAmR^itastotram ..}
shrIkR^iShNasya shrIlIlAmR^itanAmakadashanAmastotraM
rAdhikAhR^idayonmAdivaMshIkvANamadhuchChaTaH |
rAdhAparimalodgAragarimAkShiptamAnasaH || 1||
kamrarAdhAmanomInavaDishIkR^itavibhramaH |
premagarbAndhagAndharvAkilaki~nchitara~njitaH || 2||
lalitAvashyadhIrAdhAmAnAbhAsavashIkR^itaH |
rAdhAvakroktipIyUShamAdhuryabharalampaTaH || 3||
mukhenduchandrikodgIrNarAdhikArAgasAgaraH |
vR^iShabhAnusutAkaNThahArihAraharinmaNiH || 4||
phullarAdhAkamalinImukhAmbujamadhuvrataH |
rAdhikAkuchakastUrIpatrasphuraduraHsthalaH || 5||
iti gokulabhUpAlIsUnulIlAmanoharam |
yaH paThennAmadashakaM so.asya vallabhatAM vrajet || 6||

iti shrIrUpagosvAmivirachitastavamAlAyAM lIlAmR^itastotraM sampUrNam |
\chapter{##Premendusagarastotram ## .. premendusAgarastotram ..}
shrIpremendusAgarasa.nj~nakashrIkR^iShNAShTottarashatanAmamAlikA
kalahAntaritAvR^ittA kAchid vallavasundarI |
virahottApakhinnA~NgI sakhIM sotkaNThamabravIt || 1||
hanta gauri sa kiM gantA panthAnaM mama netrayoH |
shrIkR^iShNaH karuNAsindhuH kR^iShNo gokulavallabhaH || 2||
govindaH paramAnando nandamandirama~Ngalam |
yashodAkhanimANikyaM gopendrAmbhodhichandramAH || 3||
navAmbhodharasaMrambhaviDambiruchiDambaraH |
kShiptahATakashauTIryapaTTapItAmbarAvR^itaH || 4||
kandarparUpasandarpahAripAdanakhadyutiH |
dhvajAmbhoruhadambholi yavA~NkushalasatpadaH || 5||
padapa~njarasi~njAnama~njuma~njIrakha~njanaH |
masArasampuTAkAradhAri jAnuyugojjvalaH || 6||
shauNDastamberamoddaNDashuNDAramyorusauShThavaH |
maNiki~NkiNisa~NkIrNavisha~NkaTakaTisthalaH || 7||
madhyamAdhuryavidhvastadivyasiMhamadoddhatiH |
gArutmatagirigrAvagariShThorastaTAntaraH || 8||
kambukaNThasthalAlambimaNisamrAD ala~NkR^itiH |
AkhaNDalamaNistambhaspardhidordaNDachaNDimA || 9||
khaNDitAkhaNDakoTIndusaundaryamukhamaNDalaH |
lAvaNyalaharIsindhuH sindUratulitAdharaH || 10||
phullAravindasaundarya kandalItundilekShaNaH |
gaNDAntatANDavakrIDAhiNDanmakarakuNDalaH || 11||
navInayauvanArambhajR^imbhitojjvalavigrahaH |
apA~Ngatu~NgitAna~NgakoTikodaNDavikramaH || 12||
sudhAniryAsamAdhuryadhurINodArabhAShitaH |
sAndravR^indATavIku~njakandarAgandhasindhuraH || 13||
dhanyagovardhanottu~NgashR^i~Ngotsa~NganavAmbudhaH |
kalindanandinIkelikalyANakalahaMsakaH || 14||
nandIshvaradhR^itAnando bhANDIrataTatANDavI |
sha~NkhachUDaharaH krIdAgeNDUkR^itagirIshvaraH || 15||
vArIndrArbudhagambhIraH pArIndrArbudavikramI |
rohiNInandanAnandI shrIdAmoddAmasauhR^idaH || 16||
subalapremadayitaH suhR^idAM hR^idaya~NgamaH |
nandavrajajanAnandasandIpanamahAvratI || 17||
shR^i~NginIsa~Nghasa~NgrAhiveNusa~NgItamaNDalaH |
uttu~Ngapu~NgavArabdhasa~NgarAsa~NgakautukI || 18||
visphuradvanyashR^i~NgAraH shR^i~NgArAbhIShTadaivatam |
uda~nchatpi~nChavi~nCholIlA~nChitojjvalavigrahaH || 19||
sa~ncharachcha~ncharIkAlipa~nchavarNasraga~nchitaH |
sura~Ngara~NgaNasvarNayUthigrathitamekhalaH || 20||
dhAtuchitravichitrA~NgalAvaNyalaharIbharaH |
gu~njApu~njakR^itAkalpaH kelitalpitapallavaH || 21||
vapurAmodamAdhvIkavardhitapramadAmadaH |
vR^indAvanAravindAkShIvR^indakandarpadIpanaH || 22||
mInA~Nkasa~NkulAbhIrIkuchaku~Nkumapa~NkilaH |
mukhendumAdhurIdhArAruddhasAdhvIvilochanaH || 23||
kumArIpaTaluNThAkaH prauDhanarmoktikarmaThaH |
amandamugdhavaidagdhIdigdharAdhAsudhAmbudhi || 24||
chAruchandrAvalIbuddhikaumudIsharadAgamaH |
dhIralAlityalakShmIvAn kandarpAnandabandhuraH || 25||
chandrAvalIchakorendro rAdhikAmAdhavImadhuH |
lalitAkelilalito vishAkhoDunishAkaraH || 26||
padmAvadanapadmAliH shaivyAsevyapadAmbujaH |
bhadrAhR^idayanidrAluH shyAmalAkAmalAlasaH || 27||
lokottarachamatkAralIlAma~njariniShkuTaH |
premasampadayaskAntakAntakR^itakR^iShNAyasavrataH || 28||
muralIchauragaurA~NgIkuchaka~nchukalu~nchanaH |
rAdhAbhisArasarvasvaH sphAranAgaratAguruH || 29||
rAdhAnarmoktishushrUShAvIrunnIruddhavigrahaH |
kadambama~njarIhArirAdhikArodhanoddhuraH || 30||
kuDu~NgakroDasa~NgUDharAdhAsa~Ngamara~NgavAn |
krIDoDDAmaradhIrAdhAtADa~NkotpalatADitaH || 31||
ana~Ngasa~NgarodgArikShuNNaku~Nkumaka~NkaTaH |
tribha~Ngila~NgimAkAro veNusa~NgamitAdharaH || 32||
veNuvistR^itagAndharvasArasandarbhasauShThavaH |
gopIyUthasahasrendraH sAndrarAsarasonmadaH || 33||
smarapa~nchasharIkoTikShobhakAridR^iga~nchalaH |
chaNDAMshunandinItIramaNDalArabdhatANDavaH || 34||
vR^iShabhAnusutAbhR^i~NgIkAmadhukkamalAkaraH |
gUDhAkUtaparIhAsarAdhikAjanitasmitaH || 35||
nArIveshanigUDhAtmA vyUDhachittachamatkR^itiH |
karpUrAlambitAmbUlakarambitamukhAmbujaH || 36||
mAnichandrAvalIdUtIkLLiptasandhAnakaushalaH |
ChadmaghaTTataTIruddharAdhAbhrUkuTighaTTitaH || 37||
dakSharAdhAsakhIhAsavyAjopAlambhalajjitaH |
mUrtimadvallavIpremA kShemAnandarasAkR^itiH || 38||
abhisArollasadbhadrAki~NkiNIninadonmukhaH |
vAsasajjIbhavatpadmAprekShyamANAgrapaddhatiH || 39||
utkaNThitArtalalitAvitarkapadavIM gataH |
vipralabdhavishAkhoruvilApabharavardhanaH || 40||
kalahAntaritAshyAmAmR^igyamANamukhekShaNaH |
khaNDitochchaNDadhIshaivyAroShoktirasikAntaraH || 41||
vishleShaviklavachchandrAvalIsandeshananditaH |
svAdhInabhartR^ikotphullarAdhAmaNDanapaNDitaH || 42||
chumbaveNuglahadyutijayirAdhAdhR^itA~nchalaH |
rAdhApremarasAvartavibhramabhramitAntaraH || 43||
ityeShonmattadhIH premnA shaMsantI kaMsamardanam |
sphurantaM purataH prekShya prauDhAnandotsavaM yayau || 44||
premendusAgarAkhye.asminnAmnAmaShTottare shate |
vigAhayantu vibudhAH prItyA rasanamandaram || 45||

iti shrIrUpagosvAmivirachitastavamAlAyAM premendusAgarastotraM sampUrNam |
\chapter{##Keshavashtakam ## .. keshavAShTakam ..}
navapriyakama~njarIrachitakarNapUrashriyaM
     vinidrataramAlatIkalitashekhareNojjvalam |
darochChvasitayUthikAgrathitavalguvaikakShakR^it
     vraje vijayinaM bhaje vipinadeshataH keshavam || 1||
pisha~Ngi maNikastani praNatashR^i~Ngi pi~NgekShaNe
     mR^ida~Ngamukhi dhUmale shavali haMsi vaMshIpriye |
iti svasurabhikulaM taralamAhvayantaM mudA
     vraje vijayinaM bhaje vipinadeshataH keshavam || 2||
ghanapraNayamedurAn madhuranarmagoShThIkalA
     vilAsanilayAn miladvividhaveshavidyotinaH |
sakhIn akhilasArayA pathiShu hAsayantaM girA
     vraje vijayinaM bhaje vipinadeshataH keshavam || 3||
shramAmbukaNikAvalIdaravilIDhagaNDAntaraM
     samUDhAgiridhAtubhirlikhitachArupatrA~Nkuram |
uda~nchadalimaNDalIdyutiviDambivakrAlakaM
     vraje vijayinaM bhaje vipinadeshataH keshavam || 4||
nibaddhanavatarNakAvalivilokanotkaNThayA
     naTatkhurapuTA~nchalairalaghubhirbhuvaM bhindatIm |
kalena dhavalAghaTAM laghu nivartayantaM puro
     vraje vijayinaM bhaje vipinadeshataH keshavam || 5||
padmA~NkatatibhirvarAM virachayantamadhvashriyaM
     chalattaralanaichikInichayadhUlidhUmrasrajam |
marullaharicha~nchalIkR^itadukUlachUDA~nchalaM
     vraje vijayinaM bhaje vipinadeshataH keshavam || 6||
vilAsamuralIkaladhvanibhirullasanmAnasAH
     kShaNAdakhilavallavIH pulakayantamantargR^ihe |
muhurvidadhataM hR^idi pramuditAM cha goShTheshvarIM
     vraje vijayinaM bhaje vipinadeshataH keshavam || 7||
upetya pathi sundarItatibhirAbhirabhyarchitaM
     smitA~NkurakarambitairnaTadapA~Ngabha~NgIshataiH |
stanastavakasa~ncharannayanacha~ncharIkA~nchalaM
     vraje vijayinaM bhaje vipinadeshataH keshavam || 8||
idaM nikhilavallavIkulamahotsavollAsanaM
     krameNa kila yaH pumAn paThati suShThu padyAShTakam |
tamujjvaladhiyaM sadA nijapadAravindadvaye
     ratiM dadadacha~nchalAM sukhayatAd vishAkhAsakhaH || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIkeshavAShTakaM sampUrNam |
\chapter{##Shri Kunjaviharyashtakam 1 ## .. shrIku~njavihAryaShTakam 1 ..}
prathamaM shrIku~njavihAryaShTakaM
namaH ku~njavihAriNe |
indranIlamaNima~njulavarNaH
     phullanIpakusumA~nchitakarNaH |
kR^iShNalAbhirakR^ishorasi hArI
     sundaro jayati ku~njavihArI || 1||
rAdhikA vadanachandrachakoraH
     sarvavallavavadhUdhR^itichoraH |
charcharIchaturatA~nchitachArI
     chAruto jayati ku~njavihArI || 2||
sarvataH prathitakaulikaparva
     dhvaMsanena hR^itavAsavagarvaH |
goShTharakShaNakR^ite giridhArI
     lIlayA jayati ku~njavihArI || 3||
rAgamaNDalavibhUShitavaMshI
     vibhrameNa madanotsavashaMsI |
stUyamAnacharitaH shukashArI
     shreNibhirjayati ku~njavihArI || 4||
shAtakumbharuchihAridukUlaH
     kokachandrakavirAjitachUlaH |
navyayauvanalasadvrajanArI
     ra~njano jayati ku~njavihArI || 5||
sthAsakIkR^itasugandhipaTIraH
     svarNakA~nchiparishobhikaTIraH |
rAdhikonnatapayodharavArI
     ku~njaro jayati ku~njavihArI || 6||
gauradhAtutilakojjvalabhAlaH
     kelicha~nchalitachampakamAlaH |
adrikandaragR^iheShvabhisArI
     subhruvAM jayati ku~njavihArI || 7||
vibramochchaladR^iga~nchalanR^itya
     kShiptagopalalanAkhilakR^ityaH |
premamattavR^iShabhAnukumArI
     nAgaro jayati ku~njavihArI || 8||
aShTakaM madhuraku~njavihArI
     krIDayA paThati yaH kila hAri |
sa prayAti vilasatparabhAgaM
     tasya pAdakamalArchanarAgam || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIku~njavihAriNaH
prathamAShTakaM samAptam |
\chapter{##Shri Kunjaviharyashtakam 2 ## .. shrIku~njavihAryaShTakam 2 ..}
dvitIyaM shrIku~njavihAryaShTakaM
namaH ku~njavihAriNe |
avirataratibandhusmeratAbandhurashrIH
     kavalita iva rAdhApA~Ngabha~NgItara~NgaiH |
muditavadanachandrashchandrakApIDadhArI
     mudiramadhurakAntirbhAti ku~nje vihArI || 1||
tatashuShiraghanAnAM rAgamAnaddhabhAjAM
     janayati taruNInAM maNDale maNDitAnAm |
taTabhuvi naTarAjakrIDayA bhAnuputryA
     vidadhadatulachArIrbhAti ku~nje vihArI || 2||
shikhini kalitaShaDje kokile pa~nchamADhye
     svayamapi navavaMshyoddAmayan grAmamukhyam |
dhR^itamR^igamadagandhaH suShThu gAndhArasa.nj~naM
     tribhuvanadhR^itihArI bhAti ku~nje vihArI || 3||
anupamakarashAkhopAttarAdhA~NgulIko
     laghu laghu kusumAnAM paryaTan bATikAyAm |
sarabhasamanugItashchitrakaNThIbhiruchchai\-
     rvrajanavayuvatIbhirbhAti ku~nje vihArI || 4||
ahiripukR^italAsye kIchakArabdhavAdye
     vrajagiritaTara~Nge bhR^i~Ngasa~NgItabhAji |
virachitaparicharyAshchitratauryatrikeNa
     stimitakaraNavR^ittirbhAti ku~nje vihArI || 5||
dishi dishi shukashArImaNDalairgUDhalIlAH
     prakaTamanupaThadbhirnirmitAshcharyapUraH |
tadatirahasi vR^ittaM preyasIkarNamUle
     smitamukhamabhijalpan bhAti ku~nje vihArI || 6||
tava chikurakadambaM stambhate prekShya kekI
     nayanakamalalakShmIrvandate kR^iShNasAraH |
aliralamalakAntaM nauti pashyeti rAdhAM
     sumadhuramanushaMsan bhAti ku~nje vihArI || 7||
madanataralabAlAchakravAlena viShva\-
     gvividhavarakalAnAM shikShayA sevyamAnaH |
skhalitachikuraveshe skandhadeshe priyAyAH
     prathitapR^ithulabAhurbhAti ku~nje vihArI || 8||
idamanupamalIlAhAri ku~njavihArI
     smaraNapadamadhIte tuShTadhIraShTakaM yaH |
nijagaNavR^itayA shrIrAdhayA rAdhitastaM
     nayati nijapadAbjaM ku~njasadmAdhirAjaH || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIku~njavihAryaShTakaM
dvitIyaM sampUrNam |
\chapter{##Shri Mukundashtakam ## .. shrImukundAShTakam ..}
shrImukundAya namaH |
balabhidupalakAntidrohiNi shrImada~Nge
     ghusR^iNarasavilAsaiH suShThu gAndharvikAyAH |
svamadananR^ipashobhAM vardhayan deharAjye
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 1||
uditavidhuparArdhajyotirulla~Nghivaktro
     navataruNimarajyadbAlyasheShAtiramyaH |
pariShadi lalitAlIM dolayan kuNDalAbhyAM
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 2||
kanakanivahashobhAnandi pItaM nitambe
     tadupari navaraktaM vastramitthaM dadhAnaH |
priyamiva kila varNaM rAgayuktaM priyAyAH
     praNayatu mama netrAbhIShTapUrtiM mukundaH || 3||
surabhikusumavR^indhairvAsitAmbhaHsamR^iddhe
     priyasarasi nidAghe sAyamAlIparItAm |
madanajanakasekaiH khelayann eva rAdhAM
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 4||
paramalamiha labdhvA hanta gAndharvikAyAH
     pulakitatanuruchchairunmadastatkShaNena |
nikhilavipinadeshAn vAsitAn eva jighran
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 5||
praNihitabhujadaNDaH skandhadeshe varA~NgyAH
     smitavikasitagaNDe kIrtidAkanyakAyAH |
manasijajanisaukhyaM chumbanenaiva tanvan
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 6||
pramadadanujagoShThyAH ko.api saMvartavahni\-
     rvrajabhuvi kila pitrormUrtimAn snehapu~njaH |
prathamarasamahendraH shyAmalo rAdhikAyAH
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 7||
svakadanakathayA~NgIkR^itya mR^idvIM vishAkhAM
     kR^itachaTu lalitAM tu prArthan prauDhashIlAm |
praNayavidhurarAdhAmAnavidhvaMsanAya
     praNayatu mama netrAbhIShTasiddhiM mukundaH || 8||
paripaThati mukundasyAShTakaM kAkubhiryaH
     sakalaviShayasa~NgAt sanniyamyendriyANi |
vrajanavayuvarAjo darshayan svaM sarAdhe
     svajanagaNanamadhye taM priyAyAstanoti || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrImukundAShTakaM samAptam |
\chapter{##Shri Vrajanavayuvarajashtakam ## .. shrIvrajanavayuvarAjAShTakam ..}
shrIvrajanavayuvarAjAya namaH |
mudiramadamudAraM mardayanna~NgakAntyA
     vasanaruchinirastAmbhojaki~njalkashobhaH |
taruNimataraNIkShAviklavadbAlyachandro
     vrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 1||
pituranishamagaNyaprANanirmanthanIyaH
     kalitatanurivAddhA mAtR^ivAtsalyapu~njaH |
anuguNagurugoShThIdR^iShTipIyUShavarti\-
     rvrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 2||
akhilajagati jAgranmugdhavaidagdhyacharyA
     prathamagururudagrasthAmavishrAmasaudhaH |
anupamaguNarAjIra~njitAsheShabandhu\-
     rvrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 3||
api madanaparAardhairduShkaraM vikriyormiM
     yuvatiShu nidadhAno bhrUdhanurdhUnanena |
priyasahacharavargaprANamInAmburAshi\-
     rvrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 4||
nayanashR^iNimvinodakShobhitAna~NganAgo
     nmathitagahanarAdhAchittakAsAragarbhaH |
praNayarasamarandAsvAdalIlAShaDa~Nghri\-
     rvrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 5||
anupadamudayantyA rAdhikAsa~Ngasid.hdhyA
     sthagitapR^ithurathA~NgadvandvarAgAnubandhaH |
madhurimamadhudhArAdhoraNInAmudanvAn
     vrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 6||
alaghukuTilarAdhAdR^iShTivArIniruddha
     trijagadaparatantroddAmachetogajendraH |
sukhamukharavishAkhAnarmaNA smeravaktro
     vrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 7||
tvayi rahasi milantyAM sambhramanyAsabhugnApy\-
     uShasi sakhi tavAlImekhalA pashya bhAti |
iti vivR^itarahasyairhrepayann eva rAdhAM
     vrajanavayuvarAjaH kA~NkShitaM me kR^ipIShTa || 8||
vrajanavayuvarAjasyAShTakaM tuShTabuddhiH
     kalitavaravilAsaM yaH prayatnAdadhite |
parijanagaNanAyAM nAma tasyAnurajyan
     vilikhati kil vR^indAraNyarAj~nIrasaj~naH || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIvrajanavayuvarAjAShTakaM
samAptam |
\chapter{##Pranamapranayakhyastavah ## .. praNAmapraNayAkhyastavaH ..}
shrIkR^iShNAya namaH |
kandarpakoTiramyAya sphuradindIvaratviShe |
jaganmohanalIlAya namo gopendrasUnave || 1||
kR^iShNalAkR^itahArAya kR^iShNalAvaNyashAline |
kR^iShNAkUlakarIndrAya kR^iShNAya karavai namaH || 2||
sarvAnandakadambAya kandambakusumasraje |
namaH premAvalambAya pralambArikanIyase || 3||
kuNDalasphuradaMsAya vaMshAyattamukhashriye |
rAdhAmAnasahaMsAya vrajottaMsAya te namaH || 4||
namaH shikhaNDachUDAya daNDamaNDitapANaye |
kuNDalIkR^itapuShpAya puNDarIkekShaNAya te || 5||
rAdhikApremamAdhvIkamAdhurImuditAntaram |
kandarpavR^indasaundaryaM govindamabhivAdaye || 6||
shR^i~NgArarasashR^i~NgAraM karNikArAttakarNikam |
vande shriyA navAbhrANAM bibhrANaM vibhramaM harim || 7||
sAdhvImaNivrAtapashyatoharaveNave |
kahlArakR^itachUDAya sha~NkhachUDabhide namaH || 8||
rAdhikAdharabandhUkamakarandamadhuvratam |
daityasindhurapArIndraM vande gopendranandanam || 9||
barhendrAyudharamyAya jagajjIvanadAyine |
rAdhAvidyudvR^itA~NgAya kR^iShNAmbhodAya te namaH || 10||
premAndhavallavIvR^indalochanendrIvarendave |
kAshmIratilakADhyAya namaH pItAmbarAya te || 11||
gIrvANeshamadoddAma dAvanirvANanIradam |
kandUkIkR^itashailendraM vande gokulabAndhavam || 12||
dainyArNave nimagno.asmi mantugrAvabharArditaH |
duShTe kAruNyapArINa mayi kR^iShNa kR^ipAM kuru || 13||
AdhAro.apyaparAdhAnAmavivekahato.apyaham |
tvatkAruNyapratIkSho.asmi prasIda mayi mAdhava || 14||

iti shrIrUpagosvAmivirachitastavamAlAyAM praNAmapraNayAkhyaH stavaH sampUrNaH |
\chapter{##Shri Harikusumastavah ## .. shrIharikusumastavaH ..}
gatiga~njitamattataradviradaM
     radaninditasundarakundamadam |
madanArbudarUpamadaghnaruchiM
     ruchirasmitama~njari ma~njumukham || 1||
mukharIkR^itaveNuhR^itapramadaM
     madavalgitalochanatAmarasam |
rasapUravikAsakakeliparaM
     paramArthaparAyaNalokagatim || 2||
gatimaNDitayAmunatIrabhuvaM
     bhuvaneshvaravanditachArupadam |
padakojjvalakomalakaNTharuchaM
     ruchakAttavisheShakavalgutaram || 3||
taralaprachalAkaparItashikhaM
     shikharIndradhR^iti pratipannabhujam |
bhujagendraphaNA~NgaNara~NgadharaM
     dharakandarakhelanalubdhahR^idam || 4||
hR^idayAlusuhR^idgaNadattamahaM
     mahanIyakathAkuladhUtakalim |
kalitAkhiladurjayabAhubalaM
     balavallavashAvakasannihitam || 5||
hitasAdhusamIhitakalpataruM
     taruNIgaNanUtanapuShpasharam |
sharaNAgatarakShaNadakShatamaM
     tamasAdhukulopalachaNDakaram || 6||
karapadmamilatkusumastavakaM
     bakadAnavamattakarIndraharim |
hariNIgaNahArakaveNukalaM
     kalakaNTharavojjvalakaNTharaNam || 7||
raNakhaNDitadurjanapuNyajanaM
     janama~NgalakIrtilatAprabhavam |
bhavasAgarakumbhajanAmaguNaM
     guNasa~NgavivarjitabhaktagaNam || 8||
gaNanAtigadivyaguNollasitaM
     smitarashmisahodaravaktravaram |
varadR^iptavR^iShAsuradAraghanaM
     ghanavibhramaveshavihAramayam || 9||
mayaputratamaHkShayapUrNavidhuM
vidhurIkR^itadAnavarAjakulam |
kulanandanamatra namAmi harim || 10||
urasi parisphuradindiramindindiramandirashrajollasitam |
harima~NganAtima~Ngalama~NgalasachchandanaM vande || 11||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIharikusumastavaH sampUrNaH |
\chapter{##Gathachandahstavah ## .. gAthAChandaHstavaH ..}
paritoShitagopavadhUpaTalaM
paTala~NghitakA~nchanasArachayam |
rachayantamudAravilAsakalAM
sakalA~nchitapAdamagAdhabalaM
dhavalaM navakIrtikulairamitam || 1||

iti shrIrUpagosvAmivirachitastavamAlAyAM gAthAChandaHstavaH sampUrNaH |
\chapter{##Tribhangipanchakam ## .. tribha~NgIpa~nchakam ..}
namaH shrIkR^iShNAya |
yamalArjunabha~njanamAshritara~njanamahiga~njanaghanalAsyabharaM
     pashupAlapurandaramabhisR^itakandaramatisundaramaravindakaram |
varagopavadhUjanavirachitapUjanamUrukUjananavaveNudharaM
     smaranarmavichakShaNamakhilavilakShaNatanulakShaNamatidakShataram || 1||
praNatAshanipa~njaraM nambarapi~njaramariku~njaraharimindumukhaM
     gomaNDalarakShiNamanukR^itapakShiNamatidakShiNamaimtAtmasukham |
gurugairikamaNDitamanunayapaNDitamavakhaNDitapuruhUtamakhaM
     vrajakamalavirochanamalikasurochanagorochanamatitAmranakham || 2||
unmadaratinAyakashANitashAyakavinidhAyakachalachillilataM
     uddhatasa~NkochanamambujalochanamaghamochanamamarAlinatam |
nikhilAdhikagauravamujjvalasaurabhamatigaurabhapashupIShu rataM
     komalapadapallavamabhramu vallabharuchidurlabhasavilAsagatam || 3||
bhujamUrdhni visha~NkaTamadhigatasha~NkaTanataka~NkaTamaTavIShu chalaM
     navanItpakarambitavanarolambitamavalambitakalakaNThakalam |
durjanatR^iNapAvakamanucharashAvakanikarAvakamaruNoShThadalaM
     nijavikramacharchitabhujagurugarvitagandharvitadanujArdibalam || 4||
shrutiratnavibhUShaNaruchijitapUShaNamalidUShaNanayanAntagatiM
     yamunAtaTatalpitapuShpamanalpitamadajalpitadayitAptaratim |
vandemahi vanditamandamamanditakulamandhitakhalakaMsamatiM
     tvAmiha dAmodara haladharasodara hara no daramanubaddharatim || 5||
virachaya mayi daNDaM dInabandho dayAM vA
     gatiriha na bhavattaH kAchidanyA mamAsti |
nipatatu shatakoTirnirbharaM vA navAmbha\-
     stadapi kila payodaH stUyate chAtakena || 1||
prAchInAnAM bhajanamatulaM duShkaraM shR^iNvato me
     nairAshyena jvalati hR^idayaM bhaktileshAlasasya |
vishvadrIchImaghahara tavAkarNya kAruNyavIchIM
     AshAbindUkShitamidamupaityantare hanta shaityam || 2||

iti shrIrUpagosvAmivirachitastavamAlAyAM tribha~NgIpa~nchakaM sampUrNam |
\chapter{##Shri Mukundamuktavali ## .. shrImukundamuktAvalI ..}
shrIvrajanAgarAya namaH |
navajaladhavarNaM champakodbhAsikarNaM
     vikasitanalinAsyaM visphuranmandahAsyam |
kanakaruchidukUlaM chArubarhAvachUlaM
     kamapi nikhilasAraM naumi gopakumAram || 1||
mukhajitasharadinduH kellAvaNyasindhuH
     karavinhitakandurvallavIprANabandhuH |
vapurupasR^itareNuH kakShanikShiptaveNu\-
     rvachanavashagadhenuH pAtu mAM nandasUnuH || 2||
|| mAlinI ||
dhvastaduShTasha~NkhachUDa vallavIkulopagUDha
     bhaktamAnasAdhirUDha nIlakaNThapi~nChachUDa |
kaNThalambima~njugu~nja kelilabdharamyaku~nja
     karNavartiphullakunda pAhi deva mAM mukunda || 3||
yaj~nabha~NgarauShTashatrununnaghorameghachakra
     vR^iShTipurakhinnagopavIkShaNopajAtakopa |
kShiprasavyahastapadmadhAritochchashailasadma
     guptagoShTha rakSha rakSha mAM tathAdya pa~NkajAkSha || 4||
|| chitrA ||
muktAhAraM dadhaduDuchakrAkAraM
     sAraM gopImanasi manojAropI |
kopI kaMse khalanikurambottaMse
     vaMshe ra~NgI dishatu naH shAr~NgI || 5||
lIloddAmA jaladharamAlAshyAmA
     kShAmAH kAmAdabhirachayantI rAmAH |
sA mAmavyAdakhilamunInAM stavyA
     gavyApUrtiH prabhuraghashatrormUrtiH || 6||
|| jaladharamAlA ||
parvavartulasharvarIpatigarvarItiharAnanaM
     nandanandanamindirAkR^itavandanaM dhR^itachandanam |
sundarIratimandirIkR^itakandaraM dhR^itamandaraM
     kuNDaladyutimaNDalaplutakandharaM bhaja sundaram || 7||
gokulA~NganamaNDanaM kR^itapUtanAbhavamochanaM
     kundasundaradantamambujavR^indavanditalochanam |
saurabhAkaraphullapuShkaravisphuratkarapallavaM
     daivatavrajadurlabhaM bhaja vallavIkulavallabham || 8||
|| ra~NginI ||
tuNDakAntidaNDitorupANDurAMshumaNDalaM
     gaNDapAlitANDabAlishAliratnakuNDalam |
phullapuNDarIkaShaNDakLLiptamAlyamaNDanaM
     chaNDabAhudaNDamatra naumi kaMsakhaNDanam || 9||
uttara~Ngada~NgarAgasa~NgamAtipi~Ngala\-
     stu~NgashR^i~Ngasa~NgipANira~NganAtima~NgalaH |
digvilAsimallihAsi kIrtivallipallava\-
     stvAM sa pAtu phullachAruchilliradya vallavaH || 10||
|| tUNakam ||
indranivAraM vrajapativAraM
     nirdhutavAraM hR^itaghanavAram |
rakShitagotraM prINitagotraM
     tvAM dhR^itagotraM naumi sagotram || 11||
kaMsamahIpatihR^idgatashUlaM
     santatasevitayAmunakUlam |
vande sundarachandrakachUlaM
     tvAmahamakhilacharAcharamUlam || 12||
malayajaruchirastanujitamudiraH
     pAlitavidhustoShitavasudhaH |
mAmatirasikaH kelibhiradhikaH
     sitasubhagaradaH kR^ipayatu varadaH || 13||
urarIkR^itamurarIrutabha~NgaM
     navajaladharakiraNollasada~Ngam |
yuvatihR^idayadhR^itamadanatara~NgaM
     praNamata yAmunataTakR^itara~Ngam || 14||
|| pajjhaTikA ||
navAmbhodanIlaM jagattoShashIlaM
     mukhAsa~NgivaMshaM shikhaNDAvataMsam |
karAlambivetraM varAmbhojanetraM
     dhR^itasphItagu~njaM bhaje labdhaku~njam || 15||
hR^itakShauNibhAraM kR^itakleshahAraM
     jagadgItasAraM mahAratnahAram |
mR^idushyAmakeshaM lasadvAmyaveshaM
     kR^ipAbhirnadeshaM bhaje vallavesham || 16||
|| bhuja~NgaprayAtam ||
ullasadvallavIvAsasAM taskara\-
     stejasA nirjitaprasphuradbhAskaraH |
pInadoHstambhayorullasachchandanaH
     pAtu vaH sarvato devakInandanaH || 17||
saMsR^itestArakaM taM gavAM chArakaM
     veNunA maNDitaM krIDane paNDitam |
dhAtR^ibhirveShiNaM danavadveShiNaM
     chintaya svAminaM vallavIkAminam || 18||
|| sragviNI ||
upAttakavalaM parAgashabalaM
     sadekasharaNaM sarojacharaNam |
ariShTadalanaM vikR^iShTalalanaM
     namAmi samahaM sadaiva tamaham || 19||
vihArasadanaM manoj~naradanaM
     praNItamadanaM shasha~Nkavadanam |
uraHsthakamalaM yashobhiramalaM
     karAttakamalaM bhajasva tamalam || 20||
|| jaloddhatagatiH ||
duShTadhvaMsaH karNikArAvataMsaH
     kheladvaMshI pa~nchamadhvAnashaMsI |
gopIchetaHkelibha~NginiketaH
     pAtu svairI hanta vaH kaMsavairI || 21||
vR^indATavyAM kelimAnandanavyAM
     kurvannArIchittakandarpadhArI |
narmodgArI mAM dukUlApahArI
     nIpArUDhaH pAtu barhAvachUDaH || 22||
|| shAlinI ||
ruchiranakhe rachaya sakhe
     valitaratiM bhajanatatim |
tvamaviratistvaritagati\-
     rnatasharaNe haricharaNe || 23||
ruchirapaTaH pulinanaTaH
     pashupagatirguNavasatiH |
sa mama shuchirjaladaruchi\-
     rmanasi parisphuratu hariH || 24||
|| tvaritagatiH ||
kelivihitayamulArjunabha~njana
     sulalitacharitanikhilajanara~njana |
lochananartanajitachalakha~njana
     mAM paripAlaya kAliyaga~njana || 25||
bhuvanavisR^itvaramahimADambara
     virachitanikhilakhalotkarasaMvara |
vitara yashodAtanaya varaM varaM
     abhilaShitaM me dhR^itapItAmbara || 26||
chikurakarambita chArushikhaNDaM
     bhAlavinirjitavarashashikhaNDam |
radaruchirnirdhUtamudritakundaM
     kuruta budhA hR^idi sapadi mukundam || 27||
yaH parirakShitasurabhIlakSha\-
     stadapi cha surabhImardanadakShaH |
muralIvAdanakhuralIshAlI
     sa dishatu kushalaM tava vanamAlI || 28||
|| pajjhaTikA ||
ramitanikhilaDimbe veNupItoShThabimbe
     hatakhalanikurambe vallavIdattachumbe |
bhavatu mahitanande tatra vaH kelikande
     jagadaviralatunde bhaktirurvI mukunde || 29||
pashupayuvatIgoShThIchumbitashrImadoShThI
     smarataralitadR^iShTinirmitAnandavR^iShTiH |
navajaladharadhAmA pAtu vaH kR^iShNanAmA
     bhuvanamadhuraveshA mAlinI muktireShA || 30||
|| mAlinI ||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrImukundamuktAvaliH samAptA |
\chapter{##Anandachandrikastotram ## .. AnandachandrikAstotram ..}
shrIshrIrAdhAkR^iShNAbhyAM namaH |
dhyAnaH
a~NgashyAmalimachChaTAbhirabhito mandIkR^itendIvaraM
     jADyaM jAguDarochiShAM vidadhataM paTTAmbarasya shriyA |
vR^indAraNyavilAsinaM hR^idi lasaddAmAbhirAmodaraM
     rAdhAskandhaniveshitojjvalabhujaM dhyAyema dAmodaram ||
atha shrIrAdhikAyA AnandachandrikAstotraM
shrIrAdhikAyai namaH |
rAdhAdAmodarapreShThA rAdhikA vArShabhAnavI |
samastavallavIvR^indadhammillottaMsamallikA || 1||
kR^iShNapriyAvalImukhyA gAndharvA lalitAsakhI |
vishAkhAsakhyasukhinI harihR^idbhR^i~Ngama~njarI || 2||
imAM vR^indAvaneshvaryA dashanAmamanoramAm |
AnandachandrikAM nAma yo rahasyAM stutiM paThet || 3||
sa klesharahito bhUtvA bhUrisaubhAgyabhUShitaH |
tvaritaM karuNApAtraM rAdhAmAdhavayorbhavet || 4||

iti shrIrUpagosvAmivirachitastavamAlAyAM AnandachandrikAstotraM samAptam |
\chapter{##Shri Premasudhasatram ## .. shrIpremasudhAsatram ..}
shrIvR^indAvaneshvaryA aShTottarashatanAmastotraM
namo vR^indAvaneshvaryai
mAnasaM mAnasaM tyAgAdutkaNThArtaM nirundhatIm |
rAdhAM saMvidya vidyADhyA tu~NgavidyedamabravIt || 1||
vimu~ncha bandhure mAnaM nirbandhaM shR^iNu me vachaH |
purA kandarpasundaryai yAnyutkaNThitachetase || 2||
bhagavatopadiShTAni tava sakhyopalabdhaye |
i~NgitAbhij~nayA tAni sindUreNAdya vR^indayA || 3||
vilikhya sakhi dattAni sa jIvitasuhR^ittamaH |
virahArtastavemAni japannAmAni shAmyati || 4||
rAdhA kR^iShNavanAdhIshA mukundamadhumAdhavI |
govindapreyasIvR^indamukhyA vR^indAvaneshvarI || 5||
brahmANDamaNDalottaMsakIritH kArtikadevatA |
dAmodarapriyasakhI rAdhikA vArShabhAnavI || 6||
bhAnubhaktibharAbhij~nA vR^iShabhAnukumArikA |
mukharAprANadauhitrI kIrtidAkIrtidAyinI || 7||
kR^iShNapremAbdhikarI vatsalAchyutamAtR^ikA |
sakhImaNDalajIvAturlalitAjIvitAdhikA || 8||
vishAkhAprANasarvasvaM kAruNyAmR^itamedurA |
paurNamAsIpR^ithupremapAtrI subalananditA || 9||
kR^iShNAdhirAjamahiShI vR^indAraNyavihAriNI |
vishAkhAsakhyavikhyAtA lalitApremalAlitA || 10||
sadA kishorikA goShThayuvarAjavilAsinI |
govindapremashikShArthanaTIkR^itanijAMshakA || 11||
prabodhinInishAnR^ityamAhAtmyabharadarshinI |
chandrakAnticharI sarvagandharvakulapAvanI || 12||
svajanmabhUShitottu~NgavR^iShabhAnukulasthitiH |
lAsyavidyAvratasnAtA rAsakrIDAdikAraNam || 13||
rAsotsavayapuragaNyA kR^iShNanItarahaHsthalA |
govindabandhakavarI kR^iShNottaMsitakuntalA || 14||
vyaktagoShThAravindAkShi vR^indotkarShAtiharShiNI |
annatarpitadurvAsA gAndharvA shrutivishrutA || 15||
gAndharvikA svagAndharvavismApitabalAchyutA |
sha~NkhachUDAridayitA gopIchUDAgramAlikA || 16||
chArugorochanAgaurI gArutmatanibhAmbarA |
vichitrapaTTachamarIchAruveNIshikhAruchiH || 17||
padmendujaitravaktrashrIniruddhamuramardanA |
chakorikAchamatkArIharihArivilochanA || 18||
kAliyadamanotkampibha~NgurabhrUbhuja~NgamA |
nAsikAshikharAlambilavalIsthalamauktikA || 19||
bandhurAdharabandhUkavikR^iShTamadhusUdanA |
dantanirdhUtashikharA shikharIndradharapriyA || 20||
kapolamaNDalAndolimaNikuNDalamaNDitA |
pItAMshukashukAkarShinistalastanadADimA || 21||
maNiki~NkiNyala~NkArajha~NkArishroNimaNDalA |
sthalAravindavi~nCholInirma~nChitapadadyutiH || 22||
ariShTavadhanarmArthanirmApitasarovarA |
gandhonmAditagovindo mAdhavadvandvatA~NkitA || 23||
kAlindIkUlaku~njashrIrbhANDIrataTamaNDanA |
dhR^itanandIshvarasthemA govardhanadarIpriyA || 24||
vaMshIbaDishikAbiddharasottarShamanojhaShA |
vaMshikAdhvanivishraMsinIvIbandhagrahAturA || 25||
mukundanetrashapharI vihArAmR^itadIrghikA |
nijakuNDakuDu~NgAntastu~NgAna~NgarasonmadA || 26||
kR^iShNabhrUchaNDakodaNDoDDInadhairyaviha~NgamA |
anurAgasudhAsindhuhindolAndolitAchyutA || 27||
vrajendranandanAsyendutu~NgitAna~NgasAgarA |
ana~Ngasa~NgarottR^iShNakR^iShNalu~nchitaka~nchukA || 28||
lIlApadmahatoddAmanarmalampaTakeshavA |
harivakShoharigrAvaharitAlIyarekhikA || 29||
mAdhavotsa~Ngaparya~NkA kR^iShNabAhUpadhAnikA |
ratikelivisheShohasakhIsmitavilajjitA || 30||
AlIpurorahaHkelijalpotkaharivandinI |
vaijayantI kalAbhij~nA vanasrakshilpakalpinI || 31||
dhAtuchitrAtivaichitrIvisR^iShTiparameShThinI |
vidagdhIprathamAchAryA chAruchAturyachitritA || 32||
asAdhAraNasaubhAgyabhAgyAmR^itatara~NginI |
maugdhyapragalbhatAramyA dhIrAdhIrA~NkabhUShitA || 33||
shyAmalaprachChadapaTI mUkanUpuradhAriNI |
niku~njadhAmasaMskAramAdhavAdhvekShaNakriyA || 34||
prAdurbhUtaghanotkaNThA vipralambhaviShaNNadhIH |
prAtarutprAsitopendrA chandrAvalikaTAkShiNI || 35||
anAkarNitakaMsArikAkUvAdA manasvinI |
chATukAraharityAgajAtAnushayakAtarA || 36||
dhR^itakR^iShNekShaNotsukyA lalitAbhItimAninI |
viprayogavyathAhAriharisandeshananditA || 37||
madAlpajalpitAdhInapuNDarIkAkShamaNDitA |
bhrUlIlAmohitopendrahastAgrahR^itavaMshikA || 38||
atulAchyutamAdhuryasvAdanAdvaitabhAgyabhUH |
niyuddhashrAntinidrANa harihArApahAriNI || 39||
dyUtanirjitavaMshArthikaMsAriparihAsinI |
nijaprANArbudapreShThakR^iShNapAdanakhA~nchalA || 40||
iti rAdhA sakhIvAchamAchamya pulakA~nchitA |
ChadmanA padmanAbhasya latAsadmAntikaM gatA || 41||
yaH sevate jano rAdhAnAmnAmaShTottaraM shatam |
nAmnA premasudhAsatraM lihyAt premasudhAmasau || 42||

iti shrIrUpagosvAmivirachitastavamAlAyAM
premendusudhAsatranAmakashrIrAdhikAShTottarashatanAma samAptam |
\chapter{##Shri Radhashtakam ## .. shrIrAdhAShTakam ..}
shrIshrIvR^indAvaneshvaryai namaH |
dishi dishi rachayantI sa~ncharannetralakShmI
     vilasitakhuralIbhiH kha~njarITasya khelAm |
hR^idayamadhupamallIM vallavAdhIshasUno\-
     rakhilaguNagabhIrAM rAdhikAmarchayAmi || 1||
pituriha vR^iShabhAnoranvavAyaprashastiM
     jagati kila samaste suShThu vistArayantIm |
vrajapatikumAraM khelayantIM sakhIbhiH
     surabhiNi nijakuNDe rAdhikAmarchayAmi || 2||
sharadupachitarAkAkaumudInAthakIrti
     prakaradamanadIkShAdakShiNasmeravaktrAm |
naTadaghabhidapA~Ngottu~NgitAna~Ngara~NgAM
     kalitaruchitara~NgAM rAdhikAmarchayAmi || 3||
vividhakusumavR^indotphulladhammilladhATI
     vighaTitamadaghUrNatkekipichChaprashastim |
madhuripumukhabimbodgIrNatAmbUlarAga
     sphuradamalakapolAM rAdhikAmarchayAmi || 4||
amalinalalitAntaHsnehasiktAntarA~NgAM
     akhilavidhavishAkhAsakhyavikhyAtashIlAm |
sphuradaghabhidanarghapremamANikyapeTIM
     dhR^itamadhuravinodAM rAdhikAmarchayAmi || 5||
atulamahasi vR^indAraNyarAjye.abhiShiktAM
     nikhilasamayabhartuH kArtikasyAdhidevIm |
aparimitamukundapreyasIvR^indamukhyAM
     jagadaghaharakIrtiM rAdhikAmarchayAmi || 6||
haripadanakhakoTIpR^iShThaparyantasImA
     taTamapi kalayantIM prANakoTerabhIShTAm |
pramuditamadirAkShIvR^indavaidagdhyadIkShA
     gurumatigurukIrtiM rAdhikAmarchayAmi || 7||
amalakanakapaTTodghR^iShTakAshmIragaurIM
     madhurimalaharIbhiH samparItAM kishorIm |
haribhujaparirabdhAM labdharomA~nchapAliM
     sphuradaruNadukUlAM rAdhikAmarchayAmi || 8||
tadamalamadhurimNAM kAmamAdhArarUpaM
     paripaThati variShThaM suShThu rAdhAShTakaM yaH |
ahimakiraNaputrIkUlakalyANachandraH
     sphuTamakhilamabhIShTaM tasya tuShTastanoti || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIrAdhAShTakaM sampUrNam |
\chapter{##Prarthanapaddhatih ## .. prArthanApaddhatiH ..}
shrIrAdhikAyai namaH |
shuddhagA~NgeyagaurA~NgIM kura~NgIla~NgimekShaNAm |
jitakoTIndubimbAsyAmambudAmbarasaMvR^itAm || 1||
navInavallavIvR^indadhammillotphullamallikAm |
divyaratnAdyala~NkArasevyamAnatanushriyam || 2||
vidagdhamaNDalaguruM gaNagauravamaNDitAm |
atipreShThavayasyAbhiraShTAbhirabhiveShTitAm || 3||
cha~nchalApA~Ngabha~Ngena vyAkulIkR^itakeshavAm |
goShThendrasutajIvAturamyabimbAdharAmR^itAm || 4||
tvAmasau yAchate natvA viluThan yamunAtaTe |
kAkubhirvyAkulasvAnto jano vR^indAvaneshvari || 5||
kR^itAgaske.apyayogye.api jane.asmin kumatAvapi |
dAsyadAnapradAnasya lavamapyupapAdaya || 6||
yuktastvayA jano naiva duHkhito.ayamupekShitum |
kR^ipAddyotadravachchittanavanItAsi yat sadA || 7||

iti shrIrUpagosvAmivirachitastavamAlAyAM prArthanApaddhatiH samAptA |
\chapter{##Chatupushpanjalih ## .. chATupuShpA~njaliH ..}
shrIrAdhikAyai namaH |
navagorochanAgaurI pravarendrIvarAmbarAm |
maNistavakavidyotiveNIvyAlA~NgaNAphaNAm || 1||
upamAnaghaTamAnaprahArimukhamaNDalAm |
navendunindibhAlodyatkasturItilakashriyam || 2||
bhrUjitAna~NgakodaNDAM lolanIlAlakAvalim |
kajjalojjvalatArAjachchakorIchArulochanAm || 3||
tilapuShpAbhanAsAgravirAjadvaramaulikAm |
adharodbhUtabandhUkAM kundAlIbandhuradvijAm || 4||
saratnasvarNarAjIvakarNikAkR^itakarNikAm |
kastUrIbinduchibukAM ratnagraiveyakojjvalAm || 5||
divyA~NgadapariShva~NgalasadbhujamR^iNAlikAm |
balAriratnavalayakalAlambikalAvikAm || 6||
ratnA~NgurIyakollAsivarA~NgulikarAmbujAm |
manoharamahAhAravihArikuchakuTmalAm || 7||
romAlibhujagImUrdharatnAbhataralA~nchitAm |
valitrayIlatAbaddhakShINabha~NguramadhyamAm || 8||
maNisArasanAdhAravisphArashroNirodhasam |
hemarambhAmadArambhastambhanoruyugAkR^itim || 9||
jAnudyutijitakShullapItaratnasamudrakAm |
sharannIrajanIrAjyama~njIraviraNatpadAm || 10||
rAkendukoTisaundaryajaitrapAdanakhadyutim |
aShTAbhiH sAttvikairbhAvairAkulIkR^itavigrahAm || 11||
mukundA~NgakR^ipApA~NgAmana~Ngormitara~NgitAm |
tvAmArabdhashriyAnandAM vande vR^indAvaneshvari || 12||
ayi prodyanmahAbhAvamAdhurIvihvalAntare |
asheShanAyikAvasthAprAkaTyAdbhutacheShTite || 13||
sarvamAdhuryavi~njolInirmA~nChitapadAmbuje |
indirAmR^igyasaundaryasphurada~NghrinakhA~nchale || 14||
gokulendumukhIvR^indasImantottaMsama~njari |
lalitAdisakhIyUthajIvAtusmitakorake || 15||
chaTulApA~NgamAdhuryabindUnmAditamAdhave |
tAtapAdayashaHstomakairavAnandachandrike || 16||
apArakaruNApUrapUritAntarmanohrade |
prasIdAsmin jane devi nijadAsyaspR^ihAjuShi || 17||
kachchit tvaM chATupaTunA tena goShThendrasUnunA |
prArthyamAnachapAlA~NgaprasAdA drakShyase mayA || 18||
tvAM sAdhu mAdhavIpuShpairmAdhavena kalAvidA |
prasAdhyamAnAM svidyantIM bIjayiShyAmyahaM kadA || 19||
kelivisraMsino bakakeshavR^indasya sundari |
saMskArAya kadA devi janametaM nidekShyasi || 20||
kadA bimboShThi tAmbUlaM mayA tava mukhAmbuje |
arpyamANaM vrajAdhIshasUnurAchChidya bhokShyate || 21||
vrajarAjakumAravallabhAkulasImantamaNi prasIda me |
parivAragaNasya te yathA padavI me na davIyasI bhavet || 22||
karuNAM muhurarthaye paraM tava vR^indAvanachakravartini |
api keshariporyathA bhavet sa chaTuprArthanabhAjanaM janaH || 23||
imaM vR^indAvaneshvaryA jano yaH paThati stavam |
chATupuShpA~njaliM nAma sa syAdasyAH kR^ipAspadam || 24||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIchATupuShpA~njaliH samAptA |
\chapter{##Shri Gandharvasa.nprarthanashtakam ## .. shrIgAndharvAsa.nprArthanAShTakam ..}
shrIshrIgAndharvikAyai namaH |
vR^indAvane viharatoriha kileku~nje
     mattadvipapravarakautukavibhrameNa |
sandarshayasva yuvayorvadanAravinda
     dvandvaM vidhehi mayi devi kR^ipAM prasIda || 1||
hA devi kAkubharagadgadayAdya vAchA
     yAche nipatya bhuvi daNDavadudbhaTArtiH |
asya prasAdamabudhasya janasya kR^itvA
     gAndharvike nijagaNe gaNanAM vidhehi || 2||
shyAme ramAramaNasundaratAvariShTha
     saundaryamohitasamastajagajjanasya |
shyAmasya vAmabhujabaddhatanuM kadAhaM
     tvAmindirAviralarUpabharAM bhajAmi || 3||
tvAM prachChadena mudirachChavinA pidhAya
     ma~njIramuktacharaNAM cha vidhAya devi |
ku~nje vrajendratanayena virAjamAne
     naktaM kadA pramuditAmabhisArayiShye || 4||
ku~nje prasUnakulakalpitakelitalpe
     saMviShTayormadhuranarmavilAsabhAjoH |
lokatrayAbharaNayoshcharaNAmbujAni
     saMvAhayiShyati kadA yuvayorjano.ayam || 5||
tvatkuNDarodhasi vilAsaparishrameNa
     svedAmbuchumbivadanAmburuhashriyo vAm |
vR^indAvaneshvari kadA tarumUlabhAjo
     saMvIjayAmi chamarIchayachAmareNa || 6||
lInAM niku~njakuhare bhavatIM mukunde
     chitraiva sUchitavatIM ruchirAkShi nAham |
bhugnAM bhruvaM na rachayeti mR^iShAruShAM tvAM
     agre vrajendratanayasya kadA nu neShye || 7||
vAgyuddhakelikutuke vrajarAjasUnuM
     jitvonmadAmadhikadarpavikAsijalpAm |
phullAbhirAlibhiranalpamudIryamANa
     stotrAM kadA nu bhavatImavalokayiShye || 8||
yaH ko.api suShThu vR^iShabhAnukumArikAyAH
     sa.nprArthanAShTakamidaM paThati prapannaH |
sA preyasA saha sametya dhR^itapramodA
     tatra prasAdalaharImurarIkaroti || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM
shrIgAndharvAsa.nprArthanAShTakaM sampUrNam |
\chapter{##Namayugalashtakam ## .. nAmayugalAShTakam ..}
atha shrIrAdhAmAdhavayornAmayugalAShTakaM
shrIshrIrAdhAkR^iShNAbhyAM namaH |
rAdhAmAdhavayoretad vakShye nAmayugAShTkam |
rAdhAdAmodarau pUrvaM rAdhikAmAdhavau tataH || 1||
vR^iShabhAnukumArI cha tathA gopendranandanaH |
govindasya priyasakhI gAndharvAbAndhavastathA || 2||
niku~njanAgarau goShThakishorajanashekharau |
vR^indAvanAdhipau kR^iShNavallabhArAdhikApriyau || 3||

iti shrIrUpagosvAmivirachitastavamAlAyAM
shrIrAdhAmAdhavayornAmayugAShTakaM sampUrNam |
\chapter{##Shri Vrajanavinayuvadvandvashtakam ## .. shrIvrajanavInayuvadvandvAShTakam ..}
shrIrAdhAkR^iShNau jayataH |
adurvidhavidagdhatAspadavimugdhaveshashriyo\-
     ramandashikhikandharAkanakanindivAsastviShoH |
sphuratpuraTaketakIkusumavibhramAbhraprabhA
     nibhA~Ngamahasorbhaje vrajanavInayUnoryugam || 1||
samR^iddhavidhumAdhurIvidhuratAvidhAnoddhurai\-
     rnavAmburuharamyatAmadaviDambanArambhibhiH |
vilimpadiva karNakAvalisahodarairdiktaTI
     mukhadyutibharairbhaje vrajanavInayUnoryugam || 2||
vilAsakalahoddhatiskhaladamandasindUrabhA\-
     gakharvamadanA~Nkushaprakaravibrhamaira~Nkitam |
madoddhuramivobhayormithunamullasadvallarI
     gR^ihotsavarataM bhaje vrajanavInayUnoryugam || 3||
ghanapraNayanirjharaprasaralabdhapUrtermano
     hradasya parivAhitAmanusaradbhirasraiH plutam |
sphurattanuruhA~NkurairnavakadambajR^imbhashriyaM
     vrajattadanishaM bhaje vrajanavInayUnoryugam || 4||
ana~NgaraNavibhrame kimapi vibhradAchAryakaM
     mithashchaladR^iga~nchaladyutishalAkayA kIlitam |
jagatyatuladharmabhirmadhuranarmabhistanvato\-
     rmitho vijayitAM bhaje vrajanavInayUnoryugam || 5||
adR^iShTacharachAturIchalacharitrachitrAyitaiH
     saha praNayibhirjanairviharamAnayoH kAnane |
parasparamanomR^igaM shravaNachAruNA charcharI
     chayena rajayad bhaje vrajanavInayUnoryugam || 6||
marandabharamandirapratinavAravindAvali
     sugandhini vihArayorjalavihAravisphUrjitaiH |
tape sarasi vallabhe salilavAdyavidyAvidhau
     vidagdhabhujayorbhaje vrajanavInayUnoryugam || 7||
mR^iShAvijayakAshibhiH prathitachturIrAshIbhi\-
     rglahasya haraNaM haThAt prakaTayadbhiruchchairgirA |
tadakShakalidakShayoH kalitapakShayoH sAkShibhiH
     kulaiH svasuhR^idAM bhaje vrajanavInayUnoryugam || 8||
idaM valitatuShTayaH paripaThanti padyAShTakaM
     dvayorguNavikAshi ye vrajanavInayUnorjanAH |
muhurnavanavodayAM praNayamAdhurImetayo\-
     ravApya nivasanti te padasarojayugmAntike || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM
shrIvrajanavInayuvadvandvAShTakaM sampUrNam |
\chapter{##Karpanyapanjikastotram ## .. kArpaNyapa~njikAstotram ..}
dhyAnaH |
koNenAkShNoH pR^ithuruchiH mitho hAriNA lihyamAnA\-
     vekaikena prachurapulakenopaguDhau bhujena |
gaurIshyAmau vasanayugalaM shyAmagauraM vasAnau
     rAdhAkR^iShNau smaravilasitoddAmatR^iShNau smarAmi || 1||
atha shrIkArpaNyapa~njikAstotraM
shrIvR^indAvaneshau jayataH
tiShThan vR^indATavIku~nje vij~naptiM vidadhatyasau |
vR^indATavIshayoH pAdapadmeShu kR^ipano janaH || 1||
navendIvarasandohasaundaryAskandanaprabham |
chArugorochanAgarvagauravagrAsigaurabhAm || 2||
shAtakumbhakadambashrIviDambisphuradambaram |
haratA kiMshukasyAMshUn aMshukena virAjitAm || 3||
sarvakaishoravadvR^indachUDArUDhahariNmaNim |
goShThAsheShakishorINAM dhammillottaMsamallikAm || 4||
shrIshamukhyAtmarUpaNAM rUpAtishayivigraham |
ramojjvalavrajavadhUvrajavismApisauShThavAm || 5||
saurabhyahR^itagAndharvaM gandhonmAditamAdhavAm |
rAdhArodhanavaMshIkaM mahatImohitAchyutAm || 6||
rAdhAdhR^itidhanastenalochanA~nchalachApalam |
dR^iga~nchalakalAbhR^i~NgIdaShTakR^iShNahR^idambujAm || 7||
rAdhAgUDhaparIhAsaprauDhinirvachanIkR^itam |
vrajendrasutanarmoktiromA~nchitatanUlatAm || 8||
divyasadguNamANikyashreNIrohaNaparvatam |
umAdiramaNIvyUhaspR^ihaNIyaguNotkarAm || 9||
tvAM cha vR^indAvanAdhIsha tvAM cha vR^indAvaneshvari |
kAkubhirvandamAno.ayaM mandaM prAR^ithayate janaH || 10||
     || dashabhiH kulakam ||
yogyatA me na kAchid vAM kR^ipAlAbhAya yadyapi |
mahAkR^ipAlumaulitvAt tathApi kurutaM kR^ipAm || 11||
ayogye sAparAdhe.api dR^ishyante kR^ipayAkulAH |
mahAkR^ipAlavo hanta loke lokeshavanditau || 12||
bhaktervAM karuNAhetorleshAbhAso.api nAsti me |
mahAlIlesharatayA tadapyatra prasIdatam || 13||
jane duShTe.apyabhakte.api prasIdanto vilokitAH |
mahAlIlAmaheshAshcha hA nAthau bahavo bhuvi || 14||
adhamo.apyuttamaM matvA svamaj~ne.api manIShiNam |
shiShTaM duShTo.apyayaM janturmantuM vyadhita yadyapi || 15||
tathApyasmin kadAchid vAmadhIshau nAmajalpini |
avadyavR^indanistArinAmAbhAsau prasIdatam || 16||
yadakShamyaM nu yuvayoH sakR^idbhaktilavAdapi |
tadAgaH kvApi nAstyeva kR^itAshAM prArthaye tataH || 17||
hanta klIbo.api jIvo.ayaM nItaH kaShTena dhR^iShTatAm |
muhuH prArthayate nAthau prasAdaH ko.apyuda~nchatu || 18||
eSha pApI rudann uchchairAdAya radanaistR^iNam |
hA nAthau nAtheti prANI sIdatyatra prasIdatam || 19||
hAhArAvamasau kurvan durbhago bhikShate janaH |
etAM me shR^iNutaM kAkuM kAkuM shR^iNutamIshvarau || 20||
yAche phutkR^itya phutkR^itya hA hA kAkubhirAkulaH |
prasIdatamayogye.api jane.asmin karuNArNavau || 21||
kroshatyArtasvarairAsye nyasyA~NguShThamasau janaH |
kurutaM kurutaM nAthau karuNAkaNikAmapi || 22||
vAcheha dInayA yAche sAkrandamatimandadhIH |
kirataM karuNasvAntau karuNormichChaTAmapi || 23||
madhurAH santi yAvanto bhAvAH sarvatra chetasaH |
tebhyo.api premamadhuraM prasAdIkurutaM nijam || 24||
sevAmevAdya vAM devAvIhe  ki~nchana nAparam |
prasAdAbhimukhau hanta bhavantau bhavatAM mayi || 25||
nAthitaM paramevedamanAthajanavatsalau |
svaM sAkShAddAsyamevAsmin prasAdIkurutaM jane || 26||
a~njaliM mUrdhni vinyasya dIno.ayaM bhikShate janaH |
asya siddhirabhIShTasya sakR^idapyupapAdyatAm || 27||
amalo vAM pArimalaH kadA parimalan vane |
anargheNa pramodena ghrANaM me ghUrNayiShyati || 28||
ra~njayisyati karNau me haMsagu~njitaga~njanam |
ma~njulaM kiM nu yuvayorma~njIrakalasi~njitam || 29||
saubhAgyA~NkarathA~NgAdilakShitAni padAni vAm |
kadA vR^indAvane pashyann unmadiShyatyayaM janaH || 30||
sarvasaundaryamaryAdAnIrAjyapadanIrajau |
kimapUrvANi parvANi hA mamAkShNorvidhAsyatha || 31||
suchirAshAphalAbhogapadAmbhojavilokanau |
yuvAM sAkShAjjanasyAsya bhavetAmiha kiM bhave || 32||
kadA vR^indATavIku~njakandare sundarodayau |
khelantau vAM vilokiShye suratau nAtidUrataH || 33||
gurvAyattatayA kvApi durlabhAnyonyavIkShaNau |
mithaH sandeshasIdhubhyAM nandayisyAmi vAM kadA || 34||
gaveShayantAvanyo.anyaM kadA vR^indAvanAntare |
sa~Ngamayya yuvAM lapsye hAriNaM pAritoShikam || 35||
paNIkR^itamithohAralu~nchanavyagrahastayoH |
kaliM dyUte vilokiShye kadA vAM jitakAshinoH || 36||
ku~nje kusumashayyAyAM kadA vAmarpitA~NgayoH |
pAdasaMvAhanaM hanta jano.ayaM rachayiShyati || 37||
kandarpakalahodghaTTatruTitAnAM latAgR^ihe |
kadA gumphAya hArANAM bhavantau mAM niyokShyataH || 38||
kelikallolavisrastAn hanta vR^indAvaneshvarau |
karhi barhipatatrairvAM maNDayiShyAmi kuntalAn || 39||
kandarpakelipANDityakhaNDitAkalpayoraham |
kadA vAmalikadvandvaM kariShye tilakojjvalam || 40||
devArambhe vanasragbhirdR^ishau te devi kajjalaiH |
ayaM janaH kadA ku~njamaNDape maNDayiShyati || 41||
jAmbUnadAbhatAmbUlIparNAnyavadalayya vAm |
vadanAmbujayoreSha nidhAsyati janaH kadA || 42||
kvAsau duShkR^itakarmAhaM kva vAmabhyarthanedR^ishI |
kiM vA kaM vA na yuvayorunmAdayati mAdhurI || 43||
yayA vR^indAvane janturanarho.apyeSha vAsyate |
tayaiva kR^ipayA nAthau siddhiM kurutamIpsitam || 44||
kArpaNyapa~njikAmetAM sadA vR^indATavInaTau |
giraiva jalpato.apyasya jantoH sidhyatu vA~nChitam || 45||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIkArpaNyapa~njikAstotraM samAptam |
\chapter{##Utkalikavallarih ## .. utkalikAvallarIH ..}
shrIvR^indAraNyavihAriNe namaH |
prapadya vR^indAvanamadhyamekaH
     kroshannasAvutkalikAkulAtmA |
udghATayAmi jvalataH kaThorAM
     bAShpasya mudrAM hR^idi mudritasya || 1||
aye vR^indAraNya tvaritamiha te sevanaparAH
     parAmApuH ke vA na kila paramAnandapadavIm |
ato nIchairyAche svayamadhipayorIkShaNavidhe\-
     rvareNyAM me chetasyupadisha dishaM hA kuru kR^ipAm || 2||
tavAraNye devi dhruvamiha murAriporviharate
     sadA preyasyeti shrutirapi virauti smR^itirapi |
iti j~nAtvA vR^inde charaNamabhivande tava kR^ipAM
     kuruShva kShipraM me phalatu nitarAM tarShaviTapI || 3||
hR^idi chiravasadAshAmaNDalAlambapAdau
     guNavati tava nAthau nAthituM jantureShaH |
sapadi bhavadanuj~nAM yAchate devi vR^inde
     mayi kira karuNArdrAM dR^iShTimatra prasIda || 4||
dadhataM vapuraMshukandalIM
     daladindIvaravR^indabandhurAm |
kR^itakA~nchanakAntiva~nchanaiH
     sphuritAM chArumarIchisa~nchayaiH || 5||
nichitaM ghanacha~nchalAtate\-
     ranukUlena dukUlarochiShA |
mR^iganAbhiruchaH sanAbhinA
     mahitAM mohanapaTTavAsasA || 6||
mAdhurIM prakaTayantamujjvalAM
     shrIpaterapi variShThasauShThavAm |
indirAmadhuragoShThasundarI
     vR^indavismayakaraprabhonnatAm || 7||
itarajanadurghaTodayasya
     sthiraguNaratnachayasya rohaNAdrim |
akhilaguNavatIkadambachetaH
     prachurachamatkR^itikArisadguNADhyam || 8||
nistulavrajakishoramaNDalI
     maulimaNDanaharinmaNIshvaram |
vishvavisphUritagokulollasan
     navyayauvatavataMsamAlikAm || 9||
svAntasindhumakarIkR^itarAdhaM
     hR^innishAkarakura~NgitakR^iShNAm |
preyasIparimalonmadachittaM
     preShThasaurabhahR^itendriyavargAm || 10||
premamUrtivarakArttikadevI
     kIrtigAnamukharIkR^itavaMsham |
vishvanandanamukundasamaj~nA
     vR^indakIrtanarasaj~narasaj~nAm || 11||
nayanakamalamAdhurIniruddha
     vrajanavayauvatamaulihR^inmarAlam |
vrajapatisutachittamInarAja
     grahaNapaTiShThavilochanAntajAlAm || 12||
gopendramitratanayAdhruvadhairyasindhu
     pAnakriyAkalasasambhavaveNunAdam |
vidyAmahiShThamahatImahanIyagAna
     sammohitAkhilavimohanahR^itkura~NgAm || 13||
kvApyAnusa~NgikatayoditarAdhikAkhyA
     vismAritAkhilavilAsakalAkalApam |
kR^iShNetivarNayugalashravaNAnubandha
     prAdurbhavajjaDimaDambarasaMvitA~NgIm || 14||
tvAM cha vallavapurandarAtmaja
     tvAM cha gokulavareNyanandini |
eSha mUrdhni rachitA~njalirnayan
     bhikShate kimapi durbhago janaH || 15||
hanta sAndrakaruNAsudhAjharI
     pUrNamAnasahradau prasIdatam |
durjane.atra dishataM rate nija
     prekShaNapratibhuvashChaTAmapi || 16||
shyAmayornavavayaHsuShamAbhyAM
     gaurayoramalakAntiyashobhyAm |
kvApi vAmakhilavalguvataMsau
     mAdhurI hR^idi sadA sphuratAn me || 17||
sarvavallavavareNyakumArau
     prArthaye bata yuvAM praNipatya |
lIlayA vitarataM nijadAsyaM
     lIlayA vitarataM nijadAsyam || 18||
praNipatya bhavantamarthaye
     pashupAlendrakumAra kAkubhiH |
vrajayauvatamaulimAlikA
     karuNApAtramimaM janaM kuru || 19||
bhavatImabhivAdya chATubhi\-
     rvaramUrjeshvari varyamarthaye |
bhavadIyatayA kR^ipAM yathA
     mayi kuryAdadhikAM bakAntakaH || 20||
dishi vidishi vihAramAcharantaH
     saha pashupAlavareNyanandanAbhyAm |
praNayijanagaNAstayoH kurudhvaM
     mayi karuNAM bata kAkumAkalayya || 21||
giriku~njakuTIranAgarau
     lalite devi sadA tavAshravau |
iti te kila nAsti duShkaraM
     kR^ipayA~NgIkuru mAmataH svayam || 22||
bhAjanaM varamihAsi vishAkhe
     gauranIlavapuShoH praNayAnAm |
tvaM nijapraNayinormayi tena
     prApayasva karuNArdrakaTAkSham || 23||
subala vallavavaryakumArayo\-
     rdayitasakhastvamasi vraje |
iti tayoH purato vidhuraM janaM
     kShaNamamuM  kR^ipayAdya nivedaya || 24||
shR^iNuta kR^ipayA hanta prANeshayoH praNayoddhurAH
     kimapi yadayaM dInaH prANI nivedayati kShaNam |
pravaNitamanAH kiM yuShmAbhiH samaM tilamapyasau
     yugapadanayoH sevAM premNA kadApi vidhAsyati || 25||
kva jano.ayamatIva pAmaraH
     kva durApaM ratibhAgbhirapyadaH |
iyamullayatyajarjarA guru\-
     ruttarShadhurA tathApi mAm || 26||
dhvantabrahmamarAlakUjitabharairUrjeshvarInUpura
     kvAnairUrjitavaibhavastava vibho vaMshIprasUtaH kalaH |
labdhaH shastasamastanAdanagarIsAmrAjyalakShmIM parAM
     ArAdhyaH praNayAt kadA shravaNayordvandvena mandena me || 27||
stambhaM prapa~nchayati yaH shikhipi~nChamauli
     veNorapi pravalayan svarabha~NgamuchchaiH |
nAdaH kadA kShaNamavApsyati te mahatyA
     vR^indAvaneshvari sa me shravaNAtithitvam || 28||
kasya sambhavati hA tadaharvA
     yatra vAM prabhuvarau kalagItiH |
unnaman madhurimormisamR^iddhA
     duShkR^itaM shravaNayorvidhunoti || 29||
parimalasaraNirvAM gauranIlA~NgarAjan
     mR^igamadaghusR^iNAnugrAhiNI nAgareshau |
svamahimaparamANuprAvR^itAsheShagandhA
     kimiha mama bhavitrI ghrANabhR^i~NgotsavAya || 30||
pradeshinIM mukhakuhare vinikShipan
     jano muhurvanabhuvi phutkarotyasau |
prasIdataM kShaNamadhipau prasIdataM
     dR^ishoH puraH sphuratu taDidghanachChaviH || 31||
vrajamadhurajanavrajAvataMsau
     kimapi yuvAmabhiyAchate jano.ayam |
mama nayanachamatkR^itiM karotu
     kShaNamapi pAdanakhendukaumudI vAm || 32||
atarkitasamIkShaNollasitayA mudA shliShyato\-
     rniku~njabhavanA~Ngane sphuritagauranIlA~NgayoH |
ruchaH prachurayantu vAM puraTayUthikAma~njarI
     virAjadaliramyayormama chamatkR^itiM chakShuShoH || 33||
sAkShAtkR^itiM bata yayorna mahattamo.api
     kartuM manasyapi manAk prabhutAmupaiti |
ichChannayaM nayanayoH pathi tau bhavantau
     janturvijitya nijagAra bhiyaM hriyaM cha || 34||
athavA mama kiM nu dUShaNaM
     bata vR^indAvanachakravartinau |
yuvayorguNamAdhurI navA
     janamunmAdayatIva kaM na vA || 35||
ahaha samayaH so.api kShemo ghaTeta narasya kiM
     vrajanaTavarau yatroddIptA kR^ipAsudhayojjvalA |
kR^itaparijanashreNichetashchakorachamatkR^iti\-
     rvrajati yuvayoH sA vaktrendudvayI nayanAdhvani || 36||
priyajanakR^itapArShNigrAhacharyonnatAbhiH
     sugahanaghaTanAbhirvakrimADambareNa |
praNayakalahakelikShvelibhirvAmadhIshau
     kimiha rachayitavyaH karNayorvismayo me || 37||
nibhR^itamapahR^itAyAmetayA vaMshikAyAM
     dishi dishi dR^ishamutkAM prerya sampR^ichChamAnaH |
smitashavalamukhIbhirvipralabdhaH sakhIbhi\-
     stvamaghahara kadA me tuShTimakShNorvidhatse || 38||
kShatamadharadalasya svasya kR^itvA tvadAlI
     kR^itamiti lalitayAM devi kR^iShNe bruvANe |
smitashavaladR^igantA ki~nchiduttambhitabhrU\-
     rmama mudamupadhAsyatyAsyalakShmIH kadA te || 39||
kathamidamapi vA~nChituM nikR^iShTaH
     sphuTamayamarhati janturuttamArham |
gurulaghugaNanojjhitArtanAthau
     jayatitarAmathavA kR^ipAdyutirvAm || 40||
vR^itte daivAd vrajapatisuhR^innandinIvipralambhe
     saMrambheNollalita lalitAsha~NkayodbhrAntanetraH |
tvaM shArIbhiH samayapaTubhirdrAg upAlabhyamAnaH
     kAmaM dAmodara mama kadA modamakShNorvidhAtA || 41||
rAsArambhe vilasati parityajya goShThAmbujAkShI
     vR^indaM vR^indAvanabhuvi rahaH keshavenopanIya |
tvAM svAdhInapriyatamapadaprApaNenArchitA~NgIM
     dUre dR^iShTvA hR^idi kimachirAdarpayiShyAmi darpam || 42||
ramyA shoNadyutibhiralakairyAvakenorjadevyAH
     sadyastandrImukuladalasaklAntanetrA vrajesha |
prAtashchandrAvalIparijanaiH sAchi dR^iShTA vivarNai\-
     rAsyashrIste praNayati kadA sammadaM me mudaM cha || 43||
vyAtyukShIrabhasotsave.adharasudhApAnaglahe prastute
     jitvA pAtumathotsukena hariNA kaNThe dhR^itAyAH puraH |
IShachChoNimamIlitAkShamanR^ijubhrUvallihelonnataM
     prekShiShye tava sasmitaM saruditaM tad devi vaktraM kadA || 44||
AlIbhiH samamabhupetya shanakairgAndharvikAyAM mudA
     goShThAdhIshakumAra hanta kusumashreNIM harantyAM tava |
prekShiShye purataH pravishya sahasA gUDhasmitAsyaM balAd
     AchChindAnamihottarIyamurasastvAM bhAnumatyAH kadA || 45||
uda~nchati madhUtsave sahacharIkulenAkule kadA
     tvamavalokyase vrajapurandarasyAtmaja |
smitojjvalamadIshvarIchaladR^iga~nchalapreraNAn
     nilInaguNama~njarIvadanamatra chumban mayA || 46||
kalindatanayAtaTivanavihArataH shrAntayoH
     sphuranmadhuramAdhavIsadanasImni vishrAmyatoH |
vimuchya rachayiShyate svakachavR^indamatrAmunA
     janena yuvayoH kadA padasarojasanmArjanam || 47||
parimiladupabarhaM pallavashreNibhirvAM
     madanasamaracharyAbhAraparyAptamatra |
mR^idubhiramalapuShpaiH kalpayiShyAmi talpaM
     bhramarayuji niku~nje hA kadA ku~njarAjau || 48||
alidyutibhirAhR^itairmihiranandinInirjharAt
     puraH puraTajharjharIparibhR^itaiH payobhirmayA |
nijapraNayibhirjanaiH saha vidhAsyate vAM kadA
     vilAsashayanasthayoriha padAmbujakShAlana || 49||
lIlAtalpe kalitavapuShorvyAvahAsImanalpAM
     smitvA smitvA jayakalanayA kurvatoH kautukAya |
madhye ku~njaM kimiha yuvayoH kalpayiShyAmyadhIshau
     sandhArambhe laghu laghu padAmbhojasaMvAhanAni || 50||
pramadamadanayuddhArambhasambhAvukAbhyAM
     pramuditahR^idayAbhyAM hanta vR^indAvaneshau |
kimahamiha yuvAbhyAM pAnalIlonmukhAbhyAM
     chaShakamupahariShye sAdhu mAdhvIkapUrNam || 51||
kadAhaM seviShye vratatichamarIchAmaramarud
     vinodena krIDAkusumashayane nyastavapuShau |
daronmIlannetrau shramajalakaNaklidyadalakau
     bruvANAvanyonyaM vrajanavayuvAnAviha yuvAm || 52||
chyutashikharashikhaNDaM ki~nchidutsraMsamAnAM
     viluThadamalapuShpashreNimunmuchya chUDAm |
danujadamana devyAH shikShayA te kadAhaM
     kamalakalitakoTiM kalpayiShyAmi veNIm || 53||
kamalamukhi vilAsairaMsayoH sraMsitAnAM
     tulitashikhikalApaM kuntalAnAM kalApam |
tava kavaratayAvirbhAvya modAt kadAhaM
     vikachavichakilAnAM mAlayAla~NkariShye || 54||
mithaHspardhAbaddhe balavati valatyakShakalahe
     vrajesha tvAM jitvA vrajayuvatidhammillamaNinA |
dR^igantena kShiptAH paNamiha kura~NgaM tava kadA
     grahIShyAmo baddhA kalayati vayaM tatpriyagaNe || 55||
kiM bhaviShyati shubhaH sa vAsaro
     yatra devi nayanA~nchalena mAm |
garvitaM vihasituM niyokShyase
     dyUtasaMsadi vijitya mAdhavam || 56||
kiM janasya bhavitAsya tad dinaM
     yatra nAtha muhurenamAdR^itaH |
tvaM vrajeshvaravayasyanandinI
     mAnabha~NgavidhimarthayiShyase || 57||
tvadAdeshaM shArIkathitamahamAkarNya mudito
     vasAmi tvatkuNDopari sakhi vilambastava katham |
itIdaM shrIdAmasvasari mama sandeshakusumaM
     hareti tvaM dAmodara janamamuM notsyasi kadA || 58||
shaTho.ayaM nAvekShya punariha mayA mAnadhanayA
     vishantaM strIveshaM subalasuhR^idaM vAraya girA |
idaM te sAkUtaM vachanamavadhAryochChalitadhIsh\-
     ChalATopairgopapravaramavarotsyAmi kimaham || 59||
aghahara balIvardaH preyAnnavastava yo vraje
     vR^iShabhavapuShA daityenAsau balAdabhiyujyate |
iti kila mR^iShAgIrbhishchandrAvalInilayasthitaM
     vanabhuvi kadA neShyAmi tvAM mukunda madIshvarIm || 60||
nigirati jagaduchchaiH sUchibhedye tamisre
     bhramararuchinicholenA~NgamAvR^itya dIptam |
parihR^itamaNikA~nchInUpurAyAH kadAhaM
     tava navamabhisAR^iM kAR^iyiShyAmi devi || 61||
Asye devyAH kathamapi mudA nyastamAsyAt tvayesha
     kShiptaM parNe praNayajanitAd devi vAmyAt tvayAgre |
AkUtaj~nastadatinibhR^itaM charvitaM kharvitA~Nga\-
     stAmbUlIyaM rasayati janaH phullaromA kadAyam || 62||
parasparamapashyatoH praNayamAninorvAM kadA
     dhR^itotkelikayorapi svamabhirakShatorAgraham |
dvayoH smitamuda~nchaye nudasi kiM mukundAmunA
     dR^igantanaTanena mAmuparametyalIkoktibhiH || 63||
kadApyavasaraH sa me kimu bhaviShyati svAminau
     jano.ayamanurAgataH pR^ithuni yatra ku~njodare |
tvayA saha tavAlike vividhavarNagandhadravyaish\-
     chiraM virachayiShyati prakaTapatravallIshriyam || 64||
idaM sevAbhAgyaM bhavati sulabhaM yena yuvayosh\-
     ChaTApyasya premNaH sphurati nahi suptAvapi mama |
padArthe.asmin yuShmadvrajamanu nivAsena janita\-
     stathApyAshAbandhaH parivR^iDhavarau mAM draDhayati || 65||
prapadya bhavadIyatAM kalitanirmalapremabhi\-
     rmahadbhirapi kAmyate kimapi yatra tArNaM januH |
kR^itAtra kujanerapi vrajavane sthitirme yayA
     kR^ipAM kR^ipaNagAminIM sadasi naumi tAmeva vAm || 66||
mAdhavyA madhurA~Nga kAnanapadaprAptAdhirAjyashriyA
     vR^indAraNyavikAsisaurabhatate tApi~nChakalpadruma |
nottApaM jagadeva yasya bhajate kIrtichChaTAchChAyayA
     chitrA tasya tavA~NghrisannidhijuShAM kiM vA phalAptirneNAm || 67||
tvallIlAmadhukulyayollasitayA kR^iShNAmbudasyAmR^itaiH
     shrIvR^indAvanakalpavalliparitaH saurabhyavisphArayA |
mAdhuryeNa samastameva pR^ithunA brahmANDamapyAyitaM
     nAshcharyaM bhuvi labdhapAdarajasAM parvonnatirvIrudhAm || 68||
pashupAlavareNyanandanau
     varametaM muhurarthaye yuvAm |
bhavatu praNayo bhave bhave
     bhavatoreva padAmbujeShu me || 69||
udgIrNAbhUdutkalikAvallariragre
     vR^indATAvyAM nityavilAsavratayorvAm |
vA~NmAtreNa vyAharato.apyullalametAM
     AkarNyeshau kAmitasiddhiM kurutaM me || 70||
chandrAshvabhuvane shAke pauShe gokulavAsinA |
iyamutkalikApUrvA vallarI nirmitA mayA || 71||
(1471 shakAbde, 1550 khR^iShTAbde)

iti shrIrUpagosvAmivirachitastavamAlAyAM utkalikAvallarI samAptA |
\chapter{##Govindabirudavalih ## .. govindabirudAvaliH ..}
shrIshrIrAdhAkR^iShNayoH ku~njAd veshmAgamanaM
srastaM srastamuda~nchayantyadhishiraH shyAmaM nicholA~nchalaM
     hastena shlathadurbalena lulitAkalpyaM vahantI tanum |
muktArdhAmavarudhya veNimalasaspande kShipantI dR^ishau
     ku~njAt pashya gR^ihaM pravishya nibhR^itaM shete sakhI rAdhikA || 1||
mlAnAmutkShipya mAlAM truTitamaNisaraH kajjalaM vibhradoShThe
     sa~NkIrNA~Ngo nakhA~Nkairdishi dishi vikiran ghUrNite netrapadme |
pashya mlAnA~NgayaShTiH sphuTamaparichito gopagoShThIbhiragre
     goShThaM goShThendrasUnuH pravishati rajanau dhvaMasamAsAdayantyAm || 2||
iti shrIshrIrAdhAkR^iShNayoH ku~njAdveshmAgamanaM samAptam |

iti shrIrUpagosvAmivirachitastavamAlAyAM govindabirudAvaliH samAptA |
\chapter{##Chando ashtadashakam ## .. Chando.aShTAdashakam ..}
varNanIyapratij~nA | namaH shrIkR^iShNAya |
jIyAnnAma murAreH premamarandasya navyamaravindam |
bhavati madAbhAso.api svAtijalaM muktimuktAyAH || 1||
nandotsavAdayastAH kaMsavadhAntA harermahAlIlAH |
ChandobhirlalitA~NgairaShTAdashabhirnirUpyante || 2||
danujatR^iNakadamboddAmadAvAgnirAshe
     kusumitaravikanyAtIravanyAkarIndra |
madakalapashupAlIlochanendIvarendo
     bhavatu tava charitraM madgirAM maNDanAya || 3||
mUlotkhAtavidhAyinI bhavataroH kR^iShNAnyatR^iShNAkShayAt
     kheladbhirmunichakravAkanichayairAchamyamAnA muhuH |
karNAnandikalasvanA vahatu me jihvAtaTIprA~NgaNe
     ghUrNattu~NgarasAvalistava kathApIyUShakallolinI || 4||
\section{1}
atha shrInandotsavAdicharitaM
nijamahimamaNDalIvrajavasatirochanaM
     vadanavidhumAdhurIramitapitR^ilochanam |
shrutinipuNabhUsuravrajavihitajAtakaM
     tanujaladatarpitasvajanagaNachAtakam ||
subahuvidhadAnakR^ijjanakakR^itakautukaM
     nikhilapashupAvalIsamupahR^itayautukam |
janisamayamaNDitIkR^itapuruShayoShitaM
     rajanirasagorasakShapaNajanatoShitam ||
bahuladadhipa~NkilIkR^itavilasada~NganaM
     pramadabharalolitaprakaTanaTada~Nganam |
janakaparitoShitasphuradakhilavallavaM
     vrajajanitapadmajAvibhavabharapallavam ||
kapaTapaTupUtanAkaTunayanavIkShitaM
     vrajabhayadanurjanavrajanidhanadIkShitam |
viShamabakapUrvajAkuchasavidhashAyinaM
     tadasuparimishritastanajarasapAyinam ||
tadarutaravigrahadrumanivahapAtanaM
     pR^ithukaripurAkShasIvividhabhavashAtanam |
nipuNapashupA~NganAkulakalitarakShaNaM
     praNayakR^itagorajaHshakR^idamalalakShaNam ||
spuTanikhilavallavIhR^idayanavachandanaM
bhaja chapalamAnasa vrajanR^ipatinandanam ||
guchChakAkhyamidaM ChandaH |
tava jayati nandanandana padAravindorubhaktimakarandaH |
yan mAdhurIlavAgre muktisukhaM shuktitAmeti || 5||
\section{2}
atha shakaTatR^iNAvartabha~NgAdi
mama matiruchchalacharaNe bhagavati parya~NkikAshayite |
kapaTakranditakushale shakaTavighaTTini parisphuratu || 6||
atha shakaTAriShTadaityavadhaH
autthAnikamahasa~NkulitAmbaka
shakaTAdhastanashayanAlambaka
kucharasatR^iShNAvirachitarodana
cha~nchalapadakR^itashakaTavinodana
vismitapashupasudurgamacheShTita
kathitanijehitashAvakaveShTita
kAtarajananIjanakagatAntika
mAntrikadharaNIsurakR^itashAntika ||
atha tR^iNAvartavadhaH
jananIdurvahagauravavigraha sapadi vidhitsitadanujavinigraha
     danutanayena kShaNamapavAhita kaNThataTIgrahanirmathitAhita |
viklavajananInirbharashochita virudadgopIkulaparilochita
     nirmitajananIbandhumahodaya mAmapi gokulama~Ngala modaya ||
atha nAmakaraNasaMskAraH
navashishulIlAla~NghitahAyana gargAviShkR^itanAmarasAyana |
ri~NganamaNDitanandaniketana mudhurimatarpitagokulachetana |
chalataratarNakapuchChavikarShaNa vismR^itagR^ihakR^itiramaNIharShaNa |
kutukinnasamayavatsavimochana chauryavisha~Nkitacha~nchalalochana |
AkroshanakR^itahasitADambara mukhapATavakR^italu~nchanasaMvara |
rachitolUkhalapR^iShThavirAjana randhritashikyasthitavarabhAjana |
gavyanirmitakapikulara~njana kalpitanavadadhihaNDIbha~njana |
jananIvIkShitasabhayavilochana jaya jaya gokulapadmavirochana ||
atha mR^idbhakShaNalIlA
rAmaprakaTIkR^itamR^idbhakShaNa jananIsammukhadhR^itabhayalakShaNa |
mukhapuTadarshitanikhilacharAchara gopeshvarasuta mayi mudamAchara ||
korakAkhyamidaM ChandaH |
atha dadhiharaNaM
gR^ihaM sakhi karAlike pravishati sma nIlaH shishu\-
     rdR^iDhIkuru kavATikAM dadhiharaM dadhAmyuddhuram |
iti prakaTamIrite mukharayA mahAsha~NkaTaM
     vilokya tanuka~NkaTIkR^itatamA hariH pAtu vaH || 7||
\section{3}
atha yamalArjunabha~njanaM
indranIlamadhuraprabhaM janaM
     hAsayantamanasaH prabha~njanam |
bibhrataM puraTapi~NgalaM paTaM
     dhehi chitta navanItalampaTam || 8||
dhR^itadadhimanthanadaNDa jananIchumbitagaNDa
pItasavitradugdha kalabhAShitakulamugdha |
jananIpayasAtR^ipta bhAjanabha~njanadR^ipta
kR^itahaiya~NgavamoSha mAtR^ivinirmitaroSha |
janayitrIkR^itadhAva munigaNadurlabhabhAva
viditasAvitrIpIla parihR^itadhAvanalIla |
dhR^itahaiya~Ngavagandha kalitolUkhalabandha
dR^iShTArjunatarumUla suramunivAganukUla |
kR^itayamalArjunabha~Nga guhyakanutidhR^itara~Nga
nijabhaktIkR^itayakSha mAdhava mAmapi rakSha |
vismitavallavadR^iShTa susmitamukhapuTa hR^iShTa
nandavimochitabandha jaya jaya ma~Ngalakanda || 3||
anukUlAkhyamidaM ChandaH |
bR^ihadvipinamaNDane kaluShamaNDalIkhaNDane
     vrajapraNayashaMsane danujavR^iddhividhvaMsane |
muhurdharaNirochane mahitavallavIlochane
     parisphuratu kaishave ratiratIva naH shaishave || 9||
\section{4}
atha shrIvR^indAvanagovatsachAraNAdilIlA
kadA vR^indAraNye mihiraduhituH sa~Ngamahite
     muhurbhrAmaM bhrAmaM charitalaharI gokulapateH |
lapann uchchairuchchairnayanapayasAM veNibhirahaM
     kariShye sotkaNTho niviDamavasekaM viTapinAm || 10||
vrajendurupanandAntarINamatinodI
manoj~nataravR^indAvanAntaranumodI |
antaHsthajanayitryA nijA~NgamupanItaH
kura~NganayanAbhiH saharShamanugItaH |
praphullapR^ithuvR^indAvanopahR^itara~NgaH
kalindagiriputrItaTAntadhR^itasa~NgaH |
girIndrakaTakA~NgIkR^itoruparitoShaH
samastasakhirAjIvilAsamaNikoShaH |
samIpabhuvi vatsaprachAradhR^itatarShaH
suhR^itsu gurukhelAbhareNa kR^itaharShaH |
tara~NgadurugeNDupraviShTachaladR^iShTiH
praNItavaravaMshIninAda navasR^iShTiH |
tarakShunakhalakShmIparItamR^idukaNThaH
kaTIrataTakUjadvichitralaghughaNTaH |
samUDhashikhichUDApraNItavarachUDaH
suma~njutaragu~njAvalIbhirupagUDhaH |
suhR^idbhirapi sArdhaM prapannavR^iShaveShaH
kaThorataravatsAsurebhaharireShaH |
sthaviShThabakatuNDapraveshakR^italIla\-
tada~NgagirikUTaprabhedaparishIlaH |
suhR^idbhiratihR^iShTairbhujAbhirabhimR^iShTaH
suraishcha sumanobhirvarAbhirabhivR^iShTaH |
tanotu mayi tuShTiM svavatsakulapAlI
praphullakusumAlIdharo.adya vanamAlI || 4||
praphullakusumAlInAmedaM ChandaH |
api sphArAmode pratipadasudhAkoTimadhure
     purANagrAmAntarvahati tava lIlArasajhare |
manovatsaH pAtuM viShayaviShagarte vishati me
     kR^ipAyaShTyA tUrNaM damaya tamamuM tarNakapate || 11||
\section{5}
atha vatsachAraNAdicharitaM
AbhAso.api shrutiparisaraM tAvakInasya nAmnaH
     sarpannalpaM laghutaramaghastomamokShaM karoti |
naitachchitraM sakhibhirakhilairantarAlaM praviShTo
     yad govinda svayamayamagahaM mokShayasyekameva || 12||
kAnanAntabhuktikamamuchchanAdapUradhAma
shR^i~NgabuddhavatsapAlavalgubAlachakravAla
sa~NgalabdhatoShajAlamagranunnavatsapAlaM
adbhutAtibhUrikhelamitrasa~NganItavelaM
a~NgaruddhakAnanasya shArvarA~nchitAnanasya
dAvatulyalochanasya pUtigandhimochanasya
meghabhAgatAnavasya sarparUpadAnavasya
vIkShayAtivismitena tasya kukShimAshritena
vatsapAlamaNDalena nItakhedamuchchalena
tatra ma~NkShu sa.npraviShTamuddhUtasvabhaktariShTa
medhitA~NgaruddhavAtamarditAhijanmajAtaM
IkShayAbhIjIvitena Dimbhasa~nchayena tena
sArdhametya sattaDAgatIramAptabhuktirAgaM
eShu bhotkumudyateShu bhUrirAjisantateShu
madhyasImni rAjamAnamarpitebhaDimbhamAnaM
atra sarvasammukhAsyamujjihAnamandahAsyaM
adhvaropapannabhakShamarbhakopabhogadakShaM
indramukhyadevavargavIkShamANakelisargaM
eShu vatsapAlakeShu bhakShayatsu bAlakeShu
dUragAmivatsapu~njasa~NgamAya labdhaku~njaM
ambujanmayoninA tadutsakena vatsajAtaM
arbhamaNDalaM cha nItamabhramAbhisamparIta
dhItayAdhigatya hAsamudvamantamindubhAsaM
Ashu tattadAtmarUpasanniveshitasvarUpaM
etadIyamAtR^itoShahetushIlaratnakoShaM
ullasantamatra varShamedhitAnurAgatarShaM
abjayonidR^iShTatattvamadbhutAtishuddhasattva
rUpavIkShaNAtimattagokulAnuvR^ittyatta
padmajastutAnubhAvamAhR^itAtmagoShThashAvaM
ambujAkSha bho bhavantamAshrayAmi kundadanta
nandagoShThabhUribhAga chArukuntalAgrabhAga
shokapuShpama~njarIka gandhalubdhacha~ncharIka
pItakelipuNDarIka vashyavatsamaNDalIka
bAhurAjada~NgadAya mitrasa~Nghara~NgadAya
pAdashobhihaMsakAya sundarAvataMsakAya
guptachArutarNakAya kLLiptadhAtuvarNakAya
gopagotravallabhAya yogivargadurlabhAya
karNasa~NgichampakAya durgatAnukampakAya
tubhyamiddhakIrtigAtha sarvadA namo.astu nAtha
dehi dehi bhaktileshamapyasheShapUrusheSha ||
ashokapuShpama~njarIChandaH
yAM nirvaktumabhUt prabhurnahi chaturvaktro.api te mAdhurIM
     tAmudghATayatAdya yadyapi satAM hAso mayA svIkR^itaH |
vaiphalyAya tathApi deva bhavitA nAyaM mamopAkramaH
     sarvAnarthaharastvadIyabhajanAbhAso.api yad vishrutaH || 13||
\section{6}
atha tAlavanacharitam |
sa pAtu mAM yastR^iNarAjarAjI
     phalairvirAjan vrajarAjaputraH |
sukhAni chakrA~NkakaraH sakhInAM
     chakrIvatAM chakramudasya chakre || 14||
jaya dhenulakShashataguptidakShavanamaNDalAntamanusR^itya kAntaM
upalabdhaharSha kR^itakelivarSha baladevagItaghanashAkhishIta
vanarAjirUpa pashupAlabhUpa kR^itapakShivArachariktAnukAra
dhR^itamitrara~Nga rasavalgada~Nga purumallayuddha paTubAhuruddha
baladurdurUDhanijamitrakUTa yamunopakUlatarurAjimUla
padabhadrasenakR^itadugdhaphenapaTalAnukalpanavapuShpatalpa
varamadhyasupta suhR^idAligupta vR^iShabhAnubaddhamR^idurAganaddha
kalagItahR^iShTa subalAbhimR^iShTa kR^itapadmAnandacharaNAravinda
viTapAvatAnaparivIjyamAna paripakvatAlaphalalubdhabAla
kalavAkyarUDhahasitopagUDhamukhatArakesha dhR^itavIravesha
ghanatu~NgatAlavipinAntarAlamupalabdharAmasahitAtmadhAma
dhutaghUrNadagratR^iNarATsamagraphalavR^indapAtakR^itaharShajAta
phalashabdaruShTakhararUpaduShTaharakAmapAlakR^itaharShamAla
turagArikAla kharachakravAlatR^iNavItihotra ramitAtmagotra
hatadhenukAdya vibudhAbhivAdya tR^iNarAjabha~NgabharajAtara~Nga
ripuvargabhIda mayi sa.nprasIda || 6||
kalagItanAmedaM ChandaH |
pInApInabharodgatairanudinaM yAH kShIrapUrairbalAd
     ambhojAkSha viDambayanti niviDaM kShIrAmbudhairvaibhavam |
tAsAM rAjatagaNDashailapaTalIpANDutviShAM maNDalaM
     dhenUnAM paripAlayantamaTavIku~nje bhavantaM bhaje || 15||
\section{7}
atha kAliyadamanaM
kAliyasya phaNaratnakuTTimaM
     kuTTayan padasarojaghaTTanaiH |
ma~NgalAni vitanotu tANDave
     paNDitastava shikhaNDashekharaH || 16||
jagadvinAshi sa~NgamaM garutmatA gaja~NgamaM
bhuja~NgamaNDalIpadaM pata~NganandinIhradaM
viShAgnidagdhanIrajaM nirIkShya tasya tIrajaM
mudAdhiruhya darpataH kadambamugrasarpataH
payo vikIrNavAn alaM parijvaladviShAnalaM
dhanuHshate satAM gatirbhujoddhatAmbusaMhatiH
karAladR^iShTidAruNaiH phaNairmaNiprabhAruNai\-
yutena lokadAhinA vinadya kAliyAhinA
ruShodbhaTena veShTitaH prapannabAlachesTita\-
tato.adbhutAvalokataH sametya tIvarshokata\-
tanuskhalatpaTAlibhirmahArtanAdashAlibhi\-
balopadeshasAratastadA hradAvatArataH
shaniarnivR^ittalAlasairmuhurvyathAkulAlasaiH
sadAravR^iddhabAlakaiH samastadhenupAlakai\-
vilokitaH smitAnanaH kR^itoragAvamAnanaH
praNunnabhogarodhanaH suhR^idgaNAdhishodhanaH
shritANDajendravibhramaH sphuratkarAlavikramaH
svamUrdharatnapi~njaraM nirasya nAgaku~njaraM
plutena tasya ra~NgataH phaNA~NgaNShu sa~NgataH
praNItadivyanartanaH kR^itotsavAnuvartanaH
prasUnavR^indavarShibhiH khalArdanena harShibhiH
sapadmabhUpinAkibhirnabhasyanalpanAkibhiH
stuto vichitrabAlakaH sulAsyatashcha lAlakaH
sakhi svabAlyacha~nchalaM paribhramaddR^iga~nchalaM
sushobhanA~NgahArakaM bhuja~NgadarpadArakaM
praNItanR^ityahastakaM vilAsakampimastakaM
vikAsihAsyakorakaM vololakaNNThaDorakaM
rasAdamuM samagrataH sphuTaM naTantamagrataH
sutaM vilokayAdhunA tvamIkShaNena sAdhunA
vrajeshvarIti yoShitAM giraM pramodaghoShitAM
nishamya labdhamodayA vilokito yashodayA
khalapramaardane kharaH shriyA hyana~NgashekharaH
phaNavraje muhuH plutaH phaNAvatIgaNaiH stuta\-
tadAtidakShiNAshayaH phaNIshvare kR^itAbhayaH
kShaNAdamUbhirarchitaH parArdhagandhacharchitaH
shrutiprasaktakairavaH phaNivrajeShvabhairavaH
svabandhuvR^indanandanaH kR^itAryapAdavandanaH
praharShato.avilambayA vichumbitastvamambayA
jaya prabho kR^ipAnidhe vilAsaratnavAridhe
natArtipUrashAtana prasIda me sanAtana || 7||
ana~NgashekharachChandaH |
kAmaM dAmodara mama manaHpannagaH pInabhogo
     duShTAshIbhiH kuTilavalanaiH kShobhayatyeSha lokam |
tadvikrAntastvamuditapadadvandvapa~NkeruhA~NkaM
     kurvan darvIkaradamana he tANDavairdaNDayAmum || 17||
\section{8}
atha bhANDIrakrIDanAdi
bhANDIrasya taTAnte taruShaNDAkhaNDalasya raNashauNDa |
sakhimaNDalAni bADhaM vikrIDaya puNDarIkAkSha || 18||
suhR^idAvaliparivItaH shrutiharamuralIgItaH
surabhIvIthyanusArI varapItAmbaradhAra
pInojjvalabhujadaNDaH shirasi sphuritashikhaNDaH
shashikhaNDAbhalalATaH pIvarahR^idayakavATaH
kharamihirAtapavAse prasaratyapi shuchimAse
dhR^itamadhulakShmIbhAraM parihR^itadAvavikAraM
dhenumanoharashAdaM pikakR^itapa~nchamanAdaM
ShaDjodgArimayUraM visR^imarasaurabhapUraM
vikasitachArushirIShaM sphuTamallInivirIShaM
vR^indAvanamatihR^iShTaH sabalaH svayamabhiviShTaH
kalpitabhujasa~NgrAmaH kvachidIhitavishrAmaH
kutrachidabhinavatumbaiH kvachidatikomalakumbhaiH
kva cha paripAkimagu~njaiH kva cha bilvAmalapu~njaiH
krIDannadbhutacharyaH keliShu paNDitavaryaH
pIvarakutukAdhAre dvandvIbhAvavihAre
kalpitanirbhararAgaH kR^itasakhivargavibhAgaH
shItalamarudanukUle bhANDIradrumamUle
kR^itvA vallavaveshaM pravishantaM danujeshaM
jAnann eva vilAsI svIkR^itavAn khalashAsI
jaitrIkR^itabalapakShaH sudurUhakramadakShaH
shrIdAmapriyakAmaH suraripuvAhitarAmaH
kShapayan pralambakAyaH halinA nirmitamAyaM
daivatapariNutalIlaH suhR^idAnandashIlaH
tatra vidUraM yAtAH surabhIrlaghupadapAtAH
samamanviShyan gopaiH sha~Nkitanijadhanalopai\-
mu~njAvalivikarAle vipine kvachana vishAle
labdhAkhiladhavalAkastu~NgitasukhaparipAkaH
pItabhaya~NkaradAvaH prakaTollasadanubhAvaH
praNatajanotsavakArI tvaM bhANDIravihArI
gokulajanarasasindho jaya jaya durvidhabandho || 8||
dvipadikA chChandaH |
kalitashrIdAmAnaM shrIdAmAnandikelitundilitam |
vande rAmAvarajaM rAmAvaraja~Ngamadyutarum || 19||
\section{9}
atha varShAsharadvihAracharitaM
premollAsanashIlA vallavamallasya vijayate lIlA |
yan mAdhurIM vipa~nchI viri~nchisUnoH prapa~nchayati || 20||
meghasamayapUrtiramitavR^iShTiShu tarukandarachita
nIpakakubhapuShpavalita sAndravipinalabdhalalita
bhaktapariShadiShTavarada hArivibhavadhArisharad
ala~NkR^itabahupakShibharitakAnanakR^itadivyarachita
veshatulitanartakavara chandrakachitachArukavara
gopayuvatidhairyamathanarUpa tadabhinItakathana
lochanaphala venuvalanavalgadadharavaktrakalana
sarvasukR^itavaibhavadharaveNurasitarajyadadhara
veNumadhunAdanaTitakekinivaha meghaghaTita
seva janitamuktayavasadhenunichayachittarabhasa
rUpavilasada~NgavalanamohitasuravR^indalalana
bhillayuvatitoShimasR^iNashampamilitapAdaghusR^iNa
hArihariNayoShidamalanetrasukhadavaktrakamala
dAsyaniratashailarachitasevana pashupAshakhachita
pAhi varuNa madvidhajanamIshvara duravApabhajana || 9||
hArihariNachChandaH
ghanapraNayaghaTTanodghuritaghoShasImantinI
     prapa~nchitajagattrayIshrutiviTa~NkavikrIDite |
sharadvihasitATavIkuharabhUvihArapriye
     ratistvayi tarasvinI mama salIlamunmIlatu || 21||
\section{10}
atha vastraharaNaM
smerAbhiH salile kalindaduhiturmagnAbhirAkandharaM
     skandhanyastasamastapaTTavasano narmoktibha~NgIpaTuH |
nirvyAjaM vrajakanyakAbhirasakR^id bhavyAbhirabhyarthitaH
     pAyAt tu~NgakadambashAkhishikharArUDhastrilokIM hariH || 22||
nijaguNodayollAsalobhitA girisutAvratArambhashobhitAH
pashupakanyakAH sUrajAvane rachitamajjanAH prekShya pAvane
tvaritamAgato lu~nchitAmbaraH priyakamAshrito ra~NgiNAM varaH
sapadi lokayan goShThabAlikA bhrUkuTivallarIbha~NgurAlakAH
smitaparisphuradvaktramaNDalaH sphuTitamAlatIkLLiptakuNDalaH
sarabhasaM tataH shItavepitaiH praNayakopibhiH suShThuhrepitai\-
vadanavisphuratkAkujalpanairvihitasAmabhirbhedakalpanaiH
sichayasa~nchayaM sambhramAkulairjhaTitiyAchitaH kanyakAkulaiH
pR^ithutarAMsayorarpitAMshukaH sitaradollasanma~njulAMshukaH
prakaTitAgrahairbhUpahelibhiH sakhikulAdR^itairjalpakelibhi\-
tarupurastaTe tAstadA balAdachiramAnayan gokulAbalAH
muditamugdhadhIH kelinarmadaH sakalavallavIvR^indasharmadaH
prakaTamambarIbhUtahastakAH savidhamAgatA namramastakAH
sa paTurAtmano vAkyakArikAdhR^itamahotsavaH prekShya dArikAH
salilamajjane vyajya nagnatAM vratavidhervadan suShThu bhagnatAM
shirasi kArayannasya pUrtaye prasabhamAtmane kShemamUrtaye
madhurama~njaliM ma~njulochanaH praNayinImanastApamochanaH
kimapi kanyakAlIbhirAnataH praNayasa~NkulAdAshu mAnataH
sukhabharAdamUratra tarpayan vasanasa~nchayaM tUrNamarpayan
kR^itakumArikAchittadohadaH sakalasundarIpremamohadaH
praNatamaNDalAbhIShTakAmadhuk kamanavallavImallikAmadhuH
tvamakhilesha mAmindirAlaya vrajamahendra he deva pAlaya || 10||
indirA chChandaH |
vidadhAnayApi dhavalaM tava jagadevAdya kIrtichandrikayA |
keshava pashupAlInAM chitraM dviguNIkR^ito rAgaH || 23||
\section{11}
atha yaj~napatnIprasAdaH
paritoShayituM na yAyajUkai\-
     stvamanUchAnajanaishcha nAsi shakyaH |
ratihArya ratiM dadasva vande
     tava govinda sadA padAravindam || 24||
ra~NgatastoShitaj~nAtinA sa~Ngato dhenukArAtinA
karNapAlImilatpallavairveShTitaH sarvato vallavai\-
gopasImantinIkAmukaH kAnanotsa~Ngasa~NgAmukaH
kLLiptavR^indATavImAnanaH prekShitasmeragopAnanaH
saMstuvan bhUruhAM sampadaH shlAghayan vyAjataH shampradaH
svAn sakhIn kuShudbharottApitAn premabhiH prArthanAmApitAn
preShayannadhvare.adUrataH khyApitabrAhmaNakrUrataH
kalpitabrAhmaNAvaj~nayA preShThasa~NkrAmitapraj~nayA
la~NghitakShembabhAksatrayA pUrikApUritAmatrayA
sthAkikAnyasyasadbhaktayA snehasampattito.abhyaktayA
ratnapAtrIdhR^itakShIrayA kAnanopakramAdhIrayA
bhAjananyastasaMyAvayA kautukottu~NgasaMrAvayA
gauravAnnirbharottAlayA prekShito brAhmaNImAlayA
spardhamAnaM ruchA hATakaM dhArayann ujjvalaM shATakaM
sakhuraMse karaM dakShiNaM nyasya lokotrayIrakShiNaM
visphurannartakAla~NkR^itiH sa~ncharatki~NkiNIjha~NkR^itiH
kAntibhirninditendIvaraH sundarorastaTe pIvaraH
sa~ncharanma~njarIkuNDalaH shlAghitabrAhmaNImaNDalaH
kR^iShNa he sundarakuNThayA preirtAstUrNamutkaNThayA
rakSha naH sa~NgatA dUrataH svAntike tvaM yataH sUrataH
kShmAsurIkAkumityagrataH shIlayan vya~njitavyagrataH
sarvathA dattatadvA~nChitaH kIrtivi~nCholikAlA~nChitaH
proShitabrAhmaNIko.amalaH pallavAdapyalaM komalaH
sadguNairindiryAmodanaM bhuktavAn bhojayannodanaM
mattamAta~NgalIlAkaraH ki~NkarAnandishIlAkaraH
sarvadA vibhramArambhavAn khelatAd gokule.alaM bhavAn
santataM dAruNApaddhataM pAhi govinda mAmuddhatam || 11||
mattamAta~NgalIlAkarachChandaH |
duHkhochChittiH paramamadhurAnandapUrAnubhUtiH
     seyaM dAmodara taduchitA sAdhanAnuShThitirvA |
sattAM dhatte na kamalabhuvo.apyantareNArtabandho
     kAruNyaM te muhurahamataH prArthaye tasya bindum || 25||
\section{12}
atha govardhanoddharaNaM
amandamadamaNDaliralamakhaNDamAkhaNDalaM
     nyaruddha rabhasena yaH pR^ithumudasya govardhanam |
achaNDakaramAdhurIpaTaladaNDituNDashriyaM
     tamAttavaramaNDanaM makarakuNDala tvAM bhaje || 26||
hetuvAdajajalpitavrajavAsavAdhvaramardane
bhUsurotkaragomahIdharapUjanotsavavardhane
kalpitAtulayUpasa~Nkulasha~NkulAdadhimodake
parvatArchanasampadarjanahetutAparibodhake
puShpavandanadhAtuchanadanmaNDitAkhilagodhane
gopamaNDalakalpitAchalasAnukandarashodhane
udbhaTAravabhUdharotsavasa~njitAkhilabandhute
tatparikramapUjanakramabhUrisambhramasandhute
kShmAdharopamavigrahottamabhuktasisphuradodane
ma~NgalAkaravisphuradvaravR^indavallavamodane
ruShTavAsavavR^iShTisamplavakhinnagokulaveShTite
trAsasa~NkulabandhumaNDalasharmadAdbhutachesTite
dakShiNetarapANipuShkarashIlatAtulaparvate
vibhramA~NkuranirdhUtoddhurajambhamardanagarvite
gotragahvaravAsitAbbharavihvalAtmasuhR^ijjane
kAritodbhavadadbhUtArNavabAndhavavrajamajjane
nanditAshayamitrasa~nchayavIkShitasphuradAnane
medurasmitakaumudIkR^itaraktayauvatamAnane
bhItananditavismayA~nchita mAtR^ipANyupalAlite
chArucha~nchalalochanA~nchalarAdhayApi nibhAlite
mArutonmadachaNDanIradamaNDalAshanivAraNe
sampadandhitashakrasa~nchitagarvacharvaNakAraNe
saptavAsarahastasaMstarashAyitAtulaparvate
nirmadIkR^itashakrasaMvR^itanIradekShaNanirvR^ite
ma~njubhAShitamudrayA kR^itabAndhavAvaliniShkrame
kautukochchalamitramaNDalagItama~Ngalvikrame
pAdapojjvalatannijasthalayojitapravarAchale
sarvadA vrajabAndhavavrajarakShaNavratanishchale
phullavallavanAthayornavaharShavIkShaNasakShaNe
ku~NkumAkShatapallavAkShatavallavIkR^itarakShaNe
ChannabhAnuni shailasAnuni pIThitapravarAMshuke
bhItalajjitashakravanditapAdapa~NkajapAMshuke
smerasammukhavisphuranmukhaluptavAsavabhIbhrame
tanmanoharavarNanirbharabhAratIbharavibhrame
goshivapradamindratApadametya nirbharanandite
gAyadambaralambitumbururAgaDambaravandite
mugdhasaurabhadigdhasaurabhadugdhapUrakR^itokShaNe
kalpitAkhilapiShTapAtulatApamaNDalamokShaNe
mattakokilavibhrame kila mAdhava tvayi sammukhI
vartatAM mama puruShottama lolabuddhishilImukhI || 12||
mugdhasaurabhachChandaH
shyAmottu~NgabhujArgale vinihitaH kR^iShNena vR^iShTichChaTA
     dhaitairdhAtubhireSha tAlakunaTImukhyairgirirgauritaH |
shuddhAShTApadakalpitasya vipulachChatrasya lakShmIbharaM
     bibhradgAruDaratnanirmitamahAdaNDasya vibhrAjate || 27||
\section{13}
atha nandApaharaNaM
nandApahArachakitasya kirITashR^i~Nga
     bhR^i~NgAvalIparichitaM salileshvarasya |
hR^idyaM sanandanadurApaparAgagandhaM
     vande mukunda tava deva padAravindam || 28||
nIrAdhipabhR^ityAhR^itagopeshvaramArgAshrita
labdhAmbudhinAthAlaya pAshIDitalIlAchaya
shuddhojjvalavANIsudha dAsAyitapAshAyudha
mantuklamasammArjana tannirmitaharShArjana
bhaktyarpitanandekShaNa labdhAtulachittakShaNa
pitrA saha gehaM gatamAtR^iklamahArivrata
sarvAdbhutasandarshanachittAnvitanandAnana
sa~NkarNitalokottaratattannijacharyAbhara
sambhAvitasarveshvarabhAvotsukagopotkara
hR^idye~NgitasaMvedanasa~NkalpitatatsAdhana
divyahradamadhyArpitagodhuggaNasandarshita
sachchinmayalokottama niShkAsitagopabhrama
sandhukShitabandhuvraja sa~nchAritakIrtidhvaja
gopIgaNasharmAkara mAM pAlaya dAmodara || 13||
samphullachChandaH |
loko ramyaH ko.api vR^indATavIto
     nAsti kvApItya~njasA bandhuvargam |
vaikuNThaM yaH suShThu sandarshya bhUyo
     goShThaM ninye pAtu sa tvAM mukundaH || 29||
\section{14}
atha rAsakrIDA
parisphuratu sundaraM charitamatra lakShmIpate\-
     stathA bhuvananandinastadavatAravR^indasya cha |
harerapi chamatkR^itiprakaravardhanaH kintu me
     bibharti hR^idi vismayaM kamapi rAsalIlArasaH || 30||
shAradavidhuvIkShaNamadhuvardhitamadapUra
iShTabhajanavallabhajanachittakamalasUra
gopayuvatimaNDalamatimohanakalagIta
muktasakalakR^ityavikalayauvataparivIta
yoShidamalanetrakamalalobhidashanamAla
kautukabharanirmitakharanarmavachanajAla
tannishamanasAshrunayanabhIrubhiranunIta
vallabhajanakhedashamanavibhramabharavIta
shyAmavimalakAntipaTaladhUtamadanalakSha
raktimadharayoShidadharachumbarachanadakSha
vigrahapadayauvatamadavIkShaNaparilIna
chaNDimadharabhaktanikaramAnabhujagavIna
lolagatibhirArtamatibhirAbhiranabhidR^iShTa
puShpaguruShu vallitaruShu bhUriShu paripR^iShTa
labdhanalinagandhapulinagopyanukR^italIla
shashvadamitara~NgaramitarAdhika varashIla
phullasuShamavanyakusumamaNDitadayitA~Nga
kelitalinavaktranalinabhR^i~NgitatadapA~Nga
nirbhararativardhanamatinihnatanijadeha
premasharaNavallabhagaNamAnasakushaleha
dR^iShTavikalarAdhanikhilayauvataparihUta
bhUriruditatattaduditavIthibhirabhibhUta
viklavatanugopasutanulochanapadavIta
chAruhasana pItavasana ku~NkumabharapIta
nanditamatiyoShayuvativAsasi viniviShTa
tuShTirachanachAruvachanadhUtahR^idayariShTa
sammadachayaphullahR^idayayauvatatatarAsa
kundaradanachAruvadanashobhitamR^iduhAsa
dvidviyuvatimadhyavasativardhitaruchikAmya
labdhalalitabhR^i~NgavalitachampakatatisAmya
svasvasavidhabodhivividhaveshayuvatihR^idya
sha~NkaramukhadaivatasukhavardhinaTanavidya
mohitashashimaNDala vashikhecharamuniyoSha
ki~NkiNiyutanUpurarutalambhitaparitoSha
saurabhapuramiShTakhapurara~njitamadhurAsya
suShThumahitagItasahitayauvatatatalAsya
vishvakaraNadhairyaharaNakAraNakalagAna
raktibhiruparuddhapashupabhIrukalitama
kUjivalayatANDavalayaghUrNitasurarAji
komalaraNaShaTpadagaNagu~njitabharabhAji
tatra rahasi rAsamahasi sambhR^itavarashobha
mauktikashuchisusmitaruchisR^iShTayuvatilobha
mArjitaratikhinnayuvatimaNDalamR^idugaNDa
premalalahakAmakalahapaNDitabhujadaNDa
vibhramaparavalgunakharachihnitanavavAma
sauShThavayutakAntibhiruta kAmamanasikAma
shItasalilakelikalilachittayuvatisikta
dIvyadachirajAtaruchiradIptibhiratirikta
devavichitapuSh puSharachitavR^iShTibhirabhivR^iShTa
premasaralakelitaralagopasutanudR^iShTa
visphuradibhanAyakanibha ma~njulajalakhela
cha~nchalakarapuShkaravarakR^iShTayuvatichela
ratnabhavanasannibhavanaku~njavihitara~Nga
rAganiratayauvataratichihnavilasada~Nga
sandhR^itanaya nandatanaya sundara jaya vIra
yAmunataTamaNDalanaTa rAsarachanadhIra
pApAni mayi durgatijayipAdabhajanalesha
dhehi karuNa dR^iShTimaruNalochana nikhilesha || 14||
lalitabhR^i~NgachChandaH |
rambhorUnikurambanirbharaparIrambheNa labdhadyute\-
     rbibhrANasya taDitkadambavilasatkAdambinIvibhramam |
krIDADambaradhUtajR^imbhamathanastamberamorushriyo
     rAsArambharasArthinastava vibho vande padAmbhoruham || 31||
ullalavallavalalanA dharapallavachumbanollasitam |
naumi samallImAlyaM harimiha hallIsakotphullam || 32||
\section{15}
atha sudarshanAdimochanaM sha~NkhachUDanidhanaM cha
bibhrataM shravaNasImni shAradaM
     padmamujjvalakalAvishAradam |
vallavIhR^idayahAranAyakaM
     hanta chitta bhaja goShThanAyakam || 33||
bhUruhollasadambikAvanamaNDalAntarabhUmipAvanaM
abjasambhavakanyakodakanirmitAplavamakShimodaka
vAridojjvalakAntiDambaramAptakA~nchanabhAsvaradambaraM
AttavallavarADbhuja~NgamamUrtikalpitapAdasa~NgamaM
ugrasa~NkaTabhAksudarshanashApamochanamiShTadarshanaM
AtmavallabhanandamochanamuddhR^itAkhilagopashochanaM
AshrayAmi bhavantamujjvalakAntikandaladhutakajjvalaM
AnitojjvalasharvarImukhamAptapUrvajasa~Ngasa~Ngamunmukha
vallavAkhilavallabhAtulanetrakha~njanavibhramAkulaM
adbhutAmalagItimohitavallavIkulamAttalohita
chandanaM khalayakShanAyakabhItiyauvatashAntidAyakaM
ugravigrahayakShamardanama~NganAgaNara~NgavardhanaM
AptaguhyakaratnananditapUrvajaM bhuvanendravandita
pAdapadma bhavantamAhitagokulotsavama~NganAhita
naumi mAdhava mAM kR^ipAlaya durgataM jagadIsha pAlaya || 15||
kAntiDambarachChandaH |
jayati mahotsavavidyA vidyAdharashApamardinI mUrtiH |
paribhUtasha~NkhachUDachUDAmanNirakhilalokasya || 34||
\section{16}
atha gopikAgItaM
niryAsaH shyAmalimnAM pariNatiramalapremalakShmIbharANAM
     sAkShAtkAraH kR^ipANAmakhilamadhuratAsampadAM sa.npradAyaH |
gAmbhIryaM bibhramANAmupachitiramitashchAturINAM chiraM vo
     bhUyAdAbhIranArIkuchakalasataTAla~NkR^itirma~NgalAya || 35||
divasavirahArtayuvatikR^itavArta
pR^ithulataravAmabhujashikharadhAma
vilasadavataMsa vadanadhR^itavaMsha
suranagarayoShidakhilamatimoShi
madhurataragIta pashunivahavIta
saridudakapUraviratividhishUra
kamalabhavabhargamukhavibudhavarga
matiduranumAnarasadakalagAna
madayadavaloka muShitanatashoka
hR^itaharaNajAta kalitasukhavAta
girishamukhadeva kR^itacharaNaseva
madajanitaghUrNanayana rasapUrNa
gativijitanAga dhR^itaghusR^iNarAga
yuvatidinatApaharamadhuralApa
chaTula naTavesha kR^ipaya mathuresha || 16||
mukhadevachChandaH ||
jagaduddhuramAdhurIdhUrINAM
     adhunA mandiramindirAdurApA |
mama tarShabharAn murAntaka tvan
     muralInAdasudhAdhunI dhunItAm || 36||
\section{17}
athAriShTavadhAdikaM
turagadanusutA~NgagrAvabhede dadhAnaH
     kulishaghaTitataTa~NkoddaNDavisphUrjitAni |
taduruvikaTadaMShTronmR^iShTakeyUramudraH
     prathayatu kushalaM vaH kaishavo vAmabAhuH || 37||
vR^iShadanujajanitarujapashupakulatoShaNaM
svakaratalaninadakhalavR^iShabhapariroShaNaM
dayitavarabhujashikharanihitabhujadaNDakaM
jagadasukhavikaTamukhadanujamadakhaNDakaM
niviDabalachaTulamiladanaDudapanodanaM
gaganatalamiladakhilasuranikaramodanaM
bhujavibhavamahimalavadalitavR^iShashR^i~NgakaM
tadabhihatidalitadititanujatanubhR^i~NgakaM
nijanikaTagativikaTahayadanujalochitaM
praNayabharamR^idulatarayuvatigaNashochitaM
avagaNitagururaNitaturagakhuraghaTTanaM
nijalalitagatikalitatadurumadakuTTanaM
dhanurayutaparigamitahayadanujavigrahaM
pR^ithuvadanabhujaghaTanakR^itatadatinigrahaM
bhujabhujagayutituragaradaharaNakAraNaM
tadupachayavihitahayadanujatanudAraNaM
nijalalitalavadalitajagadavashakeshinaM
pramadakularasachaTulapashapasabhaveshinaM
darahasitaruchiramitanutichaturanAradaM
girishavaranikhilasuranikarasukhabhAradaM
uraNadatichapalamatisuhR^idavanakhelanaM
tadapahR^itimiladamatidanujakR^itamelanaM
svashacharanikaraharadanujakR^itivedinaM
jagadabhayavaladanayamayatanayabhedinaM
sakR^idamalapadakamalavinatabhayamochanaM
bhaja sadayamayi hR^idaya sarasiruhalochanam || 17||
guchChakamidaM ChandaH |
yenAriShTaH prApito.abhUdariShTaM
     chakre keshI lIlayaivAvakeshI |
vyomo.alambhi vyomasAmyaM sa kaShTAd
     goShThAdhIshaH suShThu gopAyatAnnaH || 38||
apavargasukhaspR^ihoruvallI
     sthalakula~NkaShavIchirambujAkSha |
tava kelisudhAnadI madIyaM
     shishirA~NgIgalajA~NgalaM gatAstu || 39||
puruShottamasya parito
     gokulacharitAmR^itena kR^itasekaH |
premamarandasyandaM
     tanotu mama chittamAkandaH || 40||
\section{18}
atha ra~NgasthalakrIDA
kriyAd vaH kalyANaM bhujasamarashauTIryakaNikA
     vikAsenodbhUya prakaTabalamallapratibhaTAn |
bhajan svarI ra~Nge madakalamR^igendrasya lalitaM
     kachAkR^iShTikrIDAmathitamathurArirmadhuripuH || 41||
yaH pauralokAravindAvalIhelira~NgIkR^itottu~Ngara~NgasthalIkeli\-
ApItakausheyashobhollasanmUrtirAvartitAsheShalokotsavasphUrti\-
akShINakaNThIravAkuNThavikrAntirugraM mamardorudantIndramashrAnti
yaM nirmitottu~NgamAta~NganirvANamurvImahAnandavR^indAni kurvANaM
udbhAsidAnAsrabindUrmivarmANamAnamrasantoShanirmANakarmANaM
unmIlitAstokavistAratAruNyamantastamastomavidhvaMsikAruNyaM
AlokayAmAsa bhinnArimarmANamagre janashreNiruddAmasharmANaM
uddaNDadordaNDadarpAnuviddhena vismApitAmandagandharvasiddhena
pInAMsapiNDollasaddantadaNDena vidyetigharmAmbusaMvItagaNDena
dIptendranIlAvalIrAjada~Ngena labdhapralambArigopAlasa~Ngena
mallAvalI yena ra~Ngapraveshena vikShobhitA ma~NkShu vIrendraveshena
mandasmitArabdhakundAlinindAya vR^indArakAnandipAdAravindAya
cha~nchannakhashreNibhAchakrabAlAya vakShastaTIlakShyanakShatramAlAya
phullIbhavachchillichApaprasarpAya nirvAhitApUrvakandarpadarpAya
nAryo muhurdR^iShTamAdhuryacharyAya yasmai spR^ihAM chakrurAbhIravaryAya
yasmAd vilAsena ra~Ngasthale ranturAnamralokAtishokApadAhantu\-
indrAdivR^indArakAnandanirmAturakShNorvinodena vR^iShNyandhakAn pAtu\-
AryA~NganAtIvrasAdhvIvratachChetturavyagramallA~NganAtuShTirnirbettu\-
AvalgataH kShauNibhartApi sa trAsamAsAdya vibhrAntAgrabAlasya
padmAvatIputrahR^inmarmakIlasya sarvAtmanAbhIShTadoryuddhalIlasya
yuddhaM parisphArashauTIryaghorasya chAnUramallena vR^ittaM kishorasya
yasmin munishreNivakrasphurannAmni vistIrNavakShaHsthalIvibhramaddAmni
navyollasadvArivAhAvalIdhAmni niHshesavIrotkarolla~NghanasthAmni
prodyatpadadyotanirdhUtapa~ncheShu saundaryadarpodgame ramyama~ncheShu
tu~NgeShvavasthAya chakrurvilakShANi bhaktiM prabhau bhojadashArhalakShANi
chANUramUrdhanyamallebhapArIndra sa shrIbhavAn pAtu mAM gopanArIndra
savyabhramanmuShTikottADitAlA~Nka nepathyabhArasphuraddhenupAlA~Nka
vidrAvitoddAmadurmallapAlIka niHsha~NkalAsyollasatpAdanAlIka
ramyA~NgahArashriyAkR^iShTasAdhvIka tAbhirnipItA~NgasaurabhyamAdhvIka
gopA~NganAnetrapAnaikabhR^i~NgAra puShpAvalIlabdhasarvA~NgashR^i~NgAra
bho devakIshauribandhArtiluNThAka dikchakravAlakvaNatkIrtighaNTAka
bhaktograsenArpitasphItasaptA~Nga mAM rakSha kubjA~NgarAgeNa liptA~Nga || 18||
bhR^i~NgArachChandaH
mallAnAmulla~Nghya ra~Nge karavichaladasiryena ma~nchaprapa~nche
     kesheShvAkR^iShya kaMso vighaTitamukuTaM vighnaheturnijaghne |
sa tvaM sattvAdhirAja sphuradurukaruNADambarAlambichetAH
     pAtAd duHkhAbdhipAtAd yadukulakamaloddaNDachaNDadyutirmAm || 42||
manasijaphaNijuShTe labdhapAto.asmi duShTe
     timiragahanarUpe hanta saMsArakUpe |
ajita nikhilarakShAhetumuddhAradakShAM
     upanaya mama haste bhaktirajjuM namaste || 43||
samastapuruShArthataH pR^ithutayAdya bhaktiM vidan
     vadannapi na yad bhajet tvadakR^ipAtra heturvibho |
prasIda yamunAtaTe luThitamUrtirabhyarthaye
     kR^ipAM kR^ipaNanAtha he kuru mukunda mande mayi || 44||

iti shrIrUpagosvAmivirachitastavamAlAyAM Chando.aShTAdashakaM samAptam |
\chapter{##Govardhanoddharanam ## .. govardhanoddharaNam ..}
shrIgovardhanoddharaNAya namaH |
jhamajjhamiti varShati stanitachakravikrIDayA
     vimuShTaravimaNDale ghanaghaTAbhirAkhaNDale |
rarakSha dharaNIdharoddhR^itipaTuH kuTumbAni yaH
     sa dArayatu dAruNaM vrajapurandaraste daram || 1||
mahAhetuvAdairvidIrNendrayAgaM
     giribrAhmaNopAstivistIrNarAgam |
sapadyekayuktIkR^itAbhIravargaM
     purodattagovardhanakShmAbhR^idargham || 2||
priyAshaMsinIbhirdalottaMsinIbhi\-
     rvirAjatpaTAbhiH kumArIghaTAbhiH |
stuvadbhiH kumArairapi sphAratAraiH
     saha vyAkirantaM prasUnairdharaM tam || 3||
giristhUladehena bhutkepahAraM
     varashreNisantoShitAbhIradAram |
samuttu~NgashR^i~NgAvalIbaddhachailaM
     kramAt prIyamANaM parikramya shailam || 4||
makhadhvaMsasaMrambhataH svarganAthe
     samantAt kilArabdhagoShThapramAthe |
muhurvarShati chChannadikchakravAle
     sadambholinirghoShamambhodajAle || 5||
muhurvR^iShTikhinnAM paritrAsAbhinnAM
     vrajeshapradhAnAM tatiM vallavAnAm |
vilokyAptashItAM gavAlIM cha bhItAM
     kR^ipAbhiH samunnaM suhR^itpremanunnam || 6||
tataH savyahastena hastIndrakhelaM
     samuddhR^itya govardhanaM sAvahelam |
adabhraM tamabhraMlihaM shailarAjaM
     mudA bibhrataM vibhramajjantubhAjam || 7||
praviShTAsi mAtaH kathaM shokabhAre
     paribhrAjamAne sute mayyudAre |
abhuvan bhavanto vinaShTopasargA
     na chitte vidhatta bhramaM bandhuvargA || 8||
hatA tAvadIirvidheyA na bhItiH
     kR^iteyaM vishAlA mayA shailashAlA |
tadasyAM praharShAdavaj~nAtavarShA
     vihasyAmareshaM kurudhvaM pravesham || 9||
iti svairamAshvAsitairgopavR^indaiH
     parAnandasandIppitAsyAravindaiH |
girergartamAsAdya harmyopamAnaM
     chireNAtihR^iShTaiH pariShTUyamAnam || 10||
girIndraM guruM komale pa~nchashAkhe
     kathaM hanta dhatte sakhA te vishAkhe |
purastAdamuM prekShya hA chintayedaM
     muhurmAmakInaM mano yAti bhedam || 11||
stanadbhiH kaThore ghanairdhvAntaghore
     bhramadvAtamAle hatAshe.atra kAle |
ghanasparshikUTaM vahannannakUTaM
     kathaM syAnna kAntaH sarojAkShi tAntaH || 12||
na tiShThanti goShThe kaThorA~NgadaNDAH
     kiyanto.atra gopAH samantAt prachaNDAH |
shirIShaprasUnAvalIsaukumArye
     dhR^itvA dhUriyaM bhUrirasmin kimArye || 13||
gire tAta govardhana prArthaneyaM
     vapuH sthUlanAlIlaghiShThaM vidheyam |
bhavantaM yathA dhArayann eSha haste
     na dhatte shramaM ma~NgalAtmannamaste || 14||
bhramatkuntalAntaM smitadyotakAntaM
     lasadgaNDashobhaM kR^itAsheShalobham |
sphurannetralAsyaM murArestvamAsyaM
     varAkUTashAli sphuTaM lokayAli || 15||
nipIyeti rAdhAlatAvA~NmarandaM
     varapremasaurabhyapUrAdamandam |
dadhAnaM madaM bhR^i~Ngavattu~NgakUjaM
     varA~NgIchalApA~Ngabha~NgAptapUjam || 16||
kathaM nAma dadhyAt kShudhAkShAmatundaH
     shishurme gariShThaM girIndraM mukundaH |
tadetasya tuNDe haThAdarpayAraM
     vrajAdhIsha dadhnAchitaM khaNDasAram || 17||
mahAbhAraniShThe sR^ite te kaniShThe
     labhe vatsa nIlAmbaroddAmapIDAm |
avaShTabhya sattvaM tadasami bala tvaM
     dadasvAvilambaM svahastAvalambam || 18||
iti snigdhavarNAM samAkarNayantaM
     giraM mAturenAM cha nirvarNayantam |
kaniShThA~NgulIshR^i~NgavinyastagotraM
     pariprINitavyagragopAlagotram || 19||
amIbhiH prabhAvaiH kuto.abhUdakuNThaH
     shishudhUlikelIpaTuH kShIrakaNThaH |
bibhartyadya sAptAbdiko bhUribhAraM
     giriM yachchirAdeSha kailAsasAram || 20||
na sha~NkA dharabhraMshane.asmAkamasmAn
     nakhAgre sahelaM vahatyeSha yasmAt |
giridikkarIndrAgrahaste dharAvad
     bhuje pashyatyAsya sphuratyadya tAvat || 21||
iti sphAratArekShaNairmuktabhogai\-
     rvrajendreNa sArdhaM dhR^itaprItiyogaiH |
muhurvallavairvIkShyamAnAsyachandraM
     puraH saptarAtrAntaratyaktatandram || 22||
taDiddAmakIrNAn samIrairudIrNAn
     visR^iShTAmbudhArAn dhanuryaShTihArAn |
tR^iNIkR^itya ghorAn sahasrAMshuchaurAn
     durantorushabdAn kR^itAvaj~namabdAn || 23||
aha~NkArapa~NkAvalIluptadR^iShTe\-
     rvraje yAvadiShTaM praNItoruvR^iShTeH |
balAreshcha durmAnitAM visphurantaM
     nirAkR^itya duShTAlidaNDe durantam || 24||
visR^iShTorunIrAH sajha~njhAsamIrA\-
     staDidbhiH karAlA yayurmeghamAlAH |
ravishchAmbarAntavibhAtyeSha shAntaH
     kR^itAnandapUrA bahiryAta shUrAH || 25||
iti prochya niHsAritaj~nAtivAraM
     yathApUrvavinyastashailendrabhAram |
dadhikShIralAjA~NkurairbhAvinIbhi\-
     rmudA kIryamANaM yashaHstAvnIbhiH || 26||
vayaM hanta govinda saundaryavantaM
     namaskurmahe sharmahetorbhavantam |
tvayi spaShTaniShThyUta bhUyashchidinduM
     mudA naH prasAdIkuru premabindum || 27||
kShubhyaddambholijR^imbhottaralaghanaghaTArambhagambhIrakarmA
     nistambho jambhavairI giridhR^itichaTulAd vikramAd yena chakre |
tanvA nindantamindIvaradalavalabhInandadindindirAbhAM
     taM govindAdya nandAlayashashivadanAnanda vandemahi tvAm || 28||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIgovardhanoddharaNaM sampUrNam |
\chapter{##Vastraharanam ## .. vastraharaNam ..}
shrIvallavendranandanAya namaH |
vanyAshritA murAriH kanyAH sanyAyamunmadayan |
anyAbhilAShitAM te dhanyArpitasauhR^ido hanyAt || 1||
sahasi vratinIrabhitaH kR^itinIrgirijAstavane salilAplavane
kalitollasanAH kila digvasanAstaTabhAkpaTikA rasalampaTikAH
sphuTabAlyayutAH pashupAlasutAH kutukI kalayan matimullalayann
upagatya manobhavavatkamano hR^itavAn sichayAn suhR^idAM
nichayAntaragaM tarasA priyakaM svarasAdadhiruhya nagaM taTakAnanagaM
kR^ipayA snapayannatha tAstrapayan pR^ithulAM saraTIdhR^itadhautapaTI
paTalo hasitaprabhoyollasitaH shR^iNuta pramadA giramashramadAM
upagatya hitAmabhitaH sahitA yadi vA kramataH sphuTavibhramataH
sichayAnnayata chChalanaM na yataH kathitaM na mayA januShaH samayAd
anR^itaM lalitA yashasojjvalitA vidurinduhR^idastadamI suhR^ida\-
tanavai na hasAduditaM sahasA bata yUyamitA vratataH shramitA
iti sa~Nkathayan paTutAM pratahyannaticha~nchala he visha mA kalahe
vitarAdya paTaM kuru mA kapaTaM karavAma sadA vachanaM rasadA\-
tava dAsyaparA na vayaM tvaparA na hi chet tvaritaM nikhilaM charitaM
khalu rAj~ni tava prabale kitava pragadAma madoddhataghoramado
vachanaM cha ruShA prasaratpuruShAkSharamityuditaM saruShA ruditaM
jaDatAkalile yamunAsalile vilasadvapuShAM gurukampajuShAM
chalachArudR^ishAM bahudhA sudR^ishAM nishamayya tataH praNayI satata
smitachandrikayA sphurito.adhikayA yadi yUyaM R^ite mama vAgamR^ite
bhavatha grahilA niyataM mahilA upasR^itya tataH priyakAt patataH
svapaTIpadakAn svaparichChadakAn urarIkuruta pramadAd guruta\-
tyajatAnuchitaM hR^idi sa~NkuchitaM na hi chennitarAM na paTAn
vitarAmyuruvIryachaye mayi kiM rachayennR^ipatiH paritaH sa ruShA bharitaH
sphuTamityamalaM nigadan kamalaM bhramayann uditaH shashivan muditaH
svakarAmbariNIratha tA hariNInayanAH kalayan svashirashchalayan
bata nagnatayA spR^ihayonnatayA jalamajjanataH kR^itavarjanataH
kapaterjanitA laghutA vanitAstadalaM duritakShataye sphurita
dyutisundarayoryugalaM karayoH shirasi prayatA drutamarpayatA
ruNamityadhunA nijavA~NmadhunA parilabhya madaM hR^idi vibhramadaM
kiratIbhiralaM nayanaM viralaM rachitA~njalIbhiH pramadAvalIbhiH
praNato madhuraH kR^itakAmadhuraH subhaga~NkaraNaM vasanabharaNaM
vihitAnataye lAlanAtataye dadada~NkuritapraNayachChuritaH
parito hR^iShite madanottR^iShite trapayA namite priyasa~Ngamite
navarAgadhare dyutibhAgadhare hasitA~NkurataH sphurite purataH
sthagite rasanAvilasadvasanAkulite pR^ithunA sphuTavepathunA
chaladagrakare pramadAprakare vihiteShTavaraH praNayipravaraH
sutarAM sukhibhirvalitaH sakhibhirbahudhAkhuralIvilasanmuralI
navakAkalikAlibhirutkalikAkulamunnamayan sudR^ishAM ramayan
dhiyamunmadanaH kR^ipayA sadanaprahitapramadaH kalitapramadaH
kusumastavakaM shravaNe navakaM dadhadAbharaNaM jagatAM sharaNaM
jaya keshihara pramaNA vihara tvamatipraNayaM svajane praNayan
mayi durhR^idaye bhagavan vidaye kalayeraruNAdhara he karuNAm || 1||
kusumastavakachChandaH
yasya sphUrtilavA~NkureNa laghunApyantarmunInAM manaH
     spR^iShTaM mokShasukhAd virajyati jhaTityAsvAdyamAnAdapi |
premNastasya mukunda sAhasitayA shaknotu kaH prArthane
     bhUyAj janmani janmani prachayinI kintu spR^ihApyatra me || 2||

iti shrIrUpagosvAmivirachitastavamAlAyAM vastraharaNaM sampUrNam |
\chapter{##Rasakrida ## .. rAsakrIDA ..}
namaH shrIrAsarasikAya |
shAradashashadharavIkShaNahR^iShTaH
     paramavilAsAlibhirabhimR^iShTaH |
vallavaramaNImaNDalabhAvaH
     prollAsakakalamuralIrAvaH || 1||
atha sakalAbhirmadavikalAbhi\-
     rnishi paribhUya svajanAn bhUyaH |
aviruvatIbhirnavayuvatIbhi\-
     rvihitoddeshaH sundaraveshaH || 2||
militamR^igAkShIvA~nChitasAkShI
     kR^itaparihAsaH sphItavilAsaH |
tadamalavANInishitakR^ipANI
     dalitanikAraH kalitavikAraH || 3||
pramadottaralitavallavanArI
     mukhachumbanaparirambhaNakArI |
unnatamanasAM sudR^ishAM mAna
     prekShaNataH kalitAntardhAnaH || 4||
anukR^itacharitaH puline parita\-
     staruShu cha pR^iShTaH kvApi na dR^iShTaH |
yavatichamUbhistvaritamamUbhi\-
     rmuhuranugItaH kutukaparItaH || 5||
kAkibhirAbhiH prArthitasa~NgaH
     prakaTitamUrtirdhR^itaratira~NgaH |
kimapi nigUDharuShA paripR^iShTaH
     kalitottaravidhiralamupaviShTaH || 6||
karuNAshIlaH khaNDitapIlaH
     stavakitalIlaH kuvalayanIlaH |
dhR^itamR^iduhAsaH premavilAsa\-
     statatanuvAsaH kalpitarAsaH || 7||
atha parikalpitamaNDalabandhaH
     kusumasharAsanavibhramakandaH |
yuvatIyugayugasubhagaskandha
     nyastalasadbhujadaNDadvandvaH || 8||
aliparivIte mArutashIte
     varasa~NgIte bhuvanAtIte |
bhUShaNatAradhvaniparisAra
     krAntavanAnte shashiruchikAnte || 9||
madhyagamadhyagamadhupavirAji
     sphuTachampakatativibhramabhAji |
rAse kR^itaruchirantasthAyI
     veNumukhAdharapallavadAyI || 10||
stambhitarAkApatiravikArAn
     api suradArAn madayann ArAt |
kutukAkR^iShTashchiramabhivR^iShTaH
     sapadi vilUnaiH suratarusUnaiH || 11||
atha kalpIkR^itarajanivihArI
     khasthasurAsuravismayakArI |
nijanijanikaTasthitivij~nAna
     pramuditaramaNIkR^itasammAnaH || 12||
nijadR^igbha~NgIkShubhitakura~NgI
     nayanAmaNDalagurukuchasa~NgI |
kelivilolaH prachalanicholaH
     svedajalA~NkurachArukapolaH || 13||
kumudayutAyAM taraNisutAyAM
     salilavinodapravalitamodaH |
yuvatinikAyaprokShitakAyaH
     shithilitamAlaH pulakakarAlaH || 14||
atha vanamAlI varavipinAlI
     ku~njaniketanavIkShaNashAlI |
jayati vihAri nishi maNihArI
     vrajataruNIgaNamAnasahArI || 15||
natajanabandho jaya rasasindho
     vadanollasitashramajalabindo |
tvamakhiladevAvalikR^itasevA
     santatiradhamA vayamiha ke vA || 16||
jaya jaya kuNDalayugaruchimaNDala
     vR^itagaNDasthala damitAkhaNDala |
dhR^itagovardhana gokulavardhana
     dehi ratiM me tvayi muramardana || 17||

iti shrIrUpagosvAmivirachitastavamAlAyAM rAsakrIDA samAptA |
\chapter{##Svayamutprekshitalila ## .. svayamutprekShitalIlA ..}
shrIrAdhAvallabhAya namaH |
shyAmalasauhR^idabaddhA kAmitatatpadasa~NgatiraddhA |
dhairyamasau smaravardhitarAdhA prApa na mandirakarmaNi rAdhA || 1||
taM kamalekShaNamIkShitukAmA sA chChalataH savyamujjhitadhAmA |
yAmunarodhasi chAru charantI dUramavindata sundaradantI || 2||
 (dodhakam)
prApyodArAM parimaladhArAM kaMsArAterudayati vAte |
seyaM dattA dishi dishi yattA dR^iShTiM kamrAmakiradanamrA || 3||
bhR^i~NgIveyaM tamaparimeyaM mugdhA gandhaM hR^idi kR^itabandham |
vyagraprAyA pulakitakAyA premodbhrAntA drutamabhiyAtA || 4||
kR^iShNamavekShya tataH parituShTA puShpagaNAhR^itikaitavajuShTA |
mantharapAdasaroruhapAtA ku~njakuTIrataTImupayAtA || 5||
sA pR^ithuvepathudolitahastA premasamutthitabhAvavihastA |
phullamahIruhamaNDalakAnte tatra puraH prasasAra vanAnte || 6||
 (dodhakameva)
mAdhavastAM tadAlokayan rAdhikAM
     vallavIvargataH sadguNenAdhikAm |
keyamudbAdhate madvanaM rAgata\-
     stUrNAmityullapan phulladhIrAgataH || 7||
bhAlavidyotitasphItagorochanaM
     pArshvataH prekShya taM vibhramallochanam |
sA paTenAvR^itA kaitavAd bhAminI
     vakritabhrUrabhUd dUrabhUgAminI || 8|| (sragviNI)
lIlodbhrAntaM muhuratha nudatI
     netradvandvaM dishi dishi sudatI |
vIkShA~nchakre dalabharAvakaTAM
     mallIvallIM taTabhuvi nikaTAm || 9||
tAmunmIladbhramaravilasitAM
     labdhA puShpairupari kila sitAm |
lInevAbhUd vikasitamadanA
     tasyAH prAnte sarasijavadanA || 10|| (bhramaravilasitA)
a~njasA vyAharat ka~njasArekShaNa\-
     stAmasau sragviNIM dAmasaurabhyabhAk |
mAdhurImudgrian sAdhurItyujjvalAM
     nUtanAnandadAM pUtanAmardanaH || 11||
bha~NgurAn a~NkurAnnirdayaM ChindatI
     vIrudhaH komaoldbhedinIbhirbhindatI |
AH kathaM luNThasi tvaM mR^igA~NkAnane
     puShparAjImasau hanta matkAnane || 12||
sadAtra chinumaH prasUnamajane
     vayaM hi niratAH surAbhibhajane |
na ko.api kurute niShedharachanaM
     kimadya tanuShe pragalbhavachanam || 13||
prasIda kusumaM vichitrya sarasA
     prayAmi sarasIruhAkSha tarasA |
kriyAdya mahatI mamAsti bhavane
     vilambamadhikaM tanuShva na vane || 14|| (jaloddhatagatiH)
niyuktaH kShitIndreNa tenAsmi kAmaM
     vanaM pAlayAmi krameNAbhirAmam |
janaH shIrNamapyuddhared yo dalArdhaM
     harAmyambaraM tasya vittena sArdham || 15||
parij~nAtamadya prasUnAlimetAM
     lunIShe tvamevaM pravAlaiH sametAm |
dhR^itAsau mayA kA~nchanashreNigauri
     praviShTAsi gehaM kathaM puShpachauri || 16|| (bhuja~NgaprayAtam)
sa patiH pishunaH kupito.apishunaH
     sadane mukharA jaratI mukharA |
chaturA guravo bhavitA kuravo
     vyasanaM puruSheshvara kiM kuruShe || 17||
jalajekShaNa he kulajAmabalAM
     na hi duryashasA rachayAdhavalAm |
tarasA viramatkiraNaM taraNiM
     divi pashya tatastyaja me saraNim || 18|| (toTakam)
jAne tava kachapakShaM
     sambhR^itavaramallikAlakSham |
urasi cha ka~nchukarAjaM
     dhruvamarbudhamAdhavIbhAjam || 19||
ehi tava kShaNamAtraM
     vichArayAmi kramAd gAtram |
tattve kila nirNIte
     prayAhi bhavanaM taDitapIte || 20|| (AryA)
na muShA mAdhava rachaya vivAdaM
     vidadhe tava muhurahamabhivAdam |
gokulavasatau svaramiva mUrtaM
     na kimu bhavantaM jAne dhUrtam || 21||
vetti na gopI vR^indArAmaM
     vR^indAvanamapi bhuvi kaH kAmam |
ahamiha tadidaM kitava rasAlaM
     kathamavacheShye na kusumajAlam || 22|| (pajjhaTikA)
nedamatra kalasastani shaMsa
     krodhano nR^ipatireSha nR^ishaMsaH |
tena hanta vidite vanabha~Nge
     yauvataM patati bhItitara~Nge || 23||
tanvi gehagamanavyavasAyaM
     chet karoShi shR^iNu ramyamupAyam |
atra mattabahuShaTpadavIre
     lIlayA pravisha ku~njakuTIre || 24|| (svAgatA)
gokule kulavadhUbhirarchitA
     shIlachandanarasena charchitA |
rAdhAhamadhikAritAmataH
     kiM karoShi maydhUrta kAmataH || 25||
nAkShiNI kShipa kura~Ngi sarvataH
     sAkShiNI bhava sakhIbhiranvitA |
mAdhavaH kila dunoti mAmasau
     sAdhavaH shR^iNuta bhoH shikhistriyaH || 26|| (rathoddhatA)
bhrUlekhAM kimarAlAM tvaM nirmAsi karAlAM
     kiM vA pashyasi vAmaM saMrambhAdabhirAmam |
diShTyA kAnanalolA helotphullakapolA
     vR^ittA tvaM harihaste trAtAnyo bhuvi kaste || 27||
Aruhya drumavATIM mu~nchemAM paripATIM
     gehAntastava sarvaM jAne bhAmini garvam |
nediShThaH kila bhUpaH so.ayaM bhairavarUpa\-
     stasyAgre chala vAme cholImarpaya vAme || 28|| (lolA)
iti vachanakadambaistatra narmAvalambaiH
     skaladamaladukUlAM prollasadbAhumUlAm |
avishadapadabaddhaM  gadgadodgAranaddhaM
     kimapi kimapi jalpaM kalpyantImanalpam || 29||
smitamuditakapolAM nirmitApA~NgadolAM
     varayuvatiShu rAdhAM premapUrAdagAdhAm |
sadanitalatikAntaryo ninAyAtikAntaH
     sa hariralamabhIShTaprApaNaM me kR^iShIShTa || 30|| (mAlinI)

iti shrIrUpagosvAmivirachitastavamAlAyAM svayamutprekShitalIlA samAptA |
\chapter{##Khandita ## .. khaNDitA ..}
namaH shrIvrajanAgarAya |
(bhuja~NgaprayAta ChandaH)
avaj~nAya bharturmahAghoradaNDaM
     gurorbhAShitaM cha vyatikramya chaNDam |
niShedhoddhurAM ki~NkarImAkShipantI
     hare kR^iShNa nAtheti bAlA japantI || 1||
rasanmeghajAle taDidbhiH karAle
     galadvAridhAre durantAndhakAre |
miladbhUridoShe sakhi me pradoShe
     prayANAya lajjAmanAdR^itya sajjA || 2|| (yugmakam)
adUrollasadbhallUkArabdhayuddhAM
     valaddandashUkAvalIbhogaruddhAm |
samandAd dhvanadvAyasArAtibhImAM
     rasotphullamulla~Nghya kAntArasImAm || 3||
pravishyAnavadyaM latAgehamadhyaM
     dhR^itautsukyachakrA nisargAdavakrA |
nakhAgraprasUnaiH sugandhiprasUnaiH
     payaHphenakalpaM vyadhatteha talpam || 4|| (yugmakam)
praNItekShaNeyaM muhuste padavyAM
     dadhAnA mukunda spR^ihAM navyanavyAm |
alabdhaM tatastvAmavetyAtikhinnA
     babhUva prasUneShubANairvibhinnA || 5||
sukaNThI shaTheyaM bhajantI prajalpaM
     muhurbhAvayantI nimeShaM cha kalpam |
chakArAdya ku~nje batAlabdhakAme
     sakhI jAgaraM sambhramAdekikA me || 6||
aho bhAgyamadya prapanno.asi sadya\-
     stvamasminnagAre yadArAn murAre |
sakhIvR^indadR^iShTirdhR^itAnandavR^iShTi\-
     rbabhUvAttara~NgaM vilokya tvada~Ngam || 7||
dukUlasya lakShmIM samantAd vishAlAM
     asau vIkShya pItasya te mallimAlA |
luThantI kuchodbhAsikAshmIrapa~Nke
     nijaM pItama~NgaM chakArAdya sha~Nke || 8||
vikIrNAlakAntaH parishrAntikAnta\-
     stava vyaktatandraH sphuratyAsyachandraH |
kR^itAna~NgayAgaM vibhaktA~NgarAgaM
     nakhA~NkAlipAtraM tathedaM cha gAtram || 9||
sphuradbandhujIvaprasUnAptasa~NgaM
     parispardhamAno vilAsena bhR^i~Ngam |
mudaM kasya bimbAdharastena raktaH
     karotyujjvalAM kajjalenAdya saktaH || 10||
alaM devadivyenaa jAne bhavantaM
     sadA rAdhikAyAmatipremavantam |
alindAt kuru tvaM mamAdhiprabhAtaM
     drutaM gopakanyAbhuja~Nga prayAtam || 11||
iti premagarbhAM samAkarNya sarvAM
     tadA rAdhikAlIgiraM ratnamAlI |
haristoShabhAraM sa vindannapAraM
     sadA me mahiShThaM vidhattAmabhIShTam || 12||

iti shrIrUpagosvAmivirachitastavamAlAyAM khaNDitA samAptA |
\chapter{##Shri Lalitoktatotakashtakam ## .. shrIlalitoktatoTakAShTakam ..}
nayaneritamAnasabhUvishikhaH
     shirasi prachalaprachalAkashikhaH |
muralIdhvanibhiH surabhIstvarayan
     pashupIvirahavyasanaM tirayan || 1||
parito jananIparitoShakaraH
     sakhi lampaTayannakhilaM bhuvanam |
taruNIhR^idayaM karuNI vidadhat
     taralaM sarale karalambiguNaH || 2||
divasoparame paramollasitaH
     kalashastani he vilasaddhasitaH |
atasIkusumaM vihasanmahasA
     hariNIkulamAkulayan sahasA || 3||
praNayipravaNaH subhagashravaNa
     prachalanmakaraH sasakhiprakaraH |
madayannamarIrbhramayan bhramarI
     militaH katibhiH shikhinAM tAtabhiH || 4||
ayamujjvalayan vrajabhUsaraNIM
     ramayan kramaNairmR^idubhirdharaNIm |
ajire militaH kalitapramade
     harirudvijase tadapi pramade || 5||
vada mA paruShaM hR^idaye na ruShaM
     rachaya tvamatashchala vibhramataH |
udite mihikAkiraNe na hi kA
     rabhasAdayi taM bhajate dayitam || 6||
kalaya tvarayA vilasatsichayaH
     prasaratyabhito yuvatInichayaH |
nidadhAti harirnayanaM saraNau
     tava vikShipa sapraNayaM charaNau || 7||
iti tAmupadishya tadA svasakhIM
     lalitA kila mAnitayA vimukhIm |
anayat prasabhAdiva yaM javataH
     kurutAt sa harirbhavikaM bhavataH || 8||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIlalitoktatoTakAShTakaM sampUrNam |
\chapter{##Chitrakavitvani ## .. chitrakavitvAni ..}
tatra dvyakSharANi \-
rasAsArasusArorurasurAriH sasAra saH |
saMsArAsirasau rAse suriraMsuH sasArasaH || 1||
charchorurochiruchchorA ruchiro.araM charAchare |
chaurAchAro.achirAchchIraM ruchA chArurachUchurat || 2||
dhare dharAdharadharaM dhArAdharadhurArudham |
dhIradhIrArarAdhAdhirodhaM rAdhA dhurandharam || 3||
ekAkSharam \-
ninunnAnenonanaM nUnaM nAnUnonnAnanano.anunIH |
nAnenAnAM ninunnenaM nAnaunnAnAnano nanu || 4||
chakrabandhaH \-
gandhAkR^iShTagurUnmadAlini vane hAraprabhAtiplutaM
     sampuShNantamupaskR^itAdhvani yamIvIchishriyo ra~njakam |
sadyastu~NgitavibhramaM sunibhR^ite shItAnilaiH saukhyade
     devaM nAgabhujaM sadA rasamayaM taM naumi ka~nchin mude || 5||
sarpabandhaH \-
rAse sAra~Ngasa~NghAchitanavanalinaprAyavakShaHsthadAmA
     barhAla~NkArahArasphuradamalamahArAgachitre jayAya |
gopAlo dAsavIthIlalitahitaravasphArahAsaH sthirAtmA
     navyo.ajasraM kShaNopAshritavitatabalo vIkShya ra~NgaM babhAShe || 6||
padmabandhaH \-
kalavAkya sadAloka kalodAra milAvaka |
kavalAdyAdbhutAnUka kanUtAbhIrabAlaka || 7||
pratilomyAnulomyasamam \-
tAyisAradharAdhArAtibhAShAtamadArihA |
hAridAmatayA bhAti rAdhArAdharasAyitA || 8||
gomUtrikAbandhaH \-
sA mallara~Nge ramayA phullasArA muderdhitA |
shramanIradharA tuShTA vallavIrAsadevatA || 9||
murajabandhaH \-
shubhAsArasasArashrIH prabhAsAndramasArabhA |
bhArasA mahasAvitta tarasA rasasAritAm || 10||
sarvatobhadraH \-
rAsAvahA hAvasArA sA lalAsa salAlasA |
balAramA mAralAvahAsamAdadamAsahA || 11||
bR^ihatpadmabandhaH \-
tAraprasphAratAlaM sarabhasarasalaM bhAsurAsyaM subhAlaM
     pApaghnaM gopapAlaM karaNaharakalaM nIrabhR^idvAranIlam |
chArugrIvaM ruchAlaM ratamadataralaM chetasA pItachelaM
     shItaprasphItashIlaM varaya varabalaM vAsudevaM subAlam || 12||

iti shrIrUpagosvAmivirachitastavamAlAyAM chitrakavitvAni samAptA |
\chapter{##Gitavali ## .. gItAvalI ..}
prathamaM nandotsavAdi
shrIrAdhAkR^iShNau jayataH
\section{1}
bhairavarAgeNa gIyate |
putramudAramasUta yashodA |
samajani vallavatatiratimodA || dhruvam ||
ko.apyapanayati vividhamupahAram |
nR^ityati ko.api jano bahubAram ||
ko.api madhuramupagAyati gItam |
vikirati ko.api sadadhi navanItam ||
ko.api tanoti manorathapUrtim |
pashyati ko.api sanAtanamUrtim || 1||
\section{2}
AsAvarI |
vipravR^indamabhUdala~NkR^itigodhanairapi pUrNam |
gAyanAn api madvidhAn vrajanAtha toShaya tUrNam ||
sUnuradbhutasundaro.ajani nandarAja tavAyam |
dehi goShThajanAya vA~nChitamutsavochitadAyam || dhruvam ||
tAvakAtmajavIkShaNakShaNanandi madvidhachittam |
yanna kairapi labdhamarthibhiretadichChati vittam ||
shrIsanAtanachittamAnasakelinIlamarAle |
mAdR^ishAM ratiratra tiShThatu sarvadA tava bAle || 2||
\section{3}
vasantapa~nchamI
vasantarAgaH
abhinavakuTmalaguchChasamujjvalaku~nchitakuntalabhAra |
praNayijaneritavandanasahakR^itachUrNitavanaghanasAra ||
jaya jaya sundara nandakumAra |
saurabhasa~NkaTavR^indAvanavihitavasantavihAra || dhruva ||
adharavirAjitamandatarasmitalobhitanijaparivAra |
chaTuladR^iga~nchalarachitarasochchalarAdhAmadanavikAra ||
bhuvanavimohanama~njulanartanagativalgitamaNihAra |
nijavallabhajanasuhR^itsanAtanachittaviharadavatAra || 3||
\section{4}
dolotsavaH
vasantarAgaH
kelirasamAdhurI  tatibhiratimedurI
     kR^itanikhilabandhupashupAlam |
hR^idi vidhR^itachandanaM    sphuradaruNavandanaM
     deharuchinirjitatamAlam ||
     sundari mAdhavamavakalayAlam |
mitrakaralolayA    ratnamayadolayA
     chalitavapuratichapalamAlam || dhruva ||
vrajahariNalochanA    rachitagorochanA
     tilakaruchiruchiratarabhAlam |
smitajanitalobhayA    vadanashashishobhayA
     vibhramitanavayuvatijAlam ||
narmamayapaNDitaM    puShpakulamaNDitaM
     ramaNamiha vakShasi vishAlam |
praNatabhayashAtanaM     priyamadhi sanAtanaM
     goShThajanamAnasamarAlam || 4||
\section{5}
AsAvarI
nipatati parito vandanapAlI |
taM dolayati mudA suhR^idAlI ||
vilasati dolopari vanamAlI |
taralasaroruhashirasi yathAlI || dhruva ||
janayati gopIjanakaratAlI |
kApi puro nR^ityati pashupAlI ||
ayamAraNyakamaNDanashAlI |
jayati sanAtanarasaparipAlI || 5||
\section{6}
dhanAshrIH
na kuru kadarthanamatra saraNyAm |
mAmavalokya satImasharaNyAm ||
cha~nchala mu~ncha paTA~nchalabhAgam |
karavANyadhunA bhAskarayAgam || dhruva ||
na rachaya gokulavIra vilambam |
vidadhe vidhumukha vinatikadambam ||
rahasi bibhemi viloladR^igantam |
vIkShya sanAtana deva bhavantam || 6||
\section{7}
sauraShTrI
rAdhe nigada nijaM gadamUlam |
udayati tanumanu kimiti tApakulamanukR^itavikaTakukUlam || dhruva ||
prachurapurandaragopavinindakakAntipaTalamanukUlam |
kShipasi vidUre mR^idulaM muhurapi sambhR^itamurasi dukUlam ||
abhinandasi na hi chandrarajobharavAsitamapi tAmbUlam |
idamapi vikirasi varachampakakR^itamanupamadAma sachUlam ||
bhajadanavasthitimakhilapade sakhi sapadi viDambitatUlam |
kalitasanAtanakautukamapi tava hR^idayaM sphurati sashUlam || 7||
\section{8}
sauraShTrI
kuTilaM mAmavalokya navAmbujamupari chuchumba sa ra~NgI |
tena haThAdahamabhavaM vepathumaNDalasa~nchalada~NgI ||
bhAmini pR^ichCha na vAraM vAram |
hanta vimuhyati vIkShya mano mama vallavarAjakumAram || dhruva ||
dADimalatikAmanu nistalaphalanamitAM sa dadhe hastam |
tadanubhavAn mama dharmojjvalamapi dhairyadhanaM gatamastam ||
adashadashokalatApallavamayamatanusanAtananarmA |
tadahamavekShya babhUva chiraM bata vismR^itakAyikakarmA || 8||
\section{9}
dhanAshrIH
anadhigatAkasmikagadakAraNamarpitamantrauShadhinikurambam |
avirataruditavilohitalochanamanushochati tAmakhilakuTumbam ||
deva hare bhava kAruNyashAlI |
sA tava nishitakaTAkShasharAhatahR^idayA jIvati kR^ishatanUrAlI || dhruva ||
hR^idi valadaviralasa~njvarapaTalIsphuTadujjvalamauktikasamudAyA |
shItalabhUtalanishchalatanuriyamavasIdati sa.nprati nirupAyA ||
goShThajanAbhayasatramahAvratadIkShita bhavato mAdhava bAlA |
kathamarhati tAM hanta sanAtana viShamadashAM guNavR^indavishAlA || 9||
\section{10}
AsAvarI
hanta na kimu mantharayasi santatamabhijalpam |
dantarochirantarayati santamasamanalpam ||
rAdhe pathi mu~ncha bhuri sambhramamabhisAre |
chAraya charaNAmburuhe dhIraM sukumAre || dhruva ||
santanu ghanavarNamatulakuntalanichayAntam |
dhvAntaM tava jIvatu nakhakAntibhirabhishAntam ||
sasanAtanamAnasAdya yAntI gatasha~Nkam |
a~NgIkuru ma~njuku~njavasateralama~Nkam || 10||
\section{11}
gauDI
sichayamuda~nchaya hR^idayAdalpam |
vilikhAmyadbhutamakarAkalpam ||
iha na hi sa~Nkucha pa~Nkajanayane |
veshaM tava karavai ratishayane || dhruva ||
rAdhe dolaya na kila kapolam |
chitraM rachayAmyahamavilolam ||
tava vapuradya sanAtanashobham |
janayati hR^idi mama ka~nchana lobham || 11||
\section{12}
AsAvarI
tava cha~nchalamatirayamaghahantA |
ahamuttamadhR^itidigdhadigantA ||
dUti vidUraya komalakathanam |
punarabhidhAsye na hi madhumathanam || dhruva ||
shaThacharito.ayaM tava vanamAlI |
mR^iduhR^idayAhaM nijakulapAlI ||
tava harireSha nira~NkushanarmA |
ahamanubaddhasanAtanadharmA || 12||
\section{13}
bhairavaH
maNDitahallIsakamaNDalAM
naTayan rAdhAM chalakuNDalAm ||
nikhilakalAsampadi parichayI |
priyasakhi pashya naTati murajayI || dhruva ||
muhurAndolita ratnavalayam |
salayaM chalayan karakishalayam ||
gatibha~NgibhiravashIkR^itashashI |
sthagitasanAtanasha~NkaravashI || 13||
\section{14}
bhairavaH
dAmodararativardhanaveshe
     hariniShkuTavR^indAvipineshe |
rAdhe jaya jaya mAdhavadayite
     gokulataruNImaNDalamahite || dhruva ||
vR^iShabhAnudadhinavashashilekhe
     lalitAsakhi guNaramitavishAkhe |
karuNAM kuru mayi karuNAbharite |
     sanakasanAtanavarNitacharite || 14||
\section{15}
dhanAshrIH |
rAjapurAd gokulamupayAtam |
pramadonmAditajananItAtam ||
svapne sakhi punaradya mukundam |
AlokayamavataMsitakundam || dhruva ||
paramamahotsavaghurNitaghoSham |
nayane~NgitakR^itamatparitoSham ||
navagu~njAvalikR^itaparabhAgam |
prabalasanAtanasuhR^idanurAgam || 15||
\section{16}
saurAShTrI
pulakamupaiti bhayAn mama gAtram |
hasasi tathApi madAdatimAtram ||
vAraya tUrNamimaM sakhi kR^iShNam |
anuchitakarmaNi nirmitatR^iShNam || dhruva ||
jAne bhavatImeva vipakShAm |
mAmupanItA yad vanakakShAm ||
adya sanAtanamatisukhahetum |
na parihariShye vidhikR^itasetum || 16||
atha rAsaH
\section{17}
dhanAshrIH
komalashashikararamyavanAntaranirmitagItavilAsa |
tUrNasamAgatavallavayauvatavIkShaNakR^itaparihAsa ||
jaya jaya bhAnusutAtaTara~NgamahAnaTa sundara nandakumAra |
sharada~NgIkR^itadivyarasAvR^ita ma~NgalarAsavihAra || dhruva ||
gopIchumbita rAgakarambita mAnavilokanalIna |
guNavargonnatarAdhAsa~NgatasauhR^idasampadadhIna ||
tadvachanAmR^itapAnamadAhR^ita valayIkR^itaparivAra |
surataruNIgaNamativikShobhaNa khelanavalgitahAra ||
ambuvigAhanananditanijajana maNDitayamunAtIra |
sukhasaMvidghana pUrNasanAtana nirmalanIlasharIra || 17||
\section{18}
dhanAshrIH
shuddhasatIvratavittA ahamatinirmalachittA |
prathayasi sujanavimuktaM narmedaM kimayuktam ||
mAdhava parihara me paTametam |
yAmi javena niketam || dhruva ||
yadi jAnAmyadhitIraM tvAmatigUDhasharIram |
dUre sUrasutAyAM sAyaM kathamupayAyAm ||
vidadhe bhavadavanAmaM charitaM parihara vAmam |
vartma sanAtanamuchitaM pAlaya dhArmikaruchitam || 18||
\section{19}
karNATaH
kiM vitanoShi mudhA~NgavibhUShaNakapaTenAtra vighAtam |
soDhumahaM samayasya na sa.nprati shaktA lavamapi pAtam ||
gokulama~NgalavaMshI
dhvanirudgarjati vanagataye smarabhUpatishAsanashaMsI || dhruva ||
mAdhavacharaNA~NguShThanakhadyutirayamudayati himadhAmA |
mA gurujanabhayamudgira muhuriyamabhavaM dhAvitakAmA ||
taM sevitumiha pashya sanAtanaparamAraNyajavesham |
gopavadhUtatiriyamupasarpati bhAnusutAtaTadesham || 19||
\section{20}
karNATaH
sphuradindIvaranindikalevara
     rAdhAkuchaku~Nkumabhara pi~njara |
sundarachandrakachUDa manohara
     chandrAvalimAnasashukapa~njara ||
     jaya jaya jaya gu~njAvalimaNDita |
praNayavishR^i~NkhalagopImaNDalavara
     bimbAdharakhaNDanapaNDita || dhruva ||
mR^igavanitAnanatR^iNavisraMsana
     karmadhurandharamuralIkUjita |
svArasikasmitasuShamonmAdita
     siddhasatInayanA~nchalapUjita ||
tAmbUlollasadAnanasArasa
     jAmbUnadaruchivisphuradambara |
harakamalAsanasanakasanAtana
     dhR^itividhvaMsanalIlADambara || 20||
\section{21}
kedAraH
saurabhasevitapuShpavinirmita
     nirmalavanamAlAparimaNDita |
madnatarasmitakAntikarambita
     vadanAmbujanavavibhramapaNDita ||
     jaya jaya marakatakandalasundara |
varachAmIkarapItAmbaradhara
     vR^indAvanajanavR^indapurandara || dhruva ||
navagu~njAphalarAjibhirujjvala
     kekishikhaNDakashekharama~njula |
guNavargAtulagopavadhUkula
     chittashilImukhapuShpitava~njula ||
kalamuralIkvaNapUravichakShaNa
     pashupAlAdhipahR^idayAnandana |
girishasanAtanasanakasanandana
     nAradakamalAsanakR^itavandana || 21||
\section{22}
gauDI
yAmunajalakaNikAbhirupete |
sa~Ngatamujjvalaku~njanikete ||
tvayi vinihitavarasauhR^idabhAram |
vihitAparataruNIparihAram ||
bhaja sakhi vallavarAjakumAram |
kAmitatAvakasa~NgavihAram || dhruva ||
navagu~njAphalama~njulahAram |
mAlyavihArimadhupaparivAram ||
nirmalanarmavibhAvanashIlam |
vallavamatra sanAtanalIlam ||
\section{23}
mallAraH
taruNIlochanatApavimochana
     hAsasudhA~NkuradhArI |
mandamaruchchalapi~nChakR^itojjvala
     maulirudAravihArI ||
     sundari pashya milati vanamAlI |
divase pariNatimupagachChati sati
     navanavavibhramashAlI || dhruva ||
dhenukhuroddhutareNuparipluta
     phullasaroruhadAmA |
achiravikasvaralasadindIvara
     maNDalasundaradhAmA ||
kalamuralIrutikR^itatAvakarati\-
     ratra dR^igantatara~NgI |
chArusanAtanatanuranura~njana
     kArisuhR^idgaNasa~NgI || 23||
\section{24}
dhanAshrIH
yadyapi samAdhiShu vidhirapi pashyati
     na tava nakhAgramarIchim |
idamichChAmi nishamya tavAchyuta
     tadapi kR^ipAdbhutavIchim ||
     deva bhavantaM vande |
manmAnasamadhukaramarpaya nija
     padapa~Nkajamakarande || dhruva ||
bhaktiruda~nchati yadyapi mAdhava
     na tvayi mama tilamAtrI |
parameshvaratA tadapi tavAdhika
     durghaTaghaTanavidhAtrI ||
ayamavilolatayAdya sanAtana
     kalitAdbhutarasabhAram |
nivasatu nityamihAmR^itanindini
     vindanmadhurimasAram || 24||
atha nAyikAbhedAH
athAbhisArikA vAsasajjApyutkaNThitA tathA |
vipralabdhA khaNDitA cha kalahAntaritA parA ||
proShitapreyasI proktA tathA svAdhInabhartR^ikA |
ityaShTau nAyikAbhedA rasatantre prakIrtitAH ||
tatrAbhisArikA
yA paryutsukachittAtimadena madanena cha |
AtmanAbhisaret kAntaM sA bhavedabhisArikA ||
\section{25}
dhanAshrIH
tvaM kuchavalgitamauktikamAlA |
smitasAndrIkR^itashashikarajAlA ||
harimabhisara sundari sitaveshA |
rAkArajanirajani gurureShA || dhruva ||
parihitamAhiShadadhiruchisichayA |
vapurarpitaghanachandananichayA ||
karNakarambitakairavahAsA |
kalitasanAtanasa~NgavilAsA || 25||
atha vAsakasajjA
bhaved vAsakasajjAsau sajjitA~NgaratAlayA |
nishchityAgamanaM bharturdvArekShaNaparAyaNA ||
\section{26}
kalyANaH
kusumAvalibhirupaskuru talpam |
mAlyaM chAmalamaNisarakalpam ||
priyasakhi keliparichChadapu~njam |
upakalpaya satvaramadhiku~njam || dhruva ||
maNisampuTamupanaya tAmbUlam |
shayanA~nchalamapi pItadukUlam ||
viddhi samAgatamapratibandham |
mAdhavamAshu sanAtanasandham || 25||
athotkaNThitA
sA syAdutkaNThitA yasyA vAsaM naiti drutaM priyaH |
tasyAnagamane hetuM chintayantyA shuchA bhR^isham ||
\section{27}
AsAvarI
kimu chandrAvaliranayagabhIrA |
nyaruNadamuM rativIramadhIrA ||
atichiramajani rajaniratikAlI |
sa~Ngamavindata na hi vanamAlI || dhruva ||
kimiha jane dhR^itapa~NkavipAke |
vismR^itirasya babhUva varAke ||
kimuta sanAtanatanuralaghiShTham |
raNamArabhata surAribhiriShTam || 27||
atha vipralabdhA
yasyA dUtIM svayaM preShya samaye nAgataH priyaH |
shochantI taM vinA duHsthA vipralabdhA tu sA smR^itA ||
\section{28}
gauDI
komalakusumAvalIkR^itachayanam |
apasAraya ratilIlAshayanam ||
shrIhariNAdya na lebhe shamaye |
hanta janaM sakhi sharaNaM kamaye || dhruva ||
nidhR^itamanoharagandhavilAsam |
kShipa yAmunataTabhuvi paTavAsam ||
labdhamavehi nishAntimayAmam |
mu~ncha sanAtanasa~NgatikAmam || 28||
atha khaNDitA
anyayA saha kAntasya dR^iShTe sambhogalakShaNe |
IrShyAkaShAyitAtmAsau khaNDitA khalu kathyate ||
\section{29}
rAmakeliH
hR^idayAntaramadhishAyitam | ramaya janaM nijadayitam ||
kiM phalamaparAdhikayA | sa.nprati tava rAdhikayA ||
mAdhava parihara paTimatara~Ngam |
vetti na kA tava ra~Ngam || dhruva ||
AghUrNati tava nayanam | yAhi ghaTIM bhaja shayanam ||
anulepaM rachayAlam | nashyatu nakhapadajAlam ||
tvAmiha vilasati bAlA | mukharasakhInAM mAlA ||
deva sanAtana vande | na kuru vilambamAlinde || 29||
\section{30}
yAM sevitavAn asi jAgarI |
tvAmajayat sA nishi nAgarI ||
kapaTamidaM tava vindati hare |
nAvasaraM punarAlinikare || dhruva ||
mA kuru shapathaM gokulapate |
vetti chiraM kA charitaM na te ||
muktasanAtanasauhR^idabhare |
na punarahaM tvayi rasamAhare || 30||
atha kalahAntaritA
nirasto manyunA kAnto namannapi yayA puraH |
sAnutApayutA dInA kalahAntaritA bhavet ||
\section{31}
lalitaH
nAkarNayamatisuhR^idupadesham |
mAdhavachATupaTalamapi lesham ||
sIdati sakhi mama hR^idayamadhIram |
yadabhajamiha na hi gokulavIram || dhruva ||
nAlokayamarpitamuruhAram |
praNamantaM cha dayitamanuvAram ||
hanta sanAtanaguNamabhiyAntam |
kimadhArayamahamurasi na kAntam || 31||
atha virahiNI proShitapreyasI
kutashchit kAraNAd yasyA vidUrastho bhavet patiH |
tadanAgamaduHkhArtA sA syAt proShitabhartR^ikA ||
\section{32}
gauDI
kurvati kila kokilakule ujjvalakalanAdam |
jaiminiriti jaiminriti jalpati saviShAdam ||
mAdhava ghore viyogatamasi nipapAta rAdhA |
vidhuramalinamUrtiradhikamadhirUDhabAdhA || dhruva ||
nIlanalinamAlyamahaha vIkShya pulakavItA |
garuDa garuDa garuDetyabhirauti paramabhItA ||
lambhitamR^iganAbhimagurukardamamanu dInA |
dhyAyati shitikaNThamapi sanAtanamanulInA || 32||
atha svAdhInabhartR^ikA
yasyAH premaguNAkR^iShTaH priyaH pArshvaM na mu~nchati |
vichitrasambhramAsaktA sA syAt svAdhInabhartR^ikA ||
\section{33}
mallAraH
patrAvalimiha mama hR^idi gaure |
mR^igamadabindubhirarpaya shaure ||
shyAmala sundara vividhavisheSham |
virachaya vapuShi mamojjvalavesham || dhruva ||
pi~nChamukuTa mama pi~nChanikAsham |
varamavataMsaya kuntalapAsham ||
atra sanAtana shilpalava~Ngam |
shrutiyugale mama lambhaya sa~Ngam || 33||
\section{34}
vasantarAgaH
kimayaM rachayati nayanatara~Ngam |
kairavinI na hi bhajati pata~Ngam ||
vAraya mAdhavamudyadana~Ngam |
spR^ishati yathAyaM na sakhi mada~Ngam || dhruva ||
kampikarAn mama patati lava~Ngam |
tvamapi tathApi na mu~nchasi ra~Ngam ||
kamapi sanAtanadharmamabha~Ngam |
na parihariShye hR^idi kR^itasa~Ngam || 34||
\section{35}
bhairavarAgaH
apaghanaghaTitaghusR^iNaghanasAra |
pi~nChakhachitaku~nchitakachabhAra ||
jaya jaya vallavarAjakumAra |
rAdhAvakShasi harimaNihAra || dhruva ||
rAdhAdhR^itiharamuralItAra |
nayanA~nchalakR^itamadanavikAra ||
rasara~njitarAdhAparivAra |
kalitasanAtanachittavihAra || 35||
\section{36}
karNATarAgaH, ekatAlI tAlaH
sundari sAdhvI tvamiha kishorI |
tat kathamasi vada goShThapurandaranandana hR^inmaNichaurI ||
na hi sa~Ngopaya paradhanamadhunA tvaM viditA kulapAlI |
lalitAsakhi kuru karuNAM sIdati kandarabhuvi vanamAlI ||
ayi ramaNImaNi ramaNIyaM maNimarpaya punarAvalambam |
bahvatu nirAkulamatikR^ipayA tava hariparijananikurambam ||
dUtIyugamidamavanamati svayamavaniluThitakachajuTam |
tanvi sanAtanasauhR^idamanusara vistAraya na hi kUTam || 36||
\section{37}
mallArarAgaH, ekatAlI tAlaH
rAdhe kalaya hR^idayamanukUlam |
dalati dR^iga~nchalasharahatahR^it tava gokulajIvitamUlam || dhruva ||
shIlitapa~nchamagItiradakShiNapANisaroruhahaMsI |
tanute sAmpratamasya munivratamaratibharAdiva vaMshI ||
bhramadindindiravR^indavikarShaNaparimalapaTalavishAlA |
patitA kaNThataTAdabhishuShyati tasya vane vanamAlA ||
adaye dadhatI tanurapi tanutAM tasya samujjhitalIlA |
shIryati kandaradhAmni sanAtanahR^idayAnandanashIlA || 37||
\section{38}
vasantarAgaH
madhuripuradya vasante |
khelati gokulayuvatibhirujjvalapuShpasugandhadigante || dhruva ||
premakarambitarAdhAchumbitamukhavidhurutsavashAlI |
dhR^itachandrAvalichArukarA~Nguliriha navachampakamAlI ||
navashashirekhAlikhitAvashAkhAtanuratha lalitAsa~NgI |
shyAmalayAshritabAhuruda~nchitapadmAvibhramara~NgI ||
bhadrAlambitashaivyodIritaraktarajobharadhArI |
pashya sanAtanamUrtirayaM ghanavR^indAvanaruchikArI || 38||
 (39]
@1
vasantarAgaH
R^iturAjArpitatoShara~Ngam |
rAdhe bhaja vR^indAvanaMra~Ngam || dhruva ||
malayAnilagurushikShitalAsyA |
naTati latAtatirujjvalahAsyA ||
pikatatiriha vAdayati mR^ida~Ngam |
pashyati tarukulama~Nkurada~Ngam ||
gAyati bhR^i~NgaghaTAdbhutashIlA |
mama vaMshIva sanAtanalIlA || 39||
\section{40}
vasantarAgaH
viharati saha rAdhikayA ra~NgI |
madhumadhure vR^indAvanarodhasi haririha harShatara~NgI || dhruva ||
vikirati yantreritamaghavairiNi rAdhA ku~Nkumapa~Nkam |
dayitAmayamapi si~nchati mR^igamadarasarAshibhiravisha~Nkam ||
kShipati mitho yuvamithunamidaM navamaruNataraM paTavAsam |
jitamiti jitamiti muhurapi jalpati kalpayadatanuvilAsam ||
subalo raNayati ghanakaratAlI jitavAn iti vanamAlI |
lalitA vadati sanAtanavallabhamajayat pashya mamAlI || 40||
\section{41}
dhanAshrIH
rAdhA sakhi jalakeliShu nipuNA |
khelati nijakuNDe madhuripuNA || dhruva ||
kuchapaTaluNThananirmitakalinA |
AyudhapadavIyojitanalinA ||
dR^iDhaparirambhaNachumbanahaThinA |
himajalasechanakarmaNi kaThinA ||
sukhabharashithilasanAtanamahasA |
dayitaparAjayalakShaNasahasA ||
\section{42}
dhanAshrIH
rAdhe nijakuNDapayasi tu~NgIkuru ra~Ngam |
kiM cha si~ncha pi~nChamukuTama~NgIkR^itabha~Ngam || dhruva ||
asya pashya phullakusumarachitojjvalachUDA |
bhItibhiratinIlaniviDakuntalamanu gUDhA ||
dhAturachitachitravIthirambhasi parilInA |
mAlApyatishithilavR^ittirajani bhR^i~NgahInA ||
shrIsanAtanasumaNiratnamaMshubhirapi chaNDam |
bheje pratibimbabhAvadambhI tava gaNDam || 42||

iti shrIrUpagosvAmivirachitastavamAlAyAM gItAvalI samAptA |
\chapter{##Shri Lalitashtakam ## .. shrIlalitAShTakam ..}
shrIlalitApraNAmastotram
shrIlalitAya namaH |
rAdhAmukunda padasambhavagharmabindu
     nirma~nChanopakaraNIkR^ita dehalakShAm |
uttu~NgasauhR^idavisheShavashAt pragalbhAM
     devIM guNaiH sulalitAM lalitAM namAmi || 1||
rAkAsudhAkiraNamaNDalakAntidaNDi
     vaktrashriyaM chakitachArU chamUrunetrAm |
rAdhAprasAdhanavidhAnakalAprasiddhAM
     devIM guNaiH sulalitAM lalitAM namAmi || 2||
lAsyollasadbhujagashatrupatatrachitra
     paTTAMshukAbharaNaka~nchulikA~nchitA~NgIm |
gorochanAruchivigarhaNa gaurimANaM
     devIM guNaiH sulalitAM lalitAM namAmi || 3||
dhUrte vrajendratanaye tanu suShThuvAmyaM
     mA dakShiNA bhAva kala~Nkini lAghavAya |
rAdhe giraM shR^iNu hitAmiti shikShayantIM
     devIM guNaiH sulalitAM lalitAM namAmi || 4||
rAdhAmabhivrajapateH kR^itamAtmajena
     kUTaM manAg api vilokya vilohitAkShIm |
vAgbha~NgibhistamachireNa vilajjayantIM
     devIM guNaiH sulalitAM lalitAM namAmi || 5||
vAtsalyavR^indavasatiM pashupAlarAj~nyAH
     sakhyAnushikShaNakalAsu guruM sakhInAm |
rAdhAbalAvaraja jIvitanirvisheShAM
     devIM guNaiH sulalitAM lalitAM namAmi || 6||
yAM kAmapi vrajakule vR^iShabhAnujAyAH
     prekShya svapakShapadavImanurud.hdhyamAnAm |
sadyastadiShTaghaTanena kR^itArthayantIM
     devIM guNaiH sulalitAM lalitAM namAmi || 7||
rAdhAvrajendrasutasa~Ngamara~NgacharyAM
     varyAM vinishchitavatImakhilotsavebhyaH |
tAM gokulapriyasakhInikurambamukhyAM
     devIM guNaiH sulalitAM lalitAM namAmi || 8||
nandan amUni lalitAguNalAlitAni
     padyAni yaH paThati nirmaladR^iShTiraShTau |
prItyA vikarShati janaM nijavR^indamadhye
     taM kIrtidApatikulojjvalakalpavallI || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIlalitAShTakaM
shrIlalitApraNAmastotraM sampUrNam |
\chapter{##Shri Yamunashtakam ## .. shrIyamunAShTakam ..}
bhrAturantakasya pattane.abhipattihAriNI
     prekShayAtipApino.api pApasindhutAriNI |
nIramAdhurIbhirapyasheShachittabandhinI
     mAM punAtu sarvadAravindabandhunandinI || 1||
hArivAridhArayAbhimaNDitorukhANDavA
     puNDarIkamaNDalodyadaNDajAlitANDavA |
snAnakAmapAmarograpApasampadandhinI
     mAM punAtu sarvadAravindabandhunandinI || 2||
shIkarAbhimR^iShTajantudurvipAkamardinI
     nandanandanAntara~NgabhaktipUravardhinI |
tIrasa~NgamAbhilAShima~NgalAnubandhinI
     mAM punAtu sarvadAravindabandhunandinI || 3||
dvIpachakravAlajuShTasaptasindhubhedinI
     shrImukundanirmitorudivyakelivedinI |
kAntikandalIbhirindranIlavR^indanindinI
     mAM punAtu sarvadAravindabandhunandinI || 4||
mAthureNa maNDalena chAruNAbhimaNDitA
     premanaddhavaiShNavAdhvavardhanAya paNDitA |
UrmidorvilAsapadmanAbhapAdavandinI
     mAM punAtu sarvadAravindabandhunandinI || 5||
ramyatIrarambhamANagokadambabhUShitA
     divyagandhabhAkkadambapuShparAjirUShitA |
nandasUnubhaktasa~Nghasa~NgamAbhinandinI
     mAM punAtu sarvadAravindabandhunandinI || 6||
phullapakShamallikAkShahaMsalakShakUjitA
     bhaktividdhadevasiddhakinnarAlipUjitA |
tIragandhavAhagandhajanmabandharandhinI
     mAM punAtu sarvadAravindabandhunandinI || 7||
chidvilAsavAripUrabhUrbhuvaHsvarApinI
     kIrtitApi durmadorupApamarmatApinI |
ballavendranandanA~NgarAgabha~NgagandhinI
     mAM punAtu sarvadAravindabandhunandinI || 8||
tuShTabuddhiraShTakena nirmalormicheShTitAM
     tvAmanena bhAnuputri! sarvadevaveShTitAm |
yaHstavIti vardhayasva sarvapApamochane
     bhaktipUramasya devi! puNDarIkalochane || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIyamunAShTakaM sampUrNam |
\chapter{##Shri Mathurastavah ## .. shrImathurAstavaH ..}
muktergovindabhaktervitaraNachaturaM sachchidAnandarUpaM
     yasyAM vidyoti vidyAyugalamudayate tArakaM pArakaM cha |
kR^iShNasyotpattilIlAkhanirakhilajaganmauliratnasya sA te
     vaikuNThAd yA pratiShThA prathayatu mathurA ma~NgalAnAM kalApam || 1||
koTInduspaShTakAntI rabhasayutabhavakleshayaudherayodhyA
     mAyAvitrAsivAsA munihR^idayamuSho divyalIlA sravantI |
sAshIH kAshIshamukhyAmarapatibhiralaM prArthitadvArakAryA
     vaikuNThodgItakIrtirdishatu madhupurI premabhaktishriyaM vaH || 2||
bIjaM muktitaroranarthapaTalInistArakaM tArakaM
     dhAma premarasasya vA~nChitadhurAsampArakaM pArakam |
etad yatra nivAsinAmudayate chichChaktivR^ittidvayaM
     mathnAtu vyasanAni mAthurapurI sA vaH shriyaM cha kriyAt || 3||
adyAvanti patadgrahaM kuru mAye shanairvIjaya
     chChatraM kA~nchi gR^ihANa kAshi purataH pAdUyugaM dhAraya |
nAyodhye bhaja sambhramaM stutikathAM nodgAraya dvArake
     devIyaM bhavatIShu hanta mathurA dR^iShTiprasAdaM dadhe || 4||

iti shrIrUpagosvAmivirachitastavamAlAyAM mathurAstavaH samAptaH |
\chapter{##Shri Govardhanashtakam 1 ## .. shrIgovardhanAShTakam 1 ..}
prathamaM shrIgovardhanAShTakaM
namaH shrIgovardhanAya |
govindAsyottaMsita vaMshIkvaNitodya\-
     llAsyotkaNThAmattamayUravrajavIta |
rAdhAkuNDottu~Ngatara~NgA~NkuritA~Nga
     pratyAshAM me tvaM kuru govardhana pUrNAm || 1||
yasyotkarShAd vismitadhIbhirvrajadevI
     vR^indairvarShaM vaNitamAste haridAsyam |
chitrairyu~njana sa dyutipu~njairakhilAshAM
     pratyAshAM me tvaM kuru govardhana pUrNAm || 2||
vindadbhiryo mandiratAM kandaravR^indaiH
     kandaishchendorbandhubhirAnandayatIsham |
vaidUryAbhairnirjharatoyairapi so.ayaM
     pratyAshAM me tvaM kuru govardhana pUrNAm || 3||
shashvadvishvAla~NkaraNAla~NkR^itimedhyaiH
     premNA dhautairdhAtubhiruddIpitasAno |
nityAkrandatkandara veNudhvaniharShAt
     pratyAshAM me tvaM kuru govardhana pUrNAm || 4||
prAjyA rAjiryasya virAjatyupalAnAM
     kR^iShNenAsau santatamadhyAsitamadhyA |
so.ayaM bandhurbandhuradharmA surabhANAM
     pratyAshAM me tvaM kuru govardhana pUrNAm || 5||
nirdhunvAnaH saMhR^itihetuM ghanavR^indaM
     jitvA jabhArAtimasambhAvitabAdham |
svAnAM vairaM yaH kila niryApitavAn saH
     pratyAshAM me tvaM kuru govardhana pUrNAm || 6||
bibhrANo yaH shrIbhujadaNDoparibhartush\-
     ChatrIbhAvaM nAma yathArthaM svamakArShIt |
kR^iShNopaj~naM yasya makhastiShThati so.ayaM
     pratyAshAM me tvaM kuru govardhana pUrNAm || 7||
gAndharvAyAH kelikalAbAndhava ku~nje
     kShuNNaistasyAH ka~NkaNahAraiH prayatA~Nga |
rAsakrIDAmaNDitayopatyakayADhya
     pratyAshAM me tvaM kuru govardhana pUrNAm || 8||
adroshreNIshekhara padyAShTakametat
     kR^iShNAmbhodapreShTha paThed yastava dehI |
premAnandaM tundilayan kShipramamandaM
     taM harSheNa svIkurutAM te hR^idayeshaH || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM mattamayUrAkhyaM prathamaM
shrIgovardhanAShTakaM sampUrNam |
\chapter{##Shri Govardhanashtakam 2 ## .. shrIgovardhanAShTakam 2 ..}
dvitIyaM govardhanAShTakaM
shrIgovardhanAya namaH |
nIlastambhojjvalaruchibharairmaNDite bAhudaNDe
     ChatrachChAyAM dadhadaghariporlabdhasaptAhavAsaH |
dhArApAtaglapitamanasAM rakShitA gokulAnAM
     kR^iShNapreyAn prathayatu sadA sharma govardhano naH || 1||
bhIto yasmAdaparigaNayan bAndhavasnehabandhAn
     sindhAvadristvaritamavishat pArvatIpUrvajo.api |
yastaM jambhudviShamakuruta stambhasambhedashUnyaM
     sa prauDhAtmA prathayatu sadA sharma govardhano naH || 2||
AviShkR^itya prakaTamukuTATopama~NgaM sthavIyaH
     shailo.asmIti sphuTamabhidadhat tuShTivisphAradR^iShTiH |
yasmai kR^iShNaH svayamarasayad vallavairdattamannaM
     dhanyaH so.ayaM prathayatu sadA sharma govardhano naH || 3||
adyApyUrjapratipadi mahAn bhrAjate yasya yaj~naH
     kR^iShNopaj~naM jagati surabhIsairibhIkrIDayADhyaH |
shaShpAlambottamataTayA yaH kuTumbaM pashUnAM
     so.ayaM bhUyaH prathayatu sadA sharma govardhano naH || 4||
shrIgAndharvAdayitasarasIpadmasaurabhyaratnaM
     hR^itvA sha~NkotkaraparavashairasvanaM sa~ncharadbhiH |
ambhaHkShodapraharikakulenAkulenAnuyAtai\-
     rvAtairjuShTaiH prathayatu sadA sharma govardhano naH || 5||
kaMsArAtestarivilasitairAtarAna~Ngara~Ngai\-
     rAbhIrINAM praNayamabhitaH pAtramunmIlayantyAH |
dhautagrAvAvaliramalinairmAnasAmartyasindho\-
     rvIchivrAtaiH prathayatu sadA sharma govardhano naH || 6||
yasyAdhyakShaH sakalahaThinAmAdade chakravartI
     shulkaM nAnyad vrajamR^igadR^ishAmarpaNAd vigrahasya |
ghaTTasyochchairmadhukararuchastasya dhAmaprapa~nchaiH
     shyAmaprasthaH prathayatu sadA sharma govardhano naH || 7||
gAndharvAyAH suratakalahoddAmatAvAvadUkaiH
     klAntashrotrotpalavalayibhiH kShiptapi~nChAvataMsaiH |
ku~njaistalpopari pariluThadvaijayantIparItaiH
puNyA~NgashrIH prathayatu sadA sharma govardhano naH || 8||
yastuShTAtmA sphuTamanupaThechChraddhayA shuddhayAnta\-
     rmedhyaH padyAShTakamachaTulaH suShThu govardhanasya |
sAndraM govardhanadharapadadvandvashoNAravinde
     vindan premotkaramiha karotyadrirAje sa vAsam || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIgirIndravAsAnandadaM
nAma dvitIyaM shrIgovardhanAShTakaM sampUrNam |
\chapter{##Shri Vrindavanashtakam ## .. shrIvR^indAvanAShTakam ..}
mukundamuralIravashravaNaphullahR^idvallarI
     kadambakakarambitapratikadambaku~njAntarA |
kalindagirinandinIkamalakandalAndolinA
     sugandhiranilena me sharaNamastu vR^indATavI || 1||
vikuNThapurasaMshrayAd vipinato.api niHshreyasAt
     sahasraguNitAM shriyaM praduhatI rasashreyasIm |
chaturmukhamukhairapi spR^ihitatArNadehodbhavA
     jagadgurubhiragrimaiH sharaNamastu vR^indATavI || 2||
anAratavikasvaravratatipu~njapuShpAvalI
     visArivarasaurabhodgamaramAchamatkAriNI |
amandamakarandabhR^idviTapivR^indavR^indIkR^ita
     dvirephakulavanditA sharaNamastu vR^indATavI || 3||
kShaNadyutighanashriyovrajanavInayUnoH padaiH
     suvaglubhirala~NkR^itA lalitalakShmalakShmIbharaiH |
tayornakharamaNDalIshikharakelicharyochitai\-
     rvR^itA kishalayA~NkuraiH sharaNamastu vR^indATavI || 4||
vrajendrasakhanandinIshubhatarAdhikArakriyA
     prabhAvajasukhotsavasphuritaja~NgamasthAvarA |
pralambadamanAnujadhvanitavaMshikAkAkalI
     rasaj~namR^igamaNDalA sharaNamastu vR^indATavI || 5||
amandamudirArbudAbhyadhikamAdhurImedura
     vrajendrasutavIkShaNonnaTNtanIlakaNThotkarA |
dineshasuhR^idAtmajAkR^itanijAbhimAnollasal\-
     latAkhagamR^igA~NganA sharaNamastu vR^indATavI || 6||
agaNyaguNanAgarIgaNagariShThagAndharvikA
     manojaraNachAturIpishunaku~njapu~njojjvalA |
jagattrayakalAgurorlalitalAsyavalgatpada
     prayogavidhisAkShiNI sharaNamastu vR^indATavI || 7||
variShThaharidAsatApadasamR^iddhagovardhanA
     madhUdvahavadhUchamatkR^itinivAsarAsasthalA |
agUDhagahanashriyo madhurimavrajenojjvalA
     vrajasya sahajena me sharaNamastu vR^indATavI || 8||
idaM nikhilaniShkuTAvalivariShThavR^indATavI
     guNasmaraNakAri yaH paThati suShThu padyAShTakam |
vasan vyasanamuktadhIranishamatra sadvAsanaH
     sa pItavasane vashI ratimavApya vikrIDati || 9||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrIvR^indAvanAShTakaM sampUrNam |
\chapter{##Shri Krishnanamashtakam ## .. shrIkR^iShNanAmAShTakam ..}
nikhilashrutimauliratnamAlA
     dyutinIrAjitapAdapa~NkajAnta |
ayi muktakulairupAsyamAnaM
     paritastvAM harinAma saMshrayAmi || 1||
jaya nAmadheya munivR^indageya he
     janara~njanAya paramAkSharAkR^ite |
tvamanAdarAdapi manAg udIritaM
     nikhilogratApapaTalIM vilumpasi || 2||
yadAbhAso.apyudyan kavalitabhavadhvAntavibhavo
     dR^ishaM tattvAndhAnAmapi dishati bhaktipraNayinIm |
janastasyodAttaM jagati bhagavannAmataraNe
     kR^itI te nirvaktuM ka iha mahimAnaM prabhavati || 3||
yad brahmasAkShAtkR^itiniShThayApi
     vinAshamAyAti vinA na bhogaiH |
apaiti nAma sphuraNena tat te
     prArabdhakarmeti virauti vedaH || 4||
aghadamanayashodAnandanau nandasUno
     kamalanayanagopIchandravR^indAvanendrAH |
praNatakaruNakR^iShNAvityanekasvarUpe
     tvayi mama ratiruchchairvardhatAM nAmadheya || 5||
vAchyo vAchakamityudeti bhavato nAma svarUpadvayaM
     pUrvasmAt parameva hanta karuNA tatrApi jAnImahe |
yastasmin vihitAparAdhanivahaH prANI samantAd bhaved
     AsyenedamupAsya so.api hi sadAnandAmbudhau majjati || 6||
sUditAshritajanArtirAshaye
     ramyachidghanasukhasvarUpiNe |
nAma gokulamahotsavAya te
     kR^iShNapUrNavapuShe namo namaH || 7||
nAradavINojjIvanasudhorminiryAsamAdhurIpUra |
tvaM kR^iShNanAma kAmaM sphura me rasane rasena sadA || 8||

iti shrIrUpagosvAmivirachitastavamAlAyAM shrInAmAShTakaM sampUrNam |
\chapter{##Shri Govindavirudavali ## .. shrIgovindavirudAvalI ..}
OM namaH kR^iShNAya |
iyaM ma~NgalarUpAsyAd govindavirudAvalI |
yasyAH paThanamAtreNa shrIgovindaH prasIdati || 1||
brahmA brahmANDabhANDe sarasijanayanasraShTumAkrIDanAni
     sthAnurbha~NkuM cha khleAkhuralitamatinA tAni yena nyayoji |
tAdR^ikkrIDANDakoTIvR^itajlakuDavA yasya vaikuNThakulyA
     kartavyA tasya kA te stutiriha kR^itibhiH projjhya lIlAyitAni || 2||
\section{1}
niviDataraturAShADantarINoShmasampad
     vighaTanapaTukhelADambarormichChaTasya |
sagarimagirirAjachChatradaNDAyitashrI\-
     rjagadidamaghashatroH savyabAhurdhinotu || 3||
|| chaNDavR^ittAyAH kalikAkhyAyA nakhe vardhitam ||
abhramupatimamadamardipadakrama
vibhramaparimalaliptasuhR^ichChrama
duShTadanujabaladarpavimardana
tuShTahR^idayasurapakShavivardhana
darpakavilasitasarganirargala
sarpatulitabhuja karNagakuNDala
nirmalamalayajacharchitavigraha
narmalalitakR^itasarpavinigraha
duShkarakR^itibharalakShaNavismita
puShkarabhavabhayamardanasusmita
vatsalahaladharatarkitalakShaNa
vatsaravirahitavatsasuhR^idgaNa
garjitavijayivishuddhatarasvara
tarjitakhalagaNadurjanamatsara
|| vIra ||
tava muralIdhvaniramarI
     kAmAmbudhivR^iddhishubhrAMshuH |
achaTulagokulakulajA
     dhariyAmbudhipAnakumbhajo jayati || 4||
dhR^itagovardhana surabhIvardhana
pashupAlapriya rachitopakriya
|| dhIra ||
\section{2}
bhuja~NgaripuchandrakasphuradakhaNDachUDA~Nkure
     nira~NkushadR^iga~nchala bhraminibaddhabhR^i~Ngabhrame |
pata~NgaduhitustaTIvanakuTIrakelipriye
     parisphuratu me muhustvayi mukunda shuddhA ratiH || 5||
|| vIrabhadra ||
udyadvidyuddyutiparichitapaTa
sarpatsarpasphuradurubhujataTa
svasthasvasthatridashayuvatinuta
rakShaddakShapriyasuhR^idanusR^ita
mugdhasnigdhavrajajanakR^itasukha
navyashravyasvaravilasitamukha
hastanyastasphuTasarasijavara
sarjadgarjatkhalavR^iShamadahara
yuddhakruddhapratibhaTalayakara
varNasvarNapratimatilakadhara |
ruShyattuShyadyuvatiShu kR^itarasa
bhaktavyaktapraNayamanasi vasa
|| vIra ||
prachuraparamahaMsaiH kAmamAchamyamAne
     praNatamakarachakraiH shashvadAkrAntaakukShau |
aghahara jagadaNDAhiNDihillolahAse
     sphuratu tava gabhIre kelisindhau ratirnaH || 6||
udgIrNatAruNya vistIrNakAruNya
gu~njAlatApi~nChapu~njADhyatApi~nCha
|| vIra ||
\section{3}
uchitaH pashupatyala~NkriyAyai
     nitarAM nanditarohiNIyashodaH |
tava gokulakelisindhujanmA
     jagaduddIpayati sma kIrtichandraH ||
|| samagraH ||
ariShTakhaNDana svabhaktamaNDana
prayuktachandana prapannanandana
prasannacha~nchala sphuraddR^iga~nchala
shrutipralambaka bhramatkadambaka
prakR^iShTakandarapraviShTa sundara
sthaviShThasindhuraprasarpabandhura
|| deva ||
vR^indArakataruvIte vR^indAvanamaNDale vIra |
nanditabAndhavavR^inda sundara vR^indArikA ramaya || 8||
khalinIDumbaka muralIchumbaka
jananIvandakapashupInandaka
|| vIra ||
\section{4}
anudinamanuraktaH padminIchakravAle
     navaparimalamAdyachcha~ncharIkAnukarShI |
kalitamadhurapadmaH ko.api gambhIravedI
     jayati mihirakanyAkUlavanyAkarIndraH || 9||
|| achyutaH ||
jaya jaya vIra smararasadhIra
dvijajitahIra pratibhaTavIra
sphurauruhAra piryaparivAra
chChuritavihAra sthiramaNihAra
prakaTitarAsa stavakitahAsa
sphuTapaTavAsa sphuritavilAsa
dhvanadalijAlastutavanamAla
vrajakulapAla praNayavishAla
pravilasadaMsa bhramadavataMsa
kvaNaduruvaMshasvanahR^itahaMsa
prashamitadAva praNayiShu tAvad
vilasitabhAva stanitavirAva
stanaghanarAgashritaparabhAga
kShatahariyAga tvaritadhR^itAga
|| vIra ||
sthitiniyatimatIte dhIratAhArigIte
     priyajanaparivIte ku~NkumAlepaprIte |
kalitanavakuTIre kA~nchyuda~nchatkaTIre
     sphuratu rasagabhIre goShThavIre ratirnaH || 10||
ambAvinihita chumbAmalatara
bimbAdharamukhalambAlaka jaya
|| deva ||
\section{5}
dR^iShTvA te padanakakoTikAntipUraM
     pUrNAnAmapi shashinAM shatairdurApam |
nirviNNo murahara muktarUpadarpaH
     kandarpaH sphuTamasharIratAmayAsIt || 11||
|| utpalam ||
nartitasharkarakR^itakarkara
vR^iddhamarudbharatardana nirbhara
duShTavimardana shiShTavivardhana
sarvavilakShaNa mitrakR^itakShaNa
sadbhujalakShitaparvatarakShita
niShThuragarjana khinnasuhR^ijjana
ruShTadivaspatigarvasamunnati
tarjanavibhrama nirgalitabhrama
shakrakR^itastava visphuradutsava
|| vIra ||
buddhInAM parimohanaH kila hriyAmuchchATanaH stambhano
     dharmodagrabhiyAM manaHkaraTinAM vashyatvaniShpAdanaH |
kAlinIdkalahaMsa hanta vapuShAmAkarShaNaH subhruvAM
     jIyAd vaiNavapa~nchamadhvanimayo mantrAdhirAjaH stavaH || 12||
kAnanArabdhakAkalIshabda
pATavAkR^iShTa gopikAdR^iShTa
chAturIjuShTarAdhikAtuShTa
kAminIlakShamohane dakSha
bhAvinIpakSha mAmamuM rakSha
|| deva ||
\section{6}
ajarjarapativartAhR^idayavajrabhedoddhurAH
     kaThoravaravarNinInikaramAnavarmachChidaH |
ana~NgadhanuruddhataprachalachillichApachyutAH
     kriyAsuraghavid viShastava mudaM kaTAkSheShavaH || 13||
|| tura~Nga ||
sa~nchalavichakila kuNDala maNDitavaratanumaNDala
kuNDalipatikR^itasa~Ngara khaNDitabhuvanabhaya~Nkara
sha~Nkarakamalajavandita ki~Nkaranutilavanandita
ga~njitasamadapurandara cha~nchaladamanadhurandhara
bandhuragatijitasindhura chandanasurabhitakandhara
sundarabhujalasada~Ngada sa~NgadasakhigaNara~Ngada
jha~NkR^itikaramaNika~NkaNa kuntalaluThadurura~NgaNa
ku~Nkumaaruchilasadambara la~NgimaparimalaDambara
nandabhavanavarama~Ngala ma~njulaghusR^iNasupi~Ngala
hi~Ngularuchipada pa~Nkaja sa~nchitayuvatisada~Ngaja
santatamR^igamadapa~Nkila santanumayi kushalaM kila
|| vIra ||
giritaTIkunaTI kulapi~Ngale
     khalatR^iNAvalisa~njvaladi~Ngale |
prakharasa~Ngarasindhutimi~Ngile
     mama rati valatAM vrajama~Ngale || 14||
jaya chArudAmalalanAbhirAma
jagatIlalAma ruchihR^itavAma
|| vIra ||
\section{7}
     uditahR^idayendumaNiH pUrNakalaH kuvalayollAsI |
paritaH shArvaramatha no vilasati vR^indATavIchandraH || 15||
     || guNaratiH ||
prakaTIkR^itaguNa shakaTIvighaTana
nikaTIkR^itanavalakuTIvara vana
paTalItaTachara naTalIlamadhura
surabhIkR^itavana surabhIhitakara
muralIvilasita khuralIhR^itajagad
aruNAdhara navataruNAyatabhuja
varuNAlayasamakaruNAparimala
kalabhAyitabalashalabhAyitakhala
dhavalAdhR^itiharagavalAshritakara
sarasIruhadhara sarasIkR^itanara
kalashIdadhihara kalashIlitamukha
lalitAratikara lalitAvalipara
|| dhIra ||
hariNInayanAvR^ita prabho kariNIvallabhakelivibhrama |
tulasIpriyadAnavA~NganAkulasImantahara prasIda me || 16||
chandanacharchita gandhasamarchita
gaNDavivartanakuNDalanartana
sandaladujjvalakundalasadgala
sundaravigraha nandalasadgraha
|| vIra ||
\section{8}
ratimanuvadhya gR^ihebhyaH
karShati rAdhAM vanAya yA nipuNA
sA jayati nisR^iShTArthA
tava varavaMshajakAkalI dUtI || 17||
|| mAta~Ngakhelitam ||
nAtha he nandagehinIshanda
pUtanApaNDapAtane chaNDa
dAnave daNDakArakAkhaNDa
sArapaugaNDalIlayoddaNDa
gokulAlindagUDha govinda
pUrtiAmandarAdhikAnanda
vetasIku~nja mAdhavIpu~nja
lokanArambha jAtasaMrambha
dIpitAna~NgakelibhAga~Nga
gopasAra~NgalochanAra~Nga
kArimAta~Nga khelitAsa~Nga
sauhR^idAsha~NkayoShitAma~Nka
pAlikAlambachArurolamba
mAlikAkaNTha kautukAkuNTha
pATalIkundamAdhavIvR^inda
sevitottu~Ngashekharotsa~Nga
mAM sadA hanta pAlayAnanta
|| vIra ||
sphuradindIvarasundara sAndratarAnandakandalIkanda |
mAM tava padAravinde nandaya gandhena govinda || 18||
kundadashana baddharashana
rukmavasana ramyahasana
|| deva ||
\section{9}
prapannajanatAtamaHkShapaNashAradenduprabhA
     vrajAmbuja vilochanasmarasamR^iddhisiddhauShadhiH |
viDambitasudhAmbudhiprabalamAdhurIDambarA
     bibhartu tava mAdhava smitakaDambakAntimurdam || 19||
|| tilakam ||
amalakamalaruchikha~njanapaTupada
naTanapaTimahR^itakuNDalipatimada
navakuvalayakulasundararuchibhara
ghanataDidupamitabandhurapaTadhara
taraNiduhitR^itaTama~njulanaTavara
nayananaTanajitakha~njanaparikara
bhujataTagataharichandanaparimala
pashupayuvatIgaNanandanavarakala
navamadamadhuradR^iga~nchalavilasita
mukhaparimalabharasa~nchaladalivR^ita
sharadupachitashashimaNDalavaramukha
kanakamakaramayakuNDalakR^itasukha
yuvatihR^idayashukapa~njaranijabhuja
parihitavichakilama~njulashirasija
sutanuvadanavidhuchumbanapaTutara
danujaniviDamadaDumbanaraNakhara
|| vIra ||
raNati hare tava veNau
     nAryo danujAshcha kampitAH khinnAH |
vanamanapekShitadayitAH
     karabAlAnprojjhya dhAvanti || 20||
ku~NkumapuNDraka gumphitapuNDraka
sa~Nkulaka~NkaNa kaNThagara~NgaNa
|| deva ||
\section{10}
sAra~NgAkShIlochanabhR^i~NgAvalipAnachArubhR^i~NgAra |
tvAM ma~NgalashR^i~NgAraM shR^i~NgArAdhIshvara staumi || 21||
|| chaNDavR^ittasya vishikhe pa~Nkeruham ||
jaya  gatasha~Nka paNayaviTa~Nka
priyajanaba~Nkasmitajitasha~Nkha
sphuTatarashR^i~NgadhvanidhR^itara~Nga
kShaNanaTada~Nga praNayikura~Nga
vrajakR^itasa~NgashrutitaTari~Ngan
madhurasapi~Ngagrathitalava~Nga
svanaTanabha~NgavraNitabhuja~Nga
stavakitatu~NgakShitiruhashR^i~Nga
sthitabahubhR^i~NgakvaNitatara~Nga
pravaladana~Nga bhramadurUhabhR^i~NgI
muditakura~NgIdR^iguditabha~NgI
mR^idimabhira~NgIkR^itanavasa~NgI
takadaraba~NkekShaNa navasa~Nke
tagasuhR^ida~Nkeshaya sakala~Nke
tarapR^iShada~NkeDitamukha pa~Nke
ruhapada ra~Nke kR^ipaya sapa~Nke kila mayi
|| vIra ||
uttu~NgodayashR^i~Nga sa~NgamajuShAM bibhratpata~NgatviShAM
     vAsastulyamana~Ngasa~NgarakalAshauTIryapAra~NgataH |
svAntaM ri~NgadapA~Ngabha~NgibhiralaM gopA~NganAnAM gilan
     bhUyAstvaM pashupAlapu~NgavadR^ishoravya~Ngara~NgAya me || 22||
vilasadalikagataku~Nkumaparimala
kuTitadhR^itamaNiki~NkiNivarakala
navajaladharakulala~Ngimaruchibhara
masR^iNamuralikalabha~Ngamadhuratara
|| vIra ||
\section{11}
avataMsitama~njuma~njare
     taruNInetrachakorapa~njare |
navaku~Nkumapu~njapi~njare
     ratirAstAM mama gopaku~njare || 23||
|| sitaka~njam ||
jaya kachacha~nchaddyutisamuda~nchan
madhurimapa~nchastavakitapi~nCha
sphurita viri~nchastuta giriku~nja
vrajaparigu~njanmadhukarapu~nja
drutamR^idushi~nja dviShadahiga~nja
vratatiShu kha~njannavarasama~njan
marudatipi~nja pravalitamu~njA
nalahara gu~njApriya giriku~njA
shrita ratisa~njAgara navaka~njA
malakarajha~njhAnilahara ma~njI
rajaravapa~njI parimalasa~njIvita
navapa~nchAshugasharasa~nchA
raNajitapa~nchAnanamada
||  dhIra ||
kaNikArakR^itakarNikAdyuti\-
     rvarNikApadaniyuktagairikA |
mechakA manasi me chakAstu me
     mechakAbharaNa bhAriNI tanuH || 24||
madanarasa~Ngata sa~Ngataparimala
bhujataTara~Ngatara~Ngitajitabala
yuvativilambita lambitakachabhara
kusumaviTa~Nkita TA~Nkatagirivara
|| vIra ||
\section{12}
bhrUmaNDalatANDavitaprasUnakodaNDachitrakodaNDa |
hR^itpuNDarIkagarbhaM maNDaya mama puNDarIkAkSha || 25||
|| pANDUtpalam ||
jaya jaya daNDapriya kachakhaNDa
grathitashikhaNDa vraja shashikhaNDa
sphuraNasapiNDasmitavR^itagaNDa
praNayakaraNDa divjapatatuNDa
smararasakuNDa kShataphaNimuNDa
prakaTapichaNDasthitajagadaNDa
kvaNadanughaNTa sphuTaraNaghaNTa
sphuradurushuNDAkR^itibhujadaNDA
hatakhalachaNDAsuragaNa paNDAjanita
vitaNDAjitabala bhANDIra
dayita khaNDIkR^itanavahiNDIra
bhadadhihaNDIgaNa kalakaNThI
kR^itakalakaNThIgaNa maNikaNThI
sphuritasukaNThIpriya
varakaNThiravaraNa
|| dhIra ||
daNDI kuNDalibhogakANDanibhayoruddaNDadordaNDayoH
     shliShTashchaNDimaDambareNa niviDashrIkhaNDapuNDrojjvalaH |
nirdhUtodyadachaNDarashmighaTayA tuNDashriyA mAmakaM
     kAmaM maNDaya punNDarIkanayana tvaM hanta hR^inmaNDalam || 26||
kandarpakodaNDadarpakriyoddaNDa
dR^igbha~NgikANDIra sa~njuShTabhANDIra
|| dhIra ||
\section{13}
tvamupendra kalindanandinI
     taTavR^indAvanagandhasindhura |
jaya sundara kAntikandalaiH
     sphuradindIvaravR^indabandhubhiH || 27||
|| indIvaram ||
jaya jaya hanta dviShadabhihantarmadhurimasantarpitajagadanta\-
mR^idula vasantapriya sitadanta sphuritadR^iganta prasaradudanta
prabhavadanantapriyasakha santastvayi ratimantaH  svamudaharanta
prabhuvara nandAtmajaguNakandAsitanavakandAkR^itidhara kundA
malarada tundAttabhuvana vR^indAvanabhavagandhAspadamakarandA
nivtanavamandArakusumavR^indArchitakacha vandArunikhilavR^indA
rakavaravandIDita vidhusandIpitalasadindIvaraparinindI
kShaNayuga nandIshvarapatinandIhita jaya
|| dhIra ||
smitaruchimakarandasyandi vaktrAravindaM
     tava puruparahaMsAnviShTagandhaM mukunda |
virachitapashupAlInetrasAra~Ngara~NgaM
     mama hR^idayataDAge sa~Ngama~NgIkarotu || 28||
ambaragatasuravinativilambita
tumburuparibhavamuralikarambita
shambaramukhamR^iganikarakuTumbita
sambhamvavalyitayuvati vichumbita
|| vIra ||
\section{14}
ambujakuTumbaduhituH kadambasambAdhabandhure puline |
pItAmbara kuru keliM tvaM vIranitambinIghaTayA || 29||
|| aruNAmbhoruham ||
jaya rasasampadvirachitajhampa smarakR^itakampa priyajanashampa
pravaNitakampasphuradanukampa dyutijitashampasphuTanavachampa
shritakachagumpa shrutiparilambasphuritakadambastutamukha Dimbha
priya ravibimbodayaparijR^imbhonmukhalasadambhoruhamukha lambo
dhbaTabhuja lambodaravarakumbhopamakuchabimboShThayuvatichumbo
dbhaTaparirambhotsuka kuru shaM bhostaDidavalamborjitamiladambho
dharasuviDambodbhura natashambho parijitadambholigarimasambhA
vitabhujajambhAhitamada lampAkamanasi sampAdaya mayi taM pA
kimamanukampAlavamiha
|| dhIra ||
divye daNDadharasvasustaTabhave phullATavImaNDale
     vallImaNDapabhAji labdhamadirastamberamADambaraH |
kurvanna~njanapu~njaga~njanamatishyAmA~NgakAntishriyA
     lIlApA~Ngatara~Ngitena tarasA mAM hanta santarpaya || 30||
ambujakiraNaviDambaka
kha~njanaparichaladambaka
chumbitayuvatikadambaka
kuntalaluThitakadambaka
|| vIra ||
\section{15}
premodvellitavalgubhirvalayitastvaM vallavIbhirvibho
     rAgollApitavallakIvitatibhiH kalyANavallIbhuvi |
solluNThaM muralIkalAbhiramalaM mallAramullAsayan
     bAlyenollasite dR^ishau mama taDillIlAbhirutphullaya || 31||
|| phullAmbujam ||
vrajapR^ithupallIparisaravallIvanabhuvi tallIgaNabhR^iti mallI
manasijabhallIjitashivamallIkumudamatallIjuShi gatajhillI
pariShadi hallIsakasukhajhallIrata pariphullIkR^itachalachillI
jitaratimallImadabhara sallIlatilaka kalyAtanushatatulyA
havarasakulyAchaTulitakhalyApramathana kalyANacharita
|| dhIra ||
gopIH sambhR^itachApalachApalatAchitrayA bhruvA bhramayan |
vilasa yashodAvatsala vatsalasaddhenusaMvIta || 32||
vallavalIlAsamudayasamuchita pallavarAgAdharapuTavilasita
vallabhagopIpravaNita munigaNadurlabhakelIbharamadhurimakaNa
mallavihArAdbhutataruNimadhara phullamR^igAkShIparivR^itaparisara
chillivilAsArpitamanasijamada mallikalApAmalaparimalapada
rallakarAjIharasumadhurakala hallakamAlAparivR^itakachakula
|| vIra ||
\section{16}
vallavalalanAvallIkarapallavashIlitaskandham |
ullasitaH pariphullaM bhajAmyahaM kR^iShNaka~Nkellim || 33||
|| champakam ||
sa~nchaladaruNacha~nchalakaruNasundaranayana kandarashayana
vallavasharaNa pallavacharaNa ma~NgalaghusR^iNapi~NgalamasR^iNa
chandanarachana nandanavachana khaNDitashakaTa daNDitavikaTa
garvitadanuja parvitamanuja rakShitadhavala lakShitagavala
pannagadalana sannagakalana bandhuravalana sindhurachalana
kalpitamadanajalpitasadana ma~njulamukuTa va~njulalakuTa
ra~njitakarabha ga~njitasharabhamaNDalavalita kuNDalachalita
sanditalapana nanditatapanakanyakasuShuma vanyakakusuma
garbhaka viraNadarbhakasharaNa tarNakavalita varNakalalita
shaM varavalaya Dambara kalaya
|| deva ||
dAnavaghaTAlavitre dhAtuvichitre jagachchitre |
hR^idayAnandicharitre ratirAstAM ballavImitre || 34||
ri~NgadurubhR^i~Ngatu~NgagirishR^i~Nga
rutabha~Ngasa~NgadhR^itara~Nga
|| vIra ||
\section{16}
tvamatra chaNDAsuramaNDalInAM
     raNDAvashiShTAni gR^ihANi kR^itvA |
pUrNAnyakArShIrvrajasundarIbhi\-
     rvR^indATavIpuNDrakamaNDapAni || 36||
|| va~njulam ||
jaya jaya sundaravihasita mandaravijitapurandara nijagirikandara
ratirasashandhara maNiyutakandhara guNamaNimandira hR^idi valadindira
gatijitasindhura parijanabandhura pashupatinandana tilakitachandana
vidhikR^itavandana pR^ithuharichandanaparivR^itanandanamadhurimanindana
madhuvana vanditakusumasugandhitavanavarara~njita ratibharasa~njita
shikhidalakuNDalasahakR^itabhaNDila navasitatandulajayiradamaNDala
ratiraNapaNDita varatanubhaNDita nakhapadamaNDita dashanavikhaNDita
|| dhIra ||
nininda nijamindirA vapuravekShya yAsAM shriyaM
     vichArya guNachAturImachalajA cha lajjAM gatA |
lasatpashupanandinItatibhirAbhirAnanditaM
     bhavantamatisundaraM vrajakulendra vandemahi || 36||
rasaparipATIsphuTataruvATI
manasijadhATIpriya navashAtIhara jaya
|| vIra ||
\section{17}
sambhrAntaiH saShaDa~NgapAtamabhito vedairmudA vanditA
     sImantopari gauravAdupaniShaddevIbhirapyarpitA |
AnamraM praNavena cha praNayato hR^iShTAtmanAbhiShTutA
     mR^idvI te muralIrutirmuraripo sharmANi nirmAtu naH || 37||
|| kundam ||
nandakulachandra luptabhavatandra kundajayidanta duShTakulahanta
riShTasuvasanta miShTasamudanta sandalitamallikandalitavalli
gu~njadalipu~njama~njutaraku~njalabdharatira~Nga hR^idyajanasa~Nga
sharmalasada~Nga harShakR^idana~Nga mattaparapuShTaramyakalaghuShTa
gandhabharajuShTa puShpavanatuShTa kR^ittakhalayakSha yuddhanayadakSha
valgukachapakShabaddhashikhipakSha piShTanatatR^iShNa tiShTha hR^idi kR^iShNa
|| vIra ||
tava kR^iShNa kelimuralI
     hitamahitaM cha sphuTaM vimohayati |
ekaM sudhormisuhR^idA
     viShaviShameNAparaM dhvaninA || 38||
sannItadaiteyanistAra kalyANakAruNyavistAra
puShpeShu kodaNDaTa~NkAravisphArama~njIrajha~NkAra
|| vIra ||
\section{18}
ra~Ngasthale tANDavamaNDalena
     nirasya mallottamapuNDarIkAn |
kaMsadviShaM chaNDamakhaNDayad yo
     hR^itpuNDarIke sa haristavAstu || 39||
|| bakulabhAsuram ||
jaya jaya vaMshIvAdyavishArada shAradasarasIruhaparibhAvaka
bhAvakalitalochanasa~nchAraNa chAraNasiddhavadhUdhR^itihAraka
hArakalAparuchA~nchitakuNDala kuNDalasadgovardhanabhUShita
bhUShitabhUShaNachidghanavigraha vigrahakhaNDitakhalavR^iShabhAsura
bhAsurakuTilakachArpitachandraka chandrakalAparuchAbhyadhikAnana
kAnanaku~njagR^ihasmarasa~Ngara sa~NgarasoddhurabAhubhuja~Ngama
ja~NgamanavatApichChanagopama gopamanIShitasiddhiShu dakShiNa
dakShiNapANigadaNDasabhAjita bhAjitakoTishashA~Nkavirochana
rochanayA kR^itachAruvisheShaka shesakamalabhavasanakasanandana
nandanaguNa mA nandaya sundara
|| vIra ||
bhavataH pratApataraNAvudetumiha lohitAyati sphIte |
danujAndhakAranikarAH sharaNaM bhejurguhAkuharam || 40||
pulinadhR^itara~NgayuvatikR^itasa~Nga
madanarasabha~Ngagarimalasada~Nga
|| vIra ||
\section{19}
pashuShu kR^ipAM tava dR^iShTvA nUnamihAriShTavatsakeshimukhAH |
darpaM vimuchya bhItAH pashubhAvaM bhejire danujAH || 41||
|| bakulama~Ngalam ||
tvaM jaya keshava keshabalastuta vIryavilakShaNa lakShaNabodhita
keliShu nAgara nAgaraNoddhata gokulanandana nandanativrata
sAndramudarpaka darpakamohana he suShamAnavamAnavatIgaNa
mAnanirAsaka rAsakalAshrita sastanagauravagauravadhUvR^ita
ku~njashatoShita toShitayauvata rUpabharAdhikarAdhikayArchita
bhIruvilambita lambitashekhara kelikulAlasalAlasalochana
roShamadAruNadAruNadAnavamuktidalokana lokanamaskR^ita
gopasabhAvaka bhAvakasharmada hanta kR^ipAlaya pAlaya mAmapi
|| vIra ||
parAbhavaM phenilavaktratAM cha
     bandhaM cha bhItiM cha mR^itiM cha kR^itvA |
pavargadAtApi shikhaNDamaule
     tvaM shAtravANAmapavargado.asi || 42||
praNayabharitamadhuracharita
bhajanasahitapashupamahita
|| deva ||
\section{20}
navashikhishikhaNDashikharA
     prasUnakodaNDachitrashastrIva |
kShobhayati kR^iShNa veNI
     shreNIreNIdR^ishAM bhavataH || 43||
anubhUya vikramaM te yudhi
     labdhAH kAndishIkatvam |
bhittvA kila jagadaNDaM
     prapalAyA~nchakrire danujAH || 44||
|| ma~njaryAM korakaH ||
mAnavatImadahArivilochana dAnavasa~nchayadhUkavirochana
DiNDimavAdisurAlisabhAjita chaNDimashAlibhujArgalarAjita
dIkShitayauvatachittavilobhanavIkShita susmitamArdavashobhana
parvatasandhR^itinirdhutapIvaragarvatamaHparimugdhashachIvara
ra~njitama~njuparisphuradambara ga~njitakeshiparAkramaDambara
komalatA~NkitavAgavatAraka somalalAmamahotsavakAraka
haMsarathastutishaMsaitavaMshaka kaMsavadhUshrutinunnavataMsaka
ra~Ngatara~NgitachArudR^iga~nchala sa~Ngatapa~nchasharodayacha~nchala
lu~nchitagopasutAgaNashATaka sa~nchitara~NgamahotsavanATaka
tAraya mAmurusaMsR^itishAtana dhAraya lochanamatra sanAtana
|| dhIra ||
turagadanusutA~NgagrAvabhede dadhAnaH
     kulishaghaTitaTa~NkoddaNDavisphUrjitAni |
taduruvikaTadaMShTronmR^iShTakeyUramudraH
     prathayatu paTutAM vaH kaishavo vAmabAhuH || 45||2
mAdhava visphura dAnavaniShThura
yauvatara~njita saurabhasa~njita
|| vIra ||
\section{21}
palita~NkaraNI dashA prabho muhurandha~NkaraNI cha mAM gatA |
subha~NkaraNI kR^ipA shubhairna tavADha~NkaraNI cha mayyabhUt || 46||
|| guchChaH ||
jaya jaladamaNDalIdhyutinivahasundara
sphuradamalakaumudImR^iduhasitabandhura
vrajahariNalochanAvadanashashichumbaka
prachuratarakha~njanadyutivilasadambaka
smarasamarachAturInichayavarapaNDita
praNayayutarAdhikApaTimabharabhaNDita
kvaNadatulavaMshikAhR^itapashupayauvata
sthirasamaramAdhurIkularamitadaivata
grathitashikhichandrakasphuTakuTilakuntala
shravaNataTasa~ncharanmaNimakarakuNDala
grathitanavatANDavaprakaTagatimaNDala
dvijakiraNadhoraNIvijitasitataNDula
sphuritavaradADimIkusumayutakarNaka
ChadanavarakAkalIhR^itachaTulatarNaka
|| dhIra ||
punnAgastavakanibaddhakeshajuTaH
     koTIrIkR^itavarakekipakShakUTaH |
pAyAn mAM marakatameduraH sa tanvA
     kAlindItaTavipinaprasUnadhanvA || 47||
gargapriya jaya bhargastuta rasa
sargasthiranijavargapravaNita
|| vIra ||
\section{22}
danujavadhUvaidhavyavratadIkShAshikShaNAchAryaH |
sa jayati vidUrapAtI mukunda tava shR^i~NganirghoShaH || 48||
|| kusumam ||
kusumanikaranichitachikura nakharavijitamaNijamukura
subhaTapaTimaramitamathura vikaTasamaranaTanachatura
samadabhujagadamanacharaNa nikhilapashupapanichayasharaNa
muditamadiramadhuranayana shikharikuhararachitashayana
ramitapashupayuvatipaTala madanakalahaghaTanachaTula
viShamadanujanivahamathana bhuvanarasadavishadakathana
kumudamR^idulavilasadamalahasitamadhuravadanakamala
madhupasadR^ishavichaladalaka masR^iNaghusR^iNakalitatilaka
nibhR^itamuShitamathitakalasa satatamajita manasi vilasa
|| vIra ||
sakhichAtakajIvAturmAdhava
     surakekimaNDalollAsi |
tava daityahaMsabhayadaM
     shR^i~NgAmbudagarjitaM jayati || 49||
puruShottama vIravrata yamunAdbhutatIrasthita
muralidhvanipUrakriya surabhIvrajanAdapriya
|| dhIra ||
\section{23}
jagatIsabhAvalambaH
     sa tava jayatyambujAkSha doHstambhaH |
rabhasAd vibheda danujAn
     pratApanR^ihariryato.abhyuditaH || 50||
chitraM murAre suravairipakSha\-
     stvayA samantAdanubaddhayuddhaH |
amitramuchchairavibhidya bhedaM
     mitrasya kurvannamR^itaM prayAti || 51||
|| tribha~NgyAM daNDakatribha~NgI ||
shritamaghajaladhervahitraM charitraM suchitraM vichitraM
phaNitraM samitraM pavitraM lavitraM rujAM
jagadaparimitapratiShThaM paTiShThaM baliShThaM gariShThaM
variShThaM mradiShThaM suniShThaM daviShThaM dhiyAM
nikhilavilasite.abhirAmaM sarAmaM mudA ma~njudAma\-
nnabhAmaM lalAmaM dhR^itAmandadhAmatraye
madhumathana hare murAre purAre pAre sasAre
vihAre surArerudAre cha dAre prabhuM
sphurtaminasutAtara~Nge viha~Ngeshara~NgeNa ga~Nge
ShTabha~Nge bhuja~Ngendrasa~Nge sada~Ngena bhoH
shikharivaradarInishAntaM prayAntaM sakAntaM vibhAntaM
nitAntaM cha kAntaM prashAntaM kR^itAntaM dviShAM
danujahara bhajAmyanantaM sudantaM nudantaM dR^igantaM
hasantaM vasantaM bhajantaM bhavantaM sadA
|| vIra ||
pItvA bindukaNaM mukunda bhavataH saundaryasindhoH sakR^it
     kandarpasya vashaM gatA vimumuhuH ke vA na sAdhvIgaNAH |
dUre rAjyamayantritasmitakalAbhrUvallarItANDava
     krIDApA~Ngatara~NgitaprabhR^itayaH kurvantu te vibhramAH || 52||
chArutaTarAsanaTa gopabhaTa pItapaTa
padmakara daityahara ku~njachara vIravara
narmamaya kR^iShNa jaya
|| nAtha ||
\section{24}
saMsArAmbhasi dustarormigahane gambhIratApatrayI
     kumbhIreNa gR^ihItamugramatinA kroshantamantarbhayAt |
dIpreNAdya sudarshanena vibudhaklAntichChidAkAriNA
     chintAsantatiruddhamuddhara hare machchittadantIshvaram || 53||
|| vidagdhatribha~NgI ||
chaNDIpriyanata chaNDIkR^itabalaraNDIkR^itakhalavallabha vallava
paTTAmbaradhara bhaTTAraka bakakuTTAka lalitapaNDitamaNDita
nandIshvarapatinandIhitabhara sandIpitarasasAgara nAgara
a~NgIkR^itanavasa~NgItaka varabha~NgIlavahR^itaja~Ngamala~Ngima
UrvIpriyakara kharvIkR^itakhaladarvIkarapatigarvitaparvata
gotrAhitakara gotrAhitadaya gotrAdhipadhR^itishobhanalobhana
vanyAsthitabahukanyApaTahara dhanyAshayamaNichora manorama
shampAruchipaTa sampAlitabhavakampAkulajana phulla samullasa
|| dhIra ||
piShTvA sa~NgrAmapaTTe paTalamakuTile daityagokaNTakAnAM
     krIDAloTIvighaTTaiH sphuTamaratikaraM naichikIchArukANAm |
vR^indAraNyaM chakArAkhilajagadagada~NkArakAruNyadhAro
     yaH sa~nchArochitaM vaH sukhayatu sa paTuH ku~njapaTTAdhirAjaH || 45||
pichChalasadghananIlakesha chandanacharchitachAruvesha
khaNDitadurjanabhUrmAya maNDitanirmalahArikAya
|| vIra ||
\section{25}
gIrvANaM sphuTamakhilaM vivardhayantaM
     nirvANaM danujaghaTAsu sa~NghaTayya |
kurvANaM vrajanilayaM nirantarodyat
     parvANaM muramathana stuve bhavantam || 55||
uda~nchadatima~njulasmitasudhormilIlAspadaM
     tara~NgitavarA~NganAsphuradana~Ngara~NgAmbudhiH |
dR^igindumaNimaNDalIsalilanirjharasyandano
     mukunda mukhachandramAstava tanoti sharmANi naH || 56||
|| mishrakalikA ||
duShTadurdamAriShTakaNThIravakuNThavikhaNDanakheladaShTApada navInAShTApada
vispardhipaTTAmbaraparIta gariShThagaNDashailasapiNDavakShaHpaTTa pATava
daNDitachaTulabhuja~Ngama kandukavilasitala~Nghima
bhaNDilavichakilamaNDita sa~NgaraviharaNapaNDita
danturadanujaviDambaka kuNThitakuTilakadambaka
khachitAkhaNDalopalavirAjadaNDajarAjakuNDalamaNDitama~njulagaNDasthala
visha~NkaTabhANDIrataTItANDavakalAra~njitasuhR^inmaNDala nandavichumbita
kundanibhasmita gandhakarambita shandavicheShTita tundaparisphuradaNDakaDambara
durjanabhojendrakaNTakakandoddhAraNoddAmakuddAla vinamravipaddAruNadhvAnta
vidrAvaNamArtaNDopamakR^ipAkaTAkSha shAradAchaNDamarIchimAdhuryaviDambi
tuNDamaNDala loShThIkR^itamaNDikoShThIkulamunigoShThIshvara madhuroShThIpriya
parameShThIDita parameShThIkR^itanara
|| dhIra ||
\section{26}
upahitapashupAlInetrasAra~NgatuShTiH
     prasaradamR^itadhArAdhoraNIdhautavishvA |
pihitaravisudhAMshuH prAMshutApi~nCharamyA
     ramayatu bakahantuH kAntikAdambinI vaH || 57||
|| athavA sAptavibhaktikI kalikA ||
yaH sthirakaruNastarjitavaruNastarpitajanakaH sammadajanakaH
praNatavimAyaM jaguranapAyaM ghanaruchikAyaM sukR^itajanA yaM
sujanakalitakathanena prabaladanujamathanena
praNayiShu ratamabhayena prakaTaratiShu kila yena
yasmai paridhvastaduShTAya chakruH spR^ihAM mAlyajuShTAya
ghR^itotsAhapUrAddyutikShiptasUrAd yato.arirvidUrAd bhayaM prApa shUrAt |
yasyojjvalA~Ngasya sa~nchAryapA~Ngasya veNurlalAmasya haste.abhirAmasya
smitavisphurite.ajani yatra hite ratirullasite sudR^ishAM lalite |
sa tvaM jaya jaya duShTapratibhaya bhaktisthiradaya luptavrajabhaya
|| vIra ||
haMsottamAbhilaShitA sevakachakreShu darshitotsekA |
murajayinaH kalyANI karuNAkallolinI jayati || 58||
mitrakuloditanarmasumodita
ra~njitarAdhika sharmabharAdhika
|| dhIra ||
\section{27}
madhuresha mAdhurImaya mAdhava muralImatallikAmugdha |
mama madanamohana mudA mardaya manaso mahAmoham || 59||
|| akSharamayI ||
achyuta jaya jaya ArtakR^ipAmaya indramakhArdana ItivishAtana
ujjvalavibhrama Urjitavikrama R^iddhidhuroddhara ebhudayApara
LLidivakR^ipekShita LLiLLivadalakShita edhitavallava aindavakulabhava
ojaHsphUrjita augryavivarjita aMsavisha~NkaTa aShTApadapaTa
ka~NkaNayutakara khaNDitakhalavara gatijitaku~njara ghanaghusR^iNAmbara
~NutamuralIrata chalachillIlata ChalitasatIshata jalajodbhavanuta
jhaShavarakuNDala ~no~Nuyitadala Ta~NkitabhUdhara ThanibhAnanavara
DamaraghaTAhara Dhakkitakaratala NakharadhR^itAchala taralavilochana
thUtkR^itakha~njana danujavimardana dhavalAvardhana nandasukhAspada
pa~Nkajasamapada pha~nenutimodita bandhuvinodita bha~NguritAlaka
ma~njulamAlaka yaShTilasadbhuja ramyamukhAmbuja lalitavishArada
vallavara~Ngada sharmadacheShTita ShaTpadaveShTita sarasIruhadhara
haladharasodara kShaNadaguNotkara
|| vIra ||
karNe kalpitakarNikaH kalikayA kAmAyitaH kAntibhiH
     kAntAnAM kilaki~nchitaM kisalayakIlAladhIH kIrtibhiH |
kurvankUrdanakAni kesharitayA kaishoravAnkoTishaH
     kopI kaukurakaMsakaShTakR^itikaH kR^iShNaH kriyAt kA~NkShitam || 60||
saurItaTachara gaurIvratapara
gaurIpaTahara chaurIkR^itakara
|| vIra ||
\section{28}
premoruhaTTahiNDaka kakkhaTasubhaTendrakaNThakuTTAka |
kuru kau~NkumapaTTAmbara bhaTTAraka tANDavaM hR^idi me || 61||
|| sarvalaghuH ||
charaNachalanahatajaraThashakaTaka
rajakadalana vashagataparakaTaka
naTanaghaTanalasadagavarakaTaka
sakanakamarakatamayanavakaTaka
kapaTarudita naTadakaThinapadataTa
vighaTitadadhighaTaniviDitasushakaTa
ruchitulitapuraTapaTalaruchirapaTa
ghaTitavipulakaTa kuTilachikuraghaTa
raviduhitR^inikaTaluThadajaraThajaTa
viTapanichitavaTataTapaTutaranaTa
nijavilasitahaThavichaTitasuvikaTa
chaTuladanujaghaTa jaya yuvatiShu shaTha
|| vIra ||
sphuTanATyakaDambadaNDita
     draDhimoDDAmaraduShTakuNDalI |
jaya goShThakuTumbasaMvR^itta\-
     stvamiDADimbakadambaDumbaka || 62||
rasanamukhara sukharanakhara
dashanashikharavijitashikhara
|| dhIra ||
vivR^itavividhabAdhe bhrAntivegAdagAdhe
     balavati bhavapUre majjato me.avidUre |
asharaNagaNabandho he kR^ipAkaumudIndo
     sakR^idakR^itavilambaM dehi hastAvalambam || 63||
nAmAni praNayena te sukR^itinAM tanvanti tuNDotsavaM
     dhAmAni prathayanti hanta jaladashyAmAni netrA~njanam |
sAmAni shrutishaShkulIM muralikAjAtAnyala~Nkurvate
     kAmAni nirvR^itachetasAmiha vibho nAshApi naH shobhate || 64||
vyutpannaH susthiramatirgataglAnirgalasvanaH |
bhaktaH kR^iShNe bhaved yaH sa virudAvalipAThakaH || 65||
ramyayA virudAvalyA proktalakShaNayuktayA |
stUyamAnaH pramudito vAsudevaH prasIdati || 66||
yaH stauti virudAvalyA mathurAmaNDale harim |
anayA ramyayA tasmai tUrNameSha prasIdati || 67||

iti shrIrUpagosvAmivirachitastavamAlAyAM govindavirudAvalI samAptA |
